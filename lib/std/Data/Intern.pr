-- | A deterministic first-seen interner: names to dense integer ids.
--
-- Interning a name the first time allocates the next id in sequence, counting
-- from zero; interning it again answers the id it already holds and leaves the
-- table alone. An id is therefore a pure function of the order names were first
-- seen, and of nothing else: no hash, no address, no allocation counter. Two
-- runs that intern the same sequence assign the same ids, so a table can be
-- rebuilt from a replayed trace of names without the ids ever being written
-- down, and a program that keys on interned ids replays byte for byte.
--
-- Both directions are kept. `ids` carries a name to its id and `names` carries
-- an id back to its name, so the reverse lookup a diagnostic needs costs a
-- lookup rather than a scan of the table. The two agree by construction because
-- the single allocating operation extends both.
--
-- The table is an ordinary persistent value, so holding an older one holds the
-- smaller table it was. That is what makes speculative interning cheap to
-- abandon: a pass that interns while exploring a branch it then discards keeps
-- the pre-branch table and the discarded names never occupied an id.
--
-- ```prism
-- let (t, ids) = intern_all(intern_empty, ["b", "a", "b"])
-- (ids, intern_name(t, 0), intern_size(t))
-- ```
-- ```output
-- ([0, 1, 0], Some(b), 2)
-- ```
--
-- Opt-in: not in Base.

import Data.Map (map_empty, map_lookup, map_insert)

-- | A table of interned names: the forward direction, the reverse direction,
-- and the id the next unseen name receives.
opaque type Intern = Intern {
  ids: Map(String, Int),
  names: Map(Int, String),
  next: Int
}

-- | The empty table. Nothing is interned, and the first name seen takes id `0`.
--
-- ```prism
-- intern_size(intern_empty)
-- ```
-- ```output
-- 0
-- ```
pub let intern_empty : Intern =
  Intern { ids = map_empty, names = map_empty, next = 0 }

-- | Intern `name`, answering the updated table and its id. A name already in
-- the table keeps its id and the table is returned unchanged; a new one takes
-- the current `intern_size` as its id.
--
-- ```prism
-- let (t, i) = intern(intern_empty, "x")
-- let (t2, j) = intern(t, "y")
-- let (_t3, again) = intern(t2, "x")
-- (i, j, again)
-- ```
-- ```output
-- (0, 1, 0)
-- ```
-- The table's central verb, named for the operation rather than prefixed with
-- the type it operates on.
-- lint: allow(L0204)
pub fn intern(t : Intern, name : String) : (Intern, Int) =
  match map_lookup(name, t.ids) of
    Some(id) => (t, id)
    None =>
      let id = t.next
      (
          Intern {
            ids = map_insert(name, id, t.ids),
            names = map_insert(id, name, t.names),
            next = id + 1
          },
          id,
        )

-- | Intern every name in order, answering the final table and the ids in the
-- same order as the names. Repeats within the list resolve to the id their
-- first occurrence allocated.
--
-- ```prism
-- snd(intern_all(intern_empty, ["a", "b", "a", "c"]))
-- ```
-- ```output
-- [0, 1, 0, 2]
-- ```
pub fn intern_all(t : Intern, names : List(String)) : (Intern, List(Int)) =
  match names of
    Nil => (t, Nil)
    Cons(n, rest) =>
      let (t1, id) = intern(t, n)
      let (t2, ids) = intern_all(t1, rest)
      (t2, Cons(id, ids))

-- | The id of `name`, or `None` when it has never been interned. The lookup
-- never allocates an id, so a probe cannot perturb the numbering a later run
-- has to reproduce.
--
-- ```prism
-- let (t, _i) = intern(intern_empty, "x")
-- (intern_id(t, "x"), intern_id(t, "y"))
-- ```
-- ```output
-- (Some(0), None)
-- ```
pub fn intern_id(borrow t : Intern, name : String) : Option(Int) =
  map_lookup(name, t.ids)

-- | The name that was interned as `id`, or `None` when no name holds it.
--
-- ```prism
-- let (t, _ids) = intern_all(intern_empty, ["a", "b"])
-- (intern_name(t, 1), intern_name(t, 7))
-- ```
-- ```output
-- (Some(b), None)
-- ```
pub fn intern_name(borrow t : Intern, id : Int) : Option(String) =
  map_lookup(id, t.names)

-- | How many distinct names are interned, which is also the id the next unseen
-- name receives. Interning a name already in the table leaves it unchanged.
--
-- ```prism
-- let (t, _ids) = intern_all(intern_empty, ["a", "b", "a"])
-- intern_size(t)
-- ```
-- ```output
-- 2
-- ```
pub fn intern_size(borrow t : Intern) : Int @ noalloc = t.next
