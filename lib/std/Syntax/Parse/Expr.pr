-- | The Prism-owned expression parser.
--
-- The ordinary productions below are direct recursive descent.  Only the
-- prefix/infix tower is a Pratt loop, with binding powers selected directly
-- from `TokenKind`; it does not allocate an operator table or pass parsing
-- callbacks through the generic `Syntax.Cursor.Pratt` API.

-- lint: allow-file(L0108)

import Data.Foldable (length)
import Data.List (append, map, reverse)
import Data.Maybe (..)
import Data.Char (is_upper)
import Data.String (contains, ends_with, split)
import Syntax.Source (..)
import Syntax.Token (..)
import Syntax.Cursor (..)
import Syntax.Ast (..)
import Syntax.Parse.Support (..)
import Syntax.Parse.Build (..)
import Syntax.Parse.Type (parse_type)
import Syntax.Parse.Pattern (parse_pattern, parse_let_pattern)

-- A fixed, compiler-owned binding description. `tag` distinguishes the few
-- low-precedence forms whose AST node is not `EBin`.
type Binding = Binding {
  op: String,
  left: Int,
  right: Int,
  compare: Bool,
  tag: Int
}

type IfBranch = IfBranch { expr: Sp(Expr), open: Bool }

fn fixed_at(c : Cursor, ahead : Int, s : String) : Bool =
  match cursor_peek_at(c, ahead) of
    None => false
    Some(t) => t.kind == TFixed(s)

fn kind_at(c : Cursor, ahead : Int, k : TokenKind) : Bool =
  match cursor_peek_at(c, ahead) of
    None => false
    Some(t) => t.kind == k

fn made(saved : Cursor, c : Cursor, node : Expr) : Sp(Expr) =
  let s = cursor_since(saved, c)
  authored(node, s.lo, s.hi)

fn remade(saved : Cursor, c : Cursor, node : Expr) : Sp(Expr) =
  let s = cursor_since(saved, c)
  synthesized(node, s.lo, s.hi)

fn fail_at(c : Cursor, message : String) : Parsed(a) =
  PFault(refuse(cursor_span(c), message))

fn fail_run(saved : Cursor, c : Cursor, message : String) : Parsed(a) =
  PFault(refuse(cursor_since(saved, c), message))

-- The tokens that can begin an operand, written as one set rather than a chain
-- of rebindings, because this is the half of an expectation set that a refusal
-- reports and that the differential witness compares against the grammar's own
-- first set. Every member is a spelling the parser really does accept here;
-- noting a token it would refuse is how a refusal comes to name the very token
-- it just rejected.
let atom_starts : List(TokenKind) =
  [
      TIdent,
      TUid,
      TQual,
      TInt,
      TFloat,
      TChar,
      TStr,
      TIStart,
      TFixed("("),
      TFixed("["),
      TFixed("\{"),
      TFixed("#"),
      TFixed("-"),
      TFixed("?"),
      TFixed("break"),
      TFixed("continue"),
      TFixed("error"),
      TFixed("false"),
      TFixed("mask"),
      TFixed("true"),
    ]

fn note_kinds(c : Cursor, ks : List(TokenKind)) : Cursor =
  match ks of
    Nil => c
    Cons(k, rest) => note_kinds(cursor_note(c, k), rest)

fn note_expr(c : Cursor) : Cursor = note_kinds(c, atom_starts)

fn split_int(raw : String) : (String, Suffix) =
  let n = byte_len(raw)
  if ends_with("i64", raw) then
    (surface_int(substring(raw, 0, n - 3)), SufI64)
  elif ends_with("u64", raw) then
    (surface_int(substring(raw, 0, n - 3)), SufU64)
  else
    (surface_int(raw), SufNone)

-- Binding powers are doubled in spirit but written out: left associative
-- operators raise the right floor; `??` and `^` keep it level. Unary minus
-- parses at 16, between multiplication and power, giving both `-x ^ y` and
-- `x ^ -y` the mathematical grouping used by the Rust grammar.
-- lint: allow(L0101)
fn infix_binding(k : TokenKind) : Option(Binding) =
  match k of
    TFixed(s) =>
      if s == "??" then
        Some(Binding { op = s, left = 1, right = 1, compare = false, tag = 1 })
      elif s == "|>" then
        Some(Binding { op = s, left = 2, right = 3, compare = false, tag = 2 })
      elif s == ">>" then
        Some(Binding { op = s, left = 4, right = 5, compare = false, tag = 3 })
      elif s == "<<" then
        Some(Binding { op = s, left = 4, right = 5, compare = false, tag = 4 })
      elif s == "||" then
        Some(Binding { op = s, left = 6, right = 7, compare = false, tag = 0 })
      elif s == "&&" then
        Some(Binding { op = s, left = 8, right = 9, compare = false, tag = 0 })
      elif (s == "==" || s == "/=" || s == "<" || s == "<=" || s == ">" || s == ">=") then
        Some(Binding { op = s, left = 10, right = 11, compare = true, tag = 0 })
      elif s == "+" || s == "-" then
        Some(
            Binding {
              op = s,
              left = 12,
              right = 13,
              compare = false,
              tag = 0
            },
          )
      elif s == "*" || s == "/" || s == "%" then
        Some(
            Binding {
              op = s,
              left = 14,
              right = 15,
              compare = false,
              tag = 0
            },
          )
      elif s == "^" then
        Some(
            Binding {
              op = s,
              left = 17,
              right = 16,
              compare = false,
              tag = 0
            },
          )
      else
        None
    _ => None

-- lint: allow(L0101)
fn retired_dot(k : TokenKind) : Option(String) =
  match k of
    TFixed(s) =>
      if s == "==." then
        Some("the float dot-operator `==.` was removed: write `==`")
      elif s == "/=." then
        Some("the float dot-operator `/=.` was removed: write `/=`")
      elif s == "<." then
        Some("the float dot-operator `<.` was removed: write `<`")
      elif s == "<=." then
        Some("the float dot-operator `<=.` was removed: write `<=`")
      elif s == ">." then
        Some("the float dot-operator `>.` was removed: write `>`")
      elif s == ">=." then
        Some("the float dot-operator `>=.` was removed: write `>=`")
      elif s == "+." then
        Some("the float dot-operator `+.` was removed: write `+`")
      elif s == "-." then
        Some("the float dot-operator `-.` was removed: write `-`")
      elif s == "*." then
        Some("the float dot-operator `*.` was removed: write `*`")
      elif s == "/." then
        Some("the float dot-operator `/.` was removed: write `/`")
      else
        None
    _ => None

fn infix_node(b : Binding, lhs : Sp(Expr), rhs : Sp(Expr)) : Expr =
  if b.tag == 1 then
    EDefault(lhs, rhs)
  elif b.tag == 2 then
    EPipe(lhs, rhs)
  elif b.tag == 3 then
    ECompose("forward", lhs, rhs)
  elif b.tag == 4 then
    ECompose("backward", lhs, rhs)
  else
    EBin(b.op, lhs, rhs)

fn parse_bp(c : Cursor, depth : Int, min_bp : Int) : Parsed(Sp(Expr)) =
  let p1 = descend(depth, c)
  let PTook(d, _) = p1 else parsed_refused(p1)
  let p2 = parse_prefix(c, d)
  let PTook(lhs, c1) = p2 else parsed_refused(p2)
  parse_infix_loop(lhs, c1, d, min_bp, false)

fn parse_prefix(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  if at_fixed(c, "-") then
    let saved = c
    let c1 = cursor_advance(c)
    let p2 = parse_bp(c1, depth, 16)
    let PTook(e, c2) = p2 else parsed_refused(p2)
    PTook(made(saved, c2, ENeg(e)), c2)
  else
    parse_postfix(c, depth)

fn parse_infix_loop(
  lhs : Sp(Expr),
  c : Cursor,
  depth : Int,
  min_bp : Int,
  blocked_compare : Bool
) : Parsed(Sp(Expr)) =
  match cursor_kind(c) of
    None => PTook(lhs, c)
    Some(k) =>
      match retired_dot(k) of
        Some(msg) => fail_at(c, msg)
        None =>
          match infix_binding(k) of
            None => PTook(lhs, c)
            Some(b) =>
              if b.left < min_bp || b.compare && blocked_compare then
                PTook(lhs, c)
              else
                let saved = c
                let c1 = cursor_advance(c)
                let p2 = parse_bp(c1, depth, b.right)
                let PTook(rhs, c2) = p2 else parsed_refused(p2)
                let s = operands_span(lhs, rhs)
                let next = authored(infix_node(b, lhs, rhs), s.lo, s.hi)
                parse_infix_loop(next, c2, depth, min_bp, b.compare)

-- -------------------------------------------------------------------------
-- Atoms and postfix
-- -------------------------------------------------------------------------

fn parse_postfix(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = parse_atom(c, depth)
  let PTook(e, c1) = p1 else parsed_refused(p1)
  parse_postfix_loop(e, c1, depth)

fn parse_postfix_loop(
  recv : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  if at_fixed(c, "(") then
    parse_call_tail(recv, c, depth)
  elif at_fixed(c, "[") then
    parse_index_tail(recv, c, depth)
  elif at_fixed(c, ".") then
    parse_dot_tail(recv, c, depth)
  elif at_fixed(c, "?.") then
    let saved = c
    let p1 = take_word(cursor_advance(c), TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let whole =
      authored(EOptChain(recv, name), recv.span.lo, cursor_since(saved, c1).hi)
    parse_postfix_loop(whole, c1, depth)
  elif at_fixed(c, "?") then
    let c1 = cursor_advance(c)
    let marker = zero_width(EMarker("try"), recv.span.lo)
    let whole =
      authored(ECall(marker, [recv]), recv.span.lo, cursor_since(c, c1).hi)
    parse_postfix_loop(whole, c1, depth)
  else
    PTook(recv, c)

-- A trailing block argument uses the whole call's span for both the lambda and
-- the enclosing call.  That is the surface contract the formatter keys on:
-- `f(args) fn(params) { body }` is one authored call whose final argument is an
-- authored lambda, unlike the synthesized lambda used by a `with` statement.
fn parse_trailing_lambda(c : Cursor, lo : Int, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  let p2 = parse_trailer_params(c1, depth)
  let PTook(params, c2) = p2 else parsed_refused(p2)
  let p3 = parse_block(c2, depth)
  let PTook(body, c3) = p3 else parsed_refused(p3)
  PTook(authored(ELam(params, body), lo, body.span.hi), c3)

fn parse_trailer_params(c : Cursor, depth : Int) : Parsed(List(Param)) =
  if at_fixed(c, "(") then
    let p1 = parse_param(cursor_advance(c), depth, 0)
    let PTook(first, c1) = p1 else parsed_refused(p1)
    parse_trailer_param_rest(c1, depth, 1, [first])
  else
    PTook(Nil, c)

fn parse_trailer_param_rest(
  c : Cursor,
  depth : Int,
  index : Int,
  acc : List(Param)
) : Parsed(List(Param)) =
  if at_fixed(c, ",") then
    let p1 = parse_param(cursor_advance(c), depth, index)
    let PTook(param, c1) = p1 else parsed_refused(p1)
    parse_trailer_param_rest(c1, depth, index + 1, append(acc, [param]))
  else
    let p2 = take_fixed(c, ")")
    let PTook(_, c1) = p2 else parsed_refused(p2)
    PTook(acc, c1)

fn parse_call_tail(
  callee : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let saved = c
  let c1 = cursor_advance(c)
  let p2 = parse_call_args(c1, depth, Nil)
  let PTook(pair, c2) = p2 else parsed_refused(p2)
  match pair of
    (args, inst) =>
      let p3 = take_fixed(c2, ")")
      let PTook(_, c3) = p3 else parsed_refused(p3)
      let hi = cursor_since(saved, c3).hi
      match inst of
        None =>
          if at_fixed(c3, "fn") then
            let p4 = parse_trailing_lambda(c3, callee.span.lo, depth)
            let PTook(lam, c4) = p4 else parsed_refused(p4)
            let call = authored(
                ECall(callee, append(args, [lam])),
                callee.span.lo,
                lam.span.hi,
              )
            parse_postfix_loop(call, c4, depth)
          else
            let call = authored(ECall(callee, args), callee.span.lo, hi)
            parse_postfix_loop(call, c3, depth)
        Some(names) =>
          let head = authored(EInst(callee, names), callee.span.lo, hi)
          let call = authored(ECall(head, args), callee.span.lo, hi)
          parse_postfix_loop(call, c3, depth)

-- lint: allow(L0105)
fn parse_call_args(
  c : Cursor,
  depth : Int,
  rev : List(Sp(Expr))
) : Parsed((List(Sp(Expr)), Option(List(String)))) =
  if at_fixed(c, ")") then
    PTook((reverse(rev), None), c)
  elif at_fixed(c, "using") then
    let p1 = parse_using(cursor_advance(c), Nil)
    let PTook(names, c1) = p1 else parsed_refused(p1)
    PTook((reverse(rev), Some(names)), c1)
  else
    let p2 = parse_expr(c, depth)
    let PTook(e, c1) = p2 else parsed_refused(p2)
    if at_fixed(c1, ",") then
      let c2 = cursor_advance(c1)
      if at_fixed(c2, "using") then
        let p3 = parse_using(cursor_advance(c2), Nil)
        let PTook(names, c3) = p3 else parsed_refused(p3)
        PTook((reverse(Cons(e, rev)), Some(names)), c3)
      elif at_fixed(c2, ")") then
        PTook((reverse(Cons(e, rev)), None), c2)
      else
        parse_call_args(c2, depth, Cons(e, rev))
    else
      PTook((reverse(Cons(e, rev)), None), c1)

-- lint: allow(L0105)
fn parse_using(c : Cursor, rev : List(String)) : Parsed(List(String)) =
  let p1 = take_word(c, TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, ",") then
    let c2 = cursor_advance(c1)
    if at_fixed(c2, ")") then
      PTook(reverse(Cons(name, rev)), c2)
    else
      parse_using(c2, Cons(name, rev))
  else
    PTook(reverse(Cons(name, rev)), c1)

fn parse_index_tail(
  recv : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let saved = c
  let c1 = cursor_advance(c)
  let p2 = parse_expr(c1, depth)
  let PTook(first, c2) = p2 else parsed_refused(p2)
  let p3 = parse_more_indices(c2, depth, [first])
  let PTook(indices, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "]")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let hi = cursor_since(saved, c4).hi
  let key =
    if length(indices) == 1 then
      match indices of
        Cons(one, _) => one
        Nil => first
    else
      synthesized(EList(indices), recv.span.lo, hi)
  let whole = authored(EIndex(recv, key), recv.span.lo, hi)
  parse_postfix_loop(whole, c4, depth)

fn parse_more_indices(
  c : Cursor,
  depth : Int,
  acc : List(Sp(Expr))
) : Parsed(List(Sp(Expr))) =
  if at_fixed(c, ",") then
    let c1 = cursor_advance(c)
    if at_fixed(c1, "]") && length(acc) > 1 then
      PTook(acc, c1)
    else
      let p2 = parse_expr(c1, depth)
      let PTook(e, c2) = p2 else parsed_refused(p2)
      parse_more_indices(c2, depth, append(acc, [e]))
  else
    PTook(acc, c)

fn parse_dot_tail(recv : Sp(Expr), c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let c1 = cursor_advance(c)
  if at_fixed(c1, "#") then
    let p2 = take_word(cursor_advance(c1), TIdent)
    let PTook(name, c2) = p2 else parsed_refused(p2)
    let hi = cursor_since(saved, c2).hi
    parse_postfix_loop(
        authored(EUnboxedField(recv, name), recv.span.lo, hi),
        c2,
        depth,
      )
  elif at_fixed(c1, "[") then
    let p1 = parse_path_steps(cursor_advance(c1), depth)
    let PTook(path, c2) = p1 else parsed_refused(p1)
    let p3 = take_fixed(c2, "]")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let hi = cursor_since(saved, c3).hi
    parse_postfix_loop(
        authored(EReadPath(recv, path), recv.span.lo, hi),
        c3,
        depth,
      )
  else
    let p4 = take_word(c1, TIdent)
    let PTook(name, c2) = p4 else parsed_refused(p4)
    if at_fixed(c2, "(") then
      parse_dot_call(recv, name, saved, c2, depth)
    elif at_fixed(c2, "fn") then
      let p5 = parse_trailing_lambda(c2, recv.span.lo, depth)
      let PTook(lam, c3) = p5 else parsed_refused(p5)
      let head = synthesized(EVar(name), recv.span.lo, recv.span.lo)
      let whole = authored(ECall(head, [recv, lam]), recv.span.lo, lam.span.hi)
      parse_postfix_loop(whole, c3, depth)
    else
      let hi = cursor_since(saved, c2).hi
      parse_postfix_loop(
          authored(EField(recv, name), recv.span.lo, hi),
          c2,
          depth,
        )

fn parse_dot_call(
  recv : Sp(Expr),
  name : String,
  saved : Cursor,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = parse_call_args(cursor_advance(c), depth, Nil)
  let PTook(pair, c1) = p1 else parsed_refused(p1)
  match pair of
    (args0, inst) =>
      match inst of
        Some(_) => fail_run(saved, c1, "`using` is not accepted on a dot call")
        None =>
          let p2 = take_fixed(c1, ")")
          let PTook(_, c2) = p2 else parsed_refused(p2)
          let head = synthesized(EVar(name), recv.span.lo, recv.span.lo)
          let args = Cons(recv, args0)
          if at_fixed(c2, "fn") then
            let p3 = parse_trailing_lambda(c2, recv.span.lo, depth)
            let PTook(lam, c3) = p3 else parsed_refused(p3)
            let whole = authored(
                ECall(head, append(args, [lam])),
                recv.span.lo,
                lam.span.hi,
              )
            parse_postfix_loop(whole, c3, depth)
          else
            let whole = authored(
                ECall(head, args),
                recv.span.lo,
                cursor_since(saved, c2).hi,
              )
            parse_postfix_loop(whole, c2, depth)

fn parse_atom(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  match cursor_peek(c) of
    None => PStuck(note_expr(c))
    Some(t) =>
      match t.kind of
        TInt =>
          let pair = split_int(token_text(t))
          match pair of
            (digits, suffix) =>
              let c1 = cursor_advance(c)
              PTook(made(c, c1, EInt(digits, suffix)), c1)
        TFloat =>
          let c1 = cursor_advance(c)
          PTook(made(c, c1, EFloat(surface_float(token_text(t)))), c1)
        TChar =>
          let c1 = cursor_advance(c)
          PTook(made(c, c1, EChar(token_text(t))), c1)
        TStr =>
          let c1 = cursor_advance(c)
          PTook(made(c, c1, EStr(token_text(t))), c1)
        TIStart => parse_interpolation(c, depth)
        TIdent =>
          let c1 = cursor_advance(c)
          PTook(made(c, c1, EVar(token_text(t))), c1)
        TUid => parse_uid_atom(c, depth)
        TQual =>
          let c1 = cursor_advance(c)
          PTook(made(c, c1, EVar(token_text(t))), c1)
        TFixed(s) => parse_fixed_atom(c, depth, s)
        _ => PStuck(note_expr(c))

-- lint: allow(L0101)
fn parse_fixed_atom(c : Cursor, depth : Int, s : String) : Parsed(Sp(Expr)) =
  if s == "true" then
    let c1 = cursor_advance(c)
    PTook(made(c, c1, EBool(true)), c1)
  elif s == "false" then
    let c1 = cursor_advance(c)
    PTook(made(c, c1, EBool(false)), c1)
  elif s == "break" then
    let c1 = cursor_advance(c)
    PTook(made(c, c1, EBreak), c1)
  elif s == "continue" then
    let c1 = cursor_advance(c)
    PTook(made(c, c1, EContinue), c1)
  elif s == "(" then
    parse_paren(c, depth)
  elif s == "[" then
    parse_list_atom(c, depth)
  elif s == "#" then
    parse_unboxed_atom(c, depth)
  elif s == "\{" then
    parse_path_update_atom(c, depth)
  elif s == "?" then
    parse_hole(c)
  elif s == "mask" then
    parse_mask(c, depth)
  elif s == "error" then
    parse_error_call(c, depth)
  else
    PStuck(note_expr(c))

fn parse_hole(c : Cursor) : Parsed(Sp(Expr)) =
  let p1 = take_word(cursor_advance(c), TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  PTook(made(c, c1, EHole(name)), c1)

fn parse_uid_atom(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  match cursor_peek(c) of
    None => PStuck(cursor_note(c, TUid))
    Some(t) =>
      let name = token_text(t)
      let c1 = cursor_advance(c)
      if at_fixed(c1, "\{") then
        parse_record_atom(c, name, c1, depth)
      else
        PTook(made(c, c1, EVar(name)), c1)

fn parse_paren(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  if at_fixed(c1, ")") then
    let c2 = cursor_advance(c1)
    PTook(made(c, c2, EUnit), c2)
  else
    let p2 = parse_expr(c1, depth)
    let PTook(first, c2) = p2 else parsed_refused(p2)
    if at_fixed(c2, ":") then
      let p3 = parse_type(cursor_advance(c2), depth)
      let PTook(ty, c3) = p3 else parsed_refused(p3)
      let p4 = take_fixed(c3, ")")
      let PTook(_, c4) = p4 else parsed_refused(p4)
      PTook(made(c, c4, EAnn(first, ty)), c4)
    elif at_fixed(c2, ",") then
      let p1 = parse_expr_comma(cursor_advance(c2), depth, ")", [first])
      let PTook(items, c3) = p1 else parsed_refused(p1)
      let p5 = take_fixed(c3, ")")
      let PTook(_, c4) = p5 else parsed_refused(p5)
      PTook(made(c, c4, ETuple(items)), c4)
    else
      let p6 = take_fixed(c2, ")")
      let PTook(_, c3) = p6 else parsed_refused(p6)
      let s = cursor_since(c, c3)
      PTook(widened(first, s.lo, s.hi), c3)

-- Parse the tail of an ordinary comma list. `acc` is kept in source order
-- because these lists are generally short and their artifact order matters.
fn parse_expr_comma(
  c : Cursor,
  depth : Int,
  close : String,
  acc : List(Sp(Expr))
) : Parsed(List(Sp(Expr))) =
  if at_fixed(c, close) then
    PTook(acc, c)
  else
    let p1 = parse_expr(c, depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    let next = append(acc, [e])
    if at_fixed(c1, ",") then
      parse_expr_comma(cursor_advance(c1), depth, close, next)
    else
      PTook(next, c1)

fn parse_interpolation(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  match cursor_peek(c) of
    None => PStuck(cursor_note(c, TIStart))
    Some(first) =>
      let lo = first.span.lo
      let initial = [zero_width(EStr(token_text(first)), lo)]
      parse_interp_hole(c, cursor_advance(c), depth, initial)

fn parse_interp_hole(
  saved : Cursor,
  c : Cursor,
  depth : Int,
  acc : List(Sp(Expr))
) : Parsed(Sp(Expr)) =
  let p1 = parse_expr(c, depth)
  let PTook(hole, c1) = p1 else parsed_refused(p1)
  let with_hole = append(acc, [hole])
  match cursor_peek(c1) of
    None => PStuck(cursor_note(c1, TIEnd))
    Some(seg) =>
      if seg.kind == TIMid then
        let part = zero_width(EStr(token_text(seg)), cursor_span(saved).lo)
        parse_interp_hole(saved, cursor_advance(c1), depth, append(with_hole, [
            part,
          ]))
      elif seg.kind == TIEnd then
        let last = zero_width(EStr(token_text(seg)), cursor_span(saved).lo)
        let c2 = cursor_advance(c1)
        let marker = zero_width(EMarker("interp"), cursor_span(saved).lo)
        PTook(made(saved, c2, ECall(marker, append(with_hole, [last]))), c2)
      else
        let noted = cursor_note(cursor_note(c1, TIMid), TIEnd)
        PStuck(noted)

fn parse_mask(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  let p2 = take_fixed(c1, "<")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = take_word(c2, TUid)
  let PTook(eff, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, ">")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "(")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = parse_expr(c5, depth)
  let PTook(body, c6) = p6 else parsed_refused(p6)
  let p7 = take_fixed(c6, ")")
  let PTook(_, c7) = p7 else parsed_refused(p7)
  PTook(made(c, c7, EMask(eff, body)), c7)

fn parse_error_call(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  if at_fixed(c1, "(") then
    let callee = authored(EVar("error"), cursor_span(c).lo, cursor_span(c).hi)
    parse_call_tail(callee, c1, depth)
  else
    PStuck(cursor_note(c1, TFixed("(")))

fn parse_unboxed_atom(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  if at_fixed(c1, "(") then
    let c2 = cursor_advance(c1)
    let p3 = parse_expr_comma(c2, depth, ")", Nil)
    let PTook(items, c3) = p3 else parsed_refused(p3)
    let p4 = take_fixed(c3, ")")
    let PTook(_, c4) = p4 else parsed_refused(p4)
    PTook(made(c, c4, EUnboxedTuple(items)), c4)
  elif at_fixed(c1, "\{") then
    let p2 = parse_named_fields(cursor_advance(c1), depth, "\}", Nil)
    let PTook(fields, c2) = p2 else parsed_refused(p2)
    let p1 = take_fixed(c2, "\}")
    let PTook(_, c3) = p1 else parsed_refused(p1)
    PTook(made(c, c3, EUnboxedRecord(fields)), c3)
  elif at_kind(c1, TIdent) then
    parse_path_literal(c, c1, depth)
  else
    let noted = cursor_note(
        cursor_note(cursor_note(c1, TFixed("(")), TFixed("\{")),
        TIdent,
      )
    PStuck(noted)

-- The optic literal's reserved binders and the constructor it expands to. A lens
-- names a whole structure and the one part it focuses; neither binder is
-- spellable in source, so no name an author writes can collide with them.
fn path_word() : String = "path"

fn path_whole() : String = "whole@"

fn path_part() : String = "part@"

fn path_lens() : String = "lens"

-- The binder a compound path write reads its focus through.
fn path_focus() : String = "focus@"

-- Refused when the sigil is followed by some other word. The `#` has already
-- committed the expression to this form, so a different word is a misspelling
-- rather than a new construct.
fn path_expected_msg() : String = "expected `path` after `#` here"

-- Refused when a step focuses more than one place. The literal denotes a lens,
-- which names exactly one focus, so admitting a fan-out step would change what
-- the literal is rather than extend it.
fn path_fields_only_msg() : String =
  "a path literal takes field steps only (`#path a.b.c`): `each`, `[i]`, `?Ctor` and `where` focus more than one place, so build those with `traversal` instead of a path literal"

-- Refused when an anchored literal names a type and then stops: the anchor only
-- says what the whole is, so without a field there is nothing to focus.
fn path_anchor_msg() : String =
  "an anchored path literal needs at least one field after the type: `#path Type.field`"

-- `#path a.b.c` denotes a lens over one field chain. The sigil leads because no
-- other expression begins with `#` followed by a name, so one token past the `#`
-- decides this form and `path` stays an ordinary identifier everywhere else. The
-- chain is an ordinary field-access expression, parsed by the same rules as any
-- other, so the literal shares one spelling of a field path with the grammar
-- instead of introducing a second.
fn parse_path_literal(
  saved : Cursor,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = take_word(c, TIdent)
  let PTook(word, c1) = p1 else parsed_refused(p1)
  let p2 = parse_postfix(c1, depth)
  let PTook(operand, c2) = p2 else parsed_refused(p2)
  if word /= path_word() then
    fail_run(saved, c2, path_expected_msg())
  else
    match path_fields(operand, Nil) of
      None => fail_run(saved, c2, path_fields_only_msg())
      Some(all) => finish_path_literal(all, cursor_since(saved, c2), c2)

-- The field names the operand denotes, outermost first. The operand is whatever
-- the ordinary expression rules made of the chain, so its root is the first
-- field rather than a value. Anything focusing something other than one field
-- chain is refused.
fn path_fields(e : Sp(Expr), acc : List(String)) : Option(List(String)) =
  match e.node of
    -- A qualified head lexes as one dotted token, so the root may carry several
    -- segments; the caller decides whether the first of them is a type anchor.
    EVar(root) => Some(append(acc, split(char_at(".", 0), root)))
    EField(base, field) =>
      match path_fields(base, acc) of
        None => None
        Some(fields) => Some(append(fields, [field]))
    -- The bracketed read spelling is the same path written another way and
    -- flattens to the same steps.
    EReadPath(base, steps) =>
      match path_fields(base, acc) of
        None => None
        Some(fields) => path_step_fields(steps, fields)
    _ => None

fn path_step_fields(
  steps : List(PathStep),
  acc : List(String)
) : Option(List(String)) =
  match steps of
    Nil => Some(acc)
    Cons(step, rest) =>
      match step of
        PSField(field) => path_step_fields(rest, append(acc, [field]))
        _ => None

fn finish_path_literal(
  all : List(String),
  span : Span,
  c : Cursor
) : Parsed(Sp(Expr)) =
  match all of
    Nil => PFault(refuse(span, path_anchor_msg()))
    Cons(head, rest) =>
      -- An uppercase head is a root-type anchor rather than a field, since
      -- fields are lowercase. It rides both binders as an ordinary annotation,
      -- which is what lets the literal sit inline where nothing else names the
      -- whole type.
      if str_len(head) > 0 && is_upper(char_at(head, 0)) then
        match rest of
          Nil => PFault(refuse(span, path_anchor_msg()))
          _ => PTook(path_lens_expr(rest, Some(TyCon(head, Nil)), span), c)
      else
        PTook(path_lens_expr(all, None, span), c)

fn path_param(name : String, ty : Option(Ty)) : Param =
  Param {
    name = name,
    pat = None,
    ty = ty,
    is_borrow = false,
    dflt = None
  }

-- Read the chain out of the whole, one field at a time.
fn path_read(fields : List(String), acc : Sp(Expr), span : Span) : Sp(Expr) =
  match fields of
    Nil => acc
    Cons(field, rest) =>
      path_read(rest, authored(EField(acc, field), span.lo, span.hi), span)

-- The lens the literal expands to: a getter that reads the chain and a setter
-- that writes it back. Every piece stands for the one form the author wrote, so
-- all of them carry the literal's own extent; only the call itself is
-- synthesized, since that is the node the formatter restores the surface from.
fn path_lens_expr(
  fields : List(String),
  whole_ty : Option(Ty),
  span : Span
) : Sp(Expr) =
  let read =
    path_read(fields, authored(EVar(path_whole()), span.lo, span.hi), span)
  let getter =
    authored(ELam([path_param(path_whole(), whole_ty)], read), span.lo, span.hi)
  let update = PathUpdate {
    path = map(\(field) -> PSField(field), fields),
    op = POSet(authored(EVar(path_part()), span.lo, span.hi))
  }
  let write = authored(
      EPathUpdate(authored(EVar(path_whole()), span.lo, span.hi), [update]),
      span.lo,
      span.hi,
    )
  let setter = authored(
      ELam(
          [path_param(path_whole(), whole_ty), path_param(path_part(), None)],
          write,
        ),
      span.lo,
      span.hi,
    )
  synthesized(
      ECall(authored(EVar(path_lens()), span.lo, span.hi), [getter, setter]),
      span.lo,
      span.hi,
    )

fn parse_named_fields(
  c : Cursor,
  depth : Int,
  close : String,
  acc : List(NamedExpr)
) : Parsed(List(NamedExpr)) =
  if at_fixed(c, close) then
    PTook(acc, c)
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "=")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_expr(c2, depth)
    let PTook(value, c3) = p3 else parsed_refused(p3)
    let next = append(acc, [NamedExpr { name = name, value = value }])
    if at_fixed(c3, ",") then
      parse_named_fields(cursor_advance(c3), depth, close, next)
    else
      PTook(next, c3)

fn parse_record_atom(
  saved : Cursor,
  name : String,
  brace : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let c = cursor_advance(brace)
  if at_fixed(c, "..") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(base, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      let p2 = parse_named_fields(cursor_advance(c1), depth, "\}", Nil)
      let PTook(fields, c2) = p2 else parsed_refused(p2)
      let p3 = take_fixed(c2, "\}")
      let PTook(_, c3) = p3 else parsed_refused(p3)
      PTook(made(saved, c3, ERecordUpdate(base, name, fields)), c3)
    else
      let p4 = take_fixed(c1, "\}")
      let PTook(_, c2) = p4 else parsed_refused(p4)
      PTook(made(saved, c2, ERecordUpdate(base, name, Nil)), c2)
  else
    let p5 = parse_named_fields(c, depth, "\}", Nil)
    let PTook(fields, c1) = p5 else parsed_refused(p5)
    let p6 = take_fixed(c1, "\}")
    let PTook(_, c2) = p6 else parsed_refused(p6)
    PTook(made(saved, c2, ERecord(name, fields)), c2)

fn parse_list_atom(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  if at_fixed(c1, "]") then
    let c2 = cursor_advance(c1)
    PTook(made(c, c2, EList(Nil)), c2)
  else
    let p2 = parse_expr(c1, depth)
    let PTook(first, c2) = p2 else parsed_refused(p2)
    if at_fixed(c2, "for") then
      parse_comp_tail(c, first, cursor_advance(c2), depth)
    else
      parse_list_more(c, c2, depth, [first])

fn parse_list_more(
  saved : Cursor,
  c : Cursor,
  depth : Int,
  acc : List(Sp(Expr))
) : Parsed(Sp(Expr)) =
  if at_fixed(c, "..") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(hi, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "]")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    PTook(made(saved, c2, ERange(acc, hi)), c2)
  elif at_fixed(c, ",") then
    let c1 = cursor_advance(c)
    if at_fixed(c1, "]") then
      let c2 = cursor_advance(c1)
      PTook(made(saved, c2, EList(acc)), c2)
    elif at_fixed(c1, "..") then
      let p3 = parse_expr(cursor_advance(c1), depth)
      let PTook(hi, c2) = p3 else parsed_refused(p3)
      let p4 = take_fixed(c2, "]")
      let PTook(_, c3) = p4 else parsed_refused(p4)
      PTook(made(saved, c3, ERange(acc, hi)), c3)
    else
      let p5 = parse_expr(c1, depth)
      let PTook(e, c2) = p5 else parsed_refused(p5)
      parse_list_more(saved, c2, depth, append(acc, [e]))
  else
    let p6 = take_fixed(c, "]")
    let PTook(_, c1) = p6 else parsed_refused(p6)
    PTook(made(saved, c1, EList(acc)), c1)

fn parse_comp_tail(
  saved : Cursor,
  head : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = take_word(c, TIdent)
  let PTook(binder, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "in")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr(c2, depth)
  let PTook(seq, c3) = p3 else parsed_refused(p3)
  let p4 = parse_quals(c3, depth, Nil, "]")
  let PTook(qs, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "]")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  PTook(made(saved, c5, EComp(head, binder, seq, qs)), c5)

fn parse_quals(
  c : Cursor,
  depth : Int,
  acc : List(Qual),
  close : String
) : Parsed(List(Qual)) =
  if at_fixed(c, close) then
    PTook(acc, c)
  elif at_fixed(c, ",") then
    let c1 = cursor_advance(c)
    if at_fixed(c1, "let") then
      let p2 = take_word(cursor_advance(c1), TIdent)
      let PTook(name, c2) = p2 else parsed_refused(p2)
      let p3 = take_fixed(c2, "=")
      let PTook(_, c3) = p3 else parsed_refused(p3)
      let p4 = parse_expr(c3, depth)
      let PTook(e, c4) = p4 else parsed_refused(p4)
      parse_quals(c4, depth, append(acc, [QBind(name, e)]), close)
    elif at_fixed(c1, "if") then
      let p1 = parse_expr(cursor_advance(c1), depth)
      let PTook(e, c2) = p1 else parsed_refused(p1)
      parse_quals(c2, depth, append(acc, [QGuard(e)]), close)
    else
      let noted = cursor_note(cursor_note(c1, TFixed("let")), TFixed("if"))
      PStuck(noted)
  else
    PTook(acc, c)

-- -------------------------------------------------------------------------
-- Optic paths
-- -------------------------------------------------------------------------

fn parse_path_update_atom(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  let p2 = parse_expr(c1, depth)
  let PTook(base, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "|")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_path_updates(c3, depth, Nil)
  let PTook(ups, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "\}")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  PTook(made(c, c5, EPathUpdate(base, ups)), c5)

fn parse_path_updates(
  c : Cursor,
  depth : Int,
  acc : List(PathUpdate)
) : Parsed(List(PathUpdate)) =
  let p1 = parse_path_steps(c, depth)
  let PTook(path, c1) = p1 else parsed_refused(p1)
  let p2 = parse_path_write(c, c1, depth)
  let PTook(op, c2) = p2 else parsed_refused(p2)
  let next = append(acc, [PathUpdate { path = path, op = op }])
  if at_fixed(c2, ",") then
    let c3 = cursor_advance(c2)
    if at_fixed(c3, "\}") then
      PTook(next, c3)
    else
      parse_path_updates(c3, depth, next)
  else
    PTook(next, c2)

-- The write at the end of one path: set it, modify it by a function, or apply
-- one of the statement layer's compound terminals at the focus. `saved` is where
-- the update's own steps began, since a compound write stands for the whole
-- update rather than for its right-hand side.
fn parse_path_write(saved : Cursor, c : Cursor, depth : Int) : Parsed(PathOp) =
  if at_fixed(c, "=") || at_fixed(c, "~") then
    let modify = at_fixed(c, "~")
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(value, c1) = p1 else parsed_refused(p1)
    if modify then
      PTook(POModify(value), c1)
    else
      PTook(POSet(value), c1)
  else
    match compound_op(c) of
      None =>
        PStuck(
            note_compound(
                cursor_note(cursor_note(c, TFixed("=")), TFixed("~")),
              ),
          )
      Some(op) =>
        let p1 = parse_expr(cursor_advance(c), depth)
        let PTook(value, c1) = p1 else parsed_refused(p1)
        PTook(compound_path_op(op, value, cursor_since(saved, c1)), c1)

-- `p <op>= e` at a path focus: a modifier that reads the focus, applies the
-- operator, and writes the result back. The lambda is a node the parser invents
-- and it stands for the whole update, so it carries the update's extent.
fn compound_path_op(op : String, value : Sp(Expr), span : Span) : PathOp =
  let focus = authored(EVar(path_focus()), span.lo, span.hi)
  let body = synthesized(EBin(op, focus, value), span.lo, span.hi)
  POModify(
      synthesized(
          ELam([path_param(path_focus(), None)], body),
          span.lo,
          span.hi,
        ),
    )

fn parse_path_steps(c : Cursor, depth : Int) : Parsed(List(PathStep)) =
  let p1 = parse_path_segment(c, depth)
  let PTook(first, c1) = p1 else parsed_refused(p1)
  parse_path_rest(c1, depth, first)

fn parse_path_rest(
  c : Cursor,
  depth : Int,
  acc : List(PathStep)
) : Parsed(List(PathStep)) =
  if at_fixed(c, ".") then
    let p1 = parse_path_segment(cursor_advance(c), depth)
    let PTook(seg, c1) = p1 else parsed_refused(p1)
    parse_path_rest(c1, depth, append(acc, seg))
  else
    PTook(acc, c)

fn parse_path_segment(c : Cursor, depth : Int) : Parsed(List(PathStep)) =
  match cursor_peek(c) of
    None =>
      let c1 = cursor_note(cursor_note(c, TIdent), TFixed("each"))
      PStuck(cursor_note(c1, TFixed("[")))
    Some(t) =>
      if t.kind == TIdent then
        parse_path_indexes(cursor_advance(c), depth, [PSField(token_text(t))])
      elif t.kind == TFixed("each") then
        parse_path_indexes(cursor_advance(c), depth, [PSEach])
      elif t.kind == TFixed("?") then
        parse_case_segment(cursor_advance(c), depth)
      elif t.kind == TFixed("(") then
        parse_filtered_segment(c, depth)
      elif t.kind == TFixed("[") then
        parse_path_indexes(c, depth, Nil)
      else
        let c1 = cursor_note(cursor_note(c, TIdent), TFixed("each"))
        PStuck(cursor_note(c1, TFixed("[")))

fn parse_case_segment(c : Cursor, depth : Int) : Parsed(List(PathStep)) =
  match cursor_peek(c) of
    None => PStuck(cursor_note(cursor_note(c, TUid), TQual))
    Some(t) =>
      if t.kind == TUid then
        parse_path_indexes(cursor_advance(c), depth, [PSCase(token_text(t))])
      elif t.kind == TQual then
        let pieces = split(char_at(".", 0), token_text(t))
        match pieces of
          Nil => PStuck(cursor_note(c, TQual))
          Cons(ctor, fields) =>
            let steps =
              Cons(PSCase(ctor), map(\(field) -> PSField(field), fields))
            parse_path_indexes(cursor_advance(c), depth, steps)
      else
        PStuck(cursor_note(cursor_note(c, TUid), TQual))

fn parse_filtered_segment(c : Cursor, depth : Int) : Parsed(List(PathStep)) =
  let c1 = cursor_advance(c)
  let p2 = parse_path_steps(c1, depth)
  let PTook(inner, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "where")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_expr(c3, depth)
  let PTook(pred, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, ")")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  parse_path_indexes(c5, depth, append(inner, [PSWhere(pred)]))

fn parse_path_indexes(
  c : Cursor,
  depth : Int,
  acc : List(PathStep)
) : Parsed(List(PathStep)) =
  if at_fixed(c, "[") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(index, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "]")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    parse_path_indexes(c2, depth, append(acc, [PSIndex(index)]))
  elif length(acc) > 0 then
    PTook(acc, c)
  else
    PStuck(cursor_note(c, TFixed("[")))

-- -------------------------------------------------------------------------
-- Expression entry and leading-token forms
-- -------------------------------------------------------------------------

-- | Parse one expression from `c`, leaving the first following token
-- unconsumed. The caller supplies the remaining structural depth budget.
pub fn parse_expr(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = descend(depth, c)
  let PTook(d, _) = p1 else parsed_refused(p1)
  parse_expr_top(c, d)

-- lint: allow(L0101)
fn parse_expr_top(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  if at_fixed(c, "if") then
    parse_if_form(c, depth, false)
  elif at_fixed(c, "let") then
    parse_let_form(c, depth)
  elif at_fixed(c, "\\") then
    parse_lambda(c, depth)
  elif at_fixed(c, "match") then
    parse_match(c, depth)
  elif at_fixed(c, "handle") then
    parse_handle(c, depth)
  elif at_fixed(c, "throw") then
    parse_throw(c, depth)
  elif at_fixed(c, "try") then
    parse_try(c, depth)
  elif at_fixed(c, "transact") then
    parse_transact(c, depth)
  elif at_fixed(c, "probe") then
    parse_probe(c, depth)
  elif at_fixed(c, "for") then
    parse_for(c, depth)
  elif at_fixed(c, "while") then
    parse_while(c, depth)
  elif at_fixed(c, "loop") then
    parse_loop(c, depth)
  elif at_fixed(c, "return") then
    parse_return(c, depth)
  elif (peek_word(c) == "reflect"
      && (fixed_at(c, 1, "fn") || fixed_at(c, 1, "type"))) then
    parse_reflect(c)
  else
    let p1 = parse_bp(c, depth, 0)
    let PTook(lhs, c1) = p1 else parsed_refused(p1)
    parse_assignment_tail(c, lhs, c1, depth)

fn parse_assignment_tail(
  saved : Cursor,
  lhs : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  if at_fixed(c, ":=") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(value, c1) = p1 else parsed_refused(p1)
    build_assign(saved, lhs, value, c1)
  else
    match compound_op(c) of
      None => PTook(lhs, c)
      Some(op) =>
        let p2 = parse_expr(cursor_advance(c), depth)
        let PTook(value, c1) = p2 else parsed_refused(p2)
        build_compound(saved, lhs, op, value, c1)

-- The compound assignment terminals and the binary operator each one stands
-- for. One home for the family: the statement layer and the path-update layer
-- read the same table instead of each spelling out the four cases.
fn compound_op(c : Cursor) : Option(String) =
  if at_fixed(c, "+=") then
    Some("+")
  elif at_fixed(c, "-=") then
    Some("-")
  elif at_fixed(c, "*=") then
    Some("*")
  elif at_fixed(c, "%=") then
    Some("%")
  else
    None

-- Note every compound terminal as an expectation, so a refusal names the
-- spellings the parser really does accept in the position it just refused.
fn note_compound(c : Cursor) : Cursor =
  cursor_note(
      cursor_note(
          cursor_note(cursor_note(c, TFixed("+=")), TFixed("-=")),
          TFixed("*="),
        ),
      TFixed("%="),
    )

-- `lvalue := value`: assign to a mutable binder, to an index target `a[i]`, or
-- to a field path, which is the brace update it abbreviates. Any other left side
-- is refused.
fn build_assign(
  saved : Cursor,
  lhs : Sp(Expr),
  value : Sp(Expr),
  c : Cursor
) : Parsed(Sp(Expr)) =
  let span = cursor_since(saved, c)
  match assign_route(lhs, POSet(value), span) of
    Some(routed) => PTook(routed, c)
    None =>
      match lhs.node of
        EVar(name) => PTook(authored(EAssign(name, value), span.lo, span.hi), c)
        EIndex(recv, key) =>
          PTook(authored(EIndexAssign(recv, key, value), span.lo, span.hi), c)
        _ => PFault(refuse(lhs.span, assign_lhs_msg()))

fn build_compound(
  saved : Cursor,
  lhs : Sp(Expr),
  op : String,
  value : Sp(Expr),
  c : Cursor
) : Parsed(Sp(Expr)) =
  let span = cursor_since(saved, c)
  let written = POSet(compound_read_back(lhs, op, value, span))
  match assign_route(lhs, written, span) of
    Some(routed) => PTook(routed, c)
    None =>
      match lhs.node of
        EVar(name) =>
          let read = authored(EVar(name), span.lo, span.hi)
          let rhs = synthesized(EBin(op, read, value), span.lo, span.hi)
          PTook(authored(EAssign(name, rhs), span.lo, span.hi), c)
        EIndex(recv, key) =>
          let read = synthesized(EIndex(recv, key), span.lo, span.hi)
          let rhs = synthesized(EBin(op, read, value), span.lo, span.hi)
          PTook(authored(EIndexAssign(recv, key, rhs), span.lo, span.hi), c)
        _ => PFault(refuse(lhs.span, compound_lhs_msg()))

fn assign_lhs_msg() : String =
  "the left side of `:=` must be a variable, an index `a[i]`, or a field path rooted at a variable (`x.a[i].b`)"

fn compound_lhs_msg() : String =
  "the left side of a compound assignment must be a variable, an index `a[i]`, or a field path rooted at a variable (`x.a[i].b`)"

-- A statement compound reads its focus first and sets it, the shape `a[i] += e`
-- already has, rather than closing over the right operand in a modifier lambda:
-- the roots here are mutable cells or ambient state, so the re-read is a pure
-- perform, and with no lambda there is nothing for the escape analysis to
-- mistake for a captured cell.
fn compound_read_back(
  lhs : Sp(Expr),
  op : String,
  value : Sp(Expr),
  span : Span
) : Sp(Expr) =
  let read = synthesized(lhs.node, span.lo, span.hi)
  synthesized(EBin(op, read, value), span.lo, span.hi)

-- The two path routes a statement lvalue may take before the plain forms are
-- tried: a field path rooted at a binder, or one rooted at ambient state.
fn assign_route(lhs : Sp(Expr), op : PathOp, span : Span) : Option(Sp(Expr)) =
  match lvalue_path(lhs.node) of
    Some(LPath(root, steps)) =>
      if has_field_step(steps) then
        Some(path_assign(root, steps, op, span))
      else
        state_route(lhs, op, span)
    None => state_route(lhs, op, span)

fn state_route(lhs : Sp(Expr), op : PathOp, span : Span) : Option(Sp(Expr)) =
  match state_lvalue(lhs.node) of
    None => None
    Some(steps) =>
      match steps of
        Nil => None
        _ => Some(state_assign(steps, op, span))

-- A statement lvalue flattened to a root binder and the steps taken from it.
type LPath = LPath(String, List(PathStep))

-- The lvalue shapes a statement assignment accepts beyond a bare name: a chain
-- of field accesses and index steps over a root binder, flattened to the steps
-- the brace form takes. A dotted (qualified) or uppercase root names a
-- constructor rather than a binder and is never assignable, so it declines.
fn lvalue_path(e : Expr) : Option(LPath) =
  match e of
    EVar(x) =>
      if (contains(".", x) || str_len(x) > 0 && is_upper(char_at(x, 0))) then
        None
      else
        Some(LPath(x, Nil))
    EField(base, field) =>
      match lvalue_path(base.node) of
        None => None
        Some(LPath(root, steps)) =>
          Some(LPath(root, append(steps, [PSField(field)])))
    EIndex(base, key) =>
      match lvalue_path(base.node) of
        None => None
        Some(LPath(root, steps)) =>
          Some(LPath(root, append(steps, [PSIndex(key)])))
    _ => None

-- Whether a flattened lvalue needs the path route: any field step does. A chain
-- of index steps alone keeps the older assign forms, so programs written before
-- the path route existed desugar exactly as they did.
fn has_field_step(steps : List(PathStep)) : Bool =
  match steps of
    Nil => false
    Cons(step, rest) =>
      match step of
        PSField(_) => true
        _ => has_field_step(rest)

-- The ambient-state lvalue: a path rooted at a literal `get()` call, as in
-- `get().metas.next += 1`. The root spells the operation actually performed, so
-- nothing implicit is invented.
fn state_lvalue(e : Expr) : Option(List(PathStep)) =
  match e of
    ECall(callee, args) =>
      match args of
        Cons(_, _) => None
        Nil =>
          match callee.node of
            EVar(name) =>
              if name == state_get() then
                Some(Nil)
              else
                None
            _ => None
    EField(base, field) =>
      match state_lvalue(base.node) of
        None => None
        Some(steps) => Some(append(steps, [PSField(field)]))
    EIndex(base, key) =>
      match state_lvalue(base.node) of
        None => None
        Some(steps) => Some(append(steps, [PSIndex(key)]))
    _ => None

-- The ambient-state operations a `get()`-rooted statement stands for.
fn state_get() : String = "get"

fn state_put() : String = "put"

-- `x.a[i].b OP rhs` is the brace update it abbreviates, `x := { x | a[i].b OP
-- rhs }`. The brace node is synthesized, which is what the formatter matches on
-- to restore the statement surface; a hand-written `x := { x | ... }` is
-- authored and keeps its explicit form.
fn path_assign(
  root : String,
  steps : List(PathStep),
  op : PathOp,
  span : Span
) : Sp(Expr) =
  let update = synthesized(
      EPathUpdate(authored(EVar(root), span.lo, span.hi), [
          PathUpdate { path = steps, op = op },
        ]),
      span.lo,
      span.hi,
    )
  authored(EAssign(root, update), span.lo, span.hi)

-- `get().a.b OP rhs` is the longhand it abbreviates, `put({ get() | a.b OP rhs
-- })`, with both names resolving in the program's own scope. The brace node is
-- synthesized for the same reason as the binder-rooted form.
fn state_assign(steps : List(PathStep), op : PathOp, span : Span) : Sp(Expr) =
  let read = authored(
      ECall(authored(EVar(state_get()), span.lo, span.hi), []),
      span.lo,
      span.hi,
    )
  let update = synthesized(
      EPathUpdate(read, [PathUpdate { path = steps, op = op }]),
      span.lo,
      span.hi,
    )
  authored(
      ECall(authored(EVar(state_put()), span.lo, span.hi), [update]),
      span.lo,
      span.hi,
    )

-- | Parse an expression or a layout-delimited statement block. Declaration
-- bodies use the same production as control-flow branches, so this seam is
-- public to `Syntax.Parse.Decl` rather than duplicated there.
pub fn parse_expr_or_block(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  if at_kind(c, TVOpen) then
    parse_block(c, depth)
  else
    parse_expr(c, depth)

fn parse_if_form(
  saved : Cursor,
  depth : Int,
  allow_open : Bool
) : Parsed(Sp(Expr)) =
  let p1 = parse_expr(cursor_advance(saved), depth)
  let PTook(cond, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "then")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr_or_block(c2, depth)
  let PTook(yes, c3) = p3 else parsed_refused(p3)
  let p4 = parse_if_finish(saved, cond, yes, c3, depth, allow_open)
  let PTook(branch, c4) = p4 else parsed_refused(p4)
  PTook(branch.expr, c4)

-- lint: allow(L0103)
fn parse_if_finish(
  saved : Cursor,
  cond : Sp(Expr),
  yes : Sp(Expr),
  c : Cursor,
  depth : Int,
  allow_open : Bool
) : Parsed(IfBranch) =
  let tail =
    if (at_kind(c, TVSemi) && (fixed_at(c, 1, "else") || fixed_at(c, 1, "elif"))) then
      cursor_advance(c)
    else
      c
  if at_fixed(tail, "else") then
    let p1 = parse_expr_or_block(cursor_advance(tail), depth)
    let PTook(no, c1) = p1 else parsed_refused(p1)
    PTook(
        IfBranch { expr = made(saved, c1, EIf(cond, yes, no)), open = false },
        c1,
      )
  elif at_fixed(tail, "elif") then
    let p2 = parse_elif(c, tail, depth, allow_open)
    let PTook(branch, c1) = p2 else parsed_refused(p2)
    let no =
      if branch.open then
        widen_if_chain(branch.expr, cursor_span(saved).lo)
      else
        branch.expr
    PTook(
        IfBranch {
          expr = made(saved, c1, EIf(cond, yes, no)),
          open = branch.open
        },
        c1,
      )
  elif allow_open then
    let unit = zero_width(EUnit, yes.span.hi)
    PTook(
        IfBranch { expr = made(saved, c, EIf(cond, yes, unit)), open = true },
        c,
      )
  else
    let c1 = cursor_note(cursor_note(tail, TFixed("else")), TFixed("elif"))
    PStuck(c1)

fn parse_elif(
  saved : Cursor,
  c : Cursor,
  depth : Int,
  allow_open : Bool
) : Parsed(IfBranch) =
  let p1 = parse_expr(cursor_advance(c), depth)
  let PTook(cond, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "then")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr_or_block(c2, depth)
  let PTook(yes, c3) = p3 else parsed_refused(p3)
  parse_if_finish(saved, cond, yes, c3, depth, allow_open)

fn widen_if_chain(e : Sp(Expr), lo : Int) : Sp(Expr) =
  match e.node of
    EIf(cond, yes, no) =>
      Sp {
        node = EIf(cond, yes, widen_if_chain(no, lo)),
        span = Span { lo = lo, hi = e.span.hi },
        synth = e.synth
      }
    _ => e

fn parse_let_form(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let c1 = cursor_advance(c)
  if at_kind(c1, TIdent) then
    let p2 = take_word(c1, TIdent)
    let PTook(name, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "=")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_expr(c3, depth)
    let PTook(value, c4) = p4 else parsed_refused(p4)
    let p5 = take_fixed(c4, "in")
    let PTook(_, c5) = p5 else parsed_refused(p5)
    let p6 = parse_expr(c5, depth)
    let PTook(body, c6) = p6 else parsed_refused(p6)
    PTook(made(saved, c6, ELet(name, value, body)), c6)
  else
    let p1 = parse_pattern(c1, depth)
    let PTook(pat, c2) = p1 else parsed_refused(p1)
    let p7 = take_fixed(c2, "=")
    let PTook(_, c3) = p7 else parsed_refused(p7)
    let p8 = parse_expr(c3, depth)
    let PTook(value, c4) = p8 else parsed_refused(p8)
    let p9 = take_fixed(c4, "in")
    let PTook(_, c5) = p9 else parsed_refused(p9)
    let p10 = parse_expr(c5, depth)
    let PTook(body, c6) = p10 else parsed_refused(p10)
    let arm = Arm { pat = pat, guard = None, body = body }
    PTook(
        synthesized(
            EMatch(value, [arm]),
            cursor_span(saved).lo,
            cursor_span(saved).lo,
          ),
        c6,
      )

fn parse_lambda(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = take_fixed(cursor_advance(c), "(")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = parse_params(c1, depth, 0, Nil)
  let PTook(params, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, ")")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "->")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_expr(c4, depth)
  let PTook(body, c5) = p5 else parsed_refused(p5)
  PTook(made(saved, c5, ELam(params, body)), c5)

fn parse_throw(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = take_word(cursor_advance(c), TUid)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, "(") then
    let p2 = parse_expr_comma(cursor_advance(c1), depth, ")", Nil)
    let PTook(args, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, ")")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    PTook(made(saved, c3, EThrow(name, args)), c3)
  else
    PTook(made(saved, c1, EThrow(name, Nil)), c1)

fn parse_return(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = parse_expr(cursor_advance(c), depth)
  let PTook(value, c1) = p1 else parsed_refused(p1)
  PTook(made(c, c1, EReturn(value)), c1)

fn parse_while(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = parse_expr(cursor_advance(c), depth)
  let PTook(cond, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "do")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr_or_block(c2, depth)
  let PTook(body, c3) = p3 else parsed_refused(p3)
  PTook(made(c, c3, EWhile(cond, body)), c3)

fn parse_loop(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = parse_expr_or_block(cursor_advance(c), depth)
  let PTook(body, c1) = p1 else parsed_refused(p1)
  PTook(made(c, c1, ELoop(body)), c1)

fn parse_transact(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = parse_expr_or_block(cursor_advance(c), depth)
  let PTook(body, c1) = p1 else parsed_refused(p1)
  let c2 =
    if at_kind(c1, TVSemi) then
      cursor_advance(c1)
    else
      c1
  let p3 = take_fixed(c2, "else")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_expr_or_block(c3, depth)
  let PTook(fallback, c4) = p4 else parsed_refused(p4)
  PTook(made(c, c4, ETransact(body, fallback)), c4)

fn parse_probe(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = take_word(cursor_advance(c), TStr)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "do")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr_or_block(c2, depth)
  let PTook(body, c3) = p3 else parsed_refused(p3)
  PTook(made(c, c3, EProbe(name, body)), c3)

fn parse_reflect(c : Cursor) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  let decl =
    if at_fixed(c1, "fn") then
      "fn"
    else
      "type"
  let c2 = cursor_advance(c1)
  match cursor_peek(c2) of
    None =>
      PStuck(cursor_note(cursor_note(cursor_note(c2, TIdent), TUid), TQual))
    Some(t) =>
      if t.kind == TIdent || t.kind == TUid || t.kind == TQual then
        let c3 = cursor_advance(c2)
        PTook(made(c, c3, EReflect(decl, token_text(t))), c3)
      else
        PStuck(cursor_note(cursor_note(cursor_note(c2, TIdent), TUid), TQual))

fn parse_for(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = take_word(cursor_advance(c), TIdent)
  let PTook(binder, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "in")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr(c2, depth)
  let PTook(seq, c3) = p3 else parsed_refused(p3)
  let p4 = parse_quals(c3, depth, Nil, "do")
  let PTook(qs, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "do")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = parse_expr_or_block(c5, depth)
  let PTook(body, c6) = p6 else parsed_refused(p6)
  PTook(made(c, c6, EFor(binder, seq, qs, body)), c6)

-- -------------------------------------------------------------------------
-- Parameters, arms, handlers, and catches
-- -------------------------------------------------------------------------

fn parse_params(
  c : Cursor,
  depth : Int,
  index : Int,
  acc : List(Param)
) : Parsed(List(Param)) =
  if at_fixed(c, ")") then
    PTook(acc, c)
  else
    let p1 = parse_param(c, depth, index)
    let PTook(param, c1) = p1 else parsed_refused(p1)
    let next = append(acc, [param])
    if at_fixed(c1, ",") then
      parse_params(cursor_advance(c1), depth, index + 1, next)
    else
      PTook(next, c1)

fn parse_param(c : Cursor, depth : Int, index : Int) : Parsed(Param) =
  let borrowed = at_fixed(c, "borrow")
  let c1 =
    if borrowed then
      cursor_advance(c)
    else
      c
  let p2 = parse_pattern(c1, depth)
  let PTook(pat, c2) = p2 else parsed_refused(p2)
  let p3 = parse_param_type(c2, depth)
  let PTook(ty, c3) = p3 else parsed_refused(p3)
  let p4 = parse_param_default(c3, depth)
  let PTook(dflt, c4) = p4 else parsed_refused(p4)
  match pat.node of
    PVar(name) =>
      PTook(
          Param {
            name = name,
            pat = None,
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          },
          c4,
        )
    PWild =>
      PTook(
          Param {
            name = "_",
            pat = None,
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          },
          c4,
        )
    _ =>
      PTook(
          Param {
            name = "arg@{index}",
            pat = Some(pat),
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          },
          c4,
        )

fn parse_param_type(c : Cursor, depth : Int) : Parsed(Option(Ty)) =
  if at_fixed(c, ":") then
    let p1 = parse_type(cursor_advance(c), depth)
    let PTook(ty, c1) = p1 else parsed_refused(p1)
    PTook(Some(ty), c1)
  else
    PTook(None, c)

fn parse_param_default(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if at_fixed(c, ":=") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    PTook(Some(e), c1)
  else
    PTook(None, c)

fn parse_brace_open(c : Cursor) : Parsed(Bool) =
  if at_fixed(c, "\{") then
    PTook(false, cursor_advance(c))
  elif at_kind(c, TVOpen) then
    PTook(true, cursor_advance(c))
  else
    let c1 = cursor_note(cursor_note(c, TFixed("\{")), TVOpen)
    PStuck(c1)

fn at_brace_close(c : Cursor, layout : Bool) : Bool =
  if layout then
    at_kind(c, TVClose)
  else
    at_fixed(c, "\}")

fn take_brace_close(c : Cursor, layout : Bool) : Parsed(Token) =
  if layout then
    take_kind(c, TVClose)
  else
    take_fixed(c, "\}")

-- Arms is nullable. Preserve that close alternative only when Pattern failed
-- without consuming input; a deeper Pattern failure owns its later position.
fn note_arm_close_if_same(
  start : Cursor,
  failed : Cursor,
  layout : Bool
) : Cursor =
  if failed.pos == start.pos then
    if layout then
      cursor_note(failed, TVClose)
    else
      cursor_note(failed, TFixed("\}"))
  else
    failed

fn skip_arm_sep(c : Cursor) : (Bool, Cursor) =
  if at_fixed(c, ",") || at_kind(c, TVSemi) then
    (true, cursor_advance(c))
  else
    (false, c)

fn parse_match(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = parse_expr(cursor_advance(c), depth)
  let PTook(scrutinee, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "of")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_brace_open(c2)
  let PTook(layout, c3) = p3 else parsed_refused(p3)
  let p4 = parse_match_arms(c3, depth, layout, Nil)
  let PTook(arms, c4) = p4 else parsed_refused(p4)
  let p5 = take_brace_close(c4, layout)
  let PTook(_, c5) = p5 else parsed_refused(p5)
  PTook(made(saved, c5, EMatch(scrutinee, arms)), c5)

-- lint: allow(L0101)
fn parse_match_arms(
  c : Cursor,
  depth : Int,
  layout : Bool,
  acc : List(Arm)
) : Parsed(List(Arm)) =
  if at_brace_close(c, layout) then
    PTook(acc, c)
  else
    match parse_pattern(c, depth) of
      PStuck(c1) => PStuck(note_arm_close_if_same(c, c1, layout))
      PFault(d) => PFault(d)
      PTook(pat, c1) =>
        let p2 = parse_guard(c1, depth)
        let PTook(guard, c2) = p2 else parsed_refused(p2)
        let p3 = take_fixed(c2, "=>")
        let PTook(_, c3) = p3 else parsed_refused(p3)
        let p4 = parse_expr_or_block(c3, depth)
        let PTook(body, c4) = p4 else parsed_refused(p4)
        let next = append(acc, [Arm { pat = pat, guard = guard, body = body }])
        let sep = skip_arm_sep(c4)
        match sep of
          (true, c5) => parse_match_arms(c5, depth, layout, next)
          (false, c5) =>
            if at_brace_close(c5, layout) then
              PTook(next, c5)
            else
              let c6 = cursor_note(cursor_note(c5, TFixed(",")), TVSemi)
              PStuck(c6)

fn parse_guard(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if at_fixed(c, "if") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(g, c1) = p1 else parsed_refused(p1)
    PTook(Some(g), c1)
  else
    PTook(None, c)

fn parse_try(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = parse_expr_or_block(cursor_advance(c), depth)
  let PTook(body, c1) = p1 else parsed_refused(p1)
  let c2 =
    if at_kind(c1, TVSemi) then
      cursor_advance(c1)
    else
      c1
  let p3 = take_fixed(c2, "catch")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_brace_open(c3)
  let PTook(layout, c4) = p4 else parsed_refused(p4)
  let p5 = parse_catch_arms(c4, depth, layout, Nil)
  let PTook(arms, c5) = p5 else parsed_refused(p5)
  let p6 = take_brace_close(c5, layout)
  let PTook(_, c6) = p6 else parsed_refused(p6)
  PTook(made(saved, c6, ETryCatch(body, arms)), c6)

-- lint: allow(L0101)
fn parse_catch_arms(
  c : Cursor,
  depth : Int,
  layout : Bool,
  acc : List(CatchArm)
) : Parsed(List(CatchArm)) =
  if at_brace_close(c, layout) then
    PTook(acc, c)
  else
    let saved = c
    let p1 = take_word(c, TUid)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = parse_binders_maybe(c1)
    let PTook(binders, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "=>")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_expr_or_block(c3, depth)
    let PTook(body, c4) = p4 else parsed_refused(p4)
    let arm = CatchArm {
      name = name,
      binders = binders,
      body = body,
      span = cursor_since(saved, c4)
    }
    let next = append(acc, [arm])
    let sep = skip_arm_sep(c4)
    match sep of
      (true, c5) => parse_catch_arms(c5, depth, layout, next)
      (false, c5) =>
        if at_brace_close(c5, layout) then
          PTook(next, c5)
        else
          PStuck(cursor_note(cursor_note(c5, TFixed(",")), TVSemi))

fn parse_binders_maybe(c : Cursor) : Parsed(List(String)) =
  if at_fixed(c, "(") then
    parse_binders(cursor_advance(c), Nil)
  else
    PTook(Nil, c)

fn parse_binders(c : Cursor, acc : List(String)) : Parsed(List(String)) =
  if at_fixed(c, ")") then
    PTook(acc, cursor_advance(c))
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let next = append(acc, [name])
    if at_fixed(c1, ",") then
      parse_binders(cursor_advance(c1), next)
    else
      let p2 = take_fixed(c1, ")")
      let PTook(_, c2) = p2 else parsed_refused(p2)
      PTook(next, c2)

fn parse_handle(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = parse_expr(cursor_advance(c), depth)
  let PTook(body, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "with")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let partial = peek_word(c2) == "partial"
  let c3 =
    if partial then
      cursor_advance(c2)
    else
      c2
  if at_kind(c3, TIdent) then
    fail_at(c3, "unknown handler mode (expected `partial`)")
  else
    let p4 = parse_brace_open(c3)
    let PTook(layout, c4) = p4 else parsed_refused(p4)
    let p5 = parse_handler_arms(c4, depth, layout, Nil)
    let PTook(arms, c5) = p5 else parsed_refused(p5)
    let p6 = take_brace_close(c5, layout)
    let PTook(_, c6) = p6 else parsed_refused(p6)
    PTook(made(saved, c6, EHandle(body, arms, partial)), c6)

fn parse_handler_arms(
  c : Cursor,
  depth : Int,
  layout : Bool,
  acc : List(HandlerArm)
) : Parsed(List(HandlerArm)) =
  if at_brace_close(c, layout) then
    PTook(acc, c)
  else
    let p1 = parse_handler_arm(c, depth)
    let PTook(arm, c1) = p1 else parsed_refused(p1)
    let next = append(acc, [arm])
    let sep = skip_arm_sep(c1)
    match sep of
      (true, c2) => parse_handler_arms(c2, depth, layout, next)
      (false, c2) =>
        if at_brace_close(c2, layout) then
          PTook(next, c2)
        else
          PStuck(cursor_note(cursor_note(c2, TFixed(",")), TVSemi))

fn parse_handler_arm(c : Cursor, depth : Int) : Parsed(HandlerArm) =
  if at_fixed(c, "return") then
    let p1 = take_word(cursor_advance(c), TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "=>")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_expr_or_block(c2, depth)
    let PTook(body, c3) = p3 else parsed_refused(p3)
    PTook(HReturn(name, body), c3)
  elif at_fixed(c, "val") then
    let p4 = take_word(cursor_advance(c), TIdent)
    let PTook(name, c1) = p4 else parsed_refused(p4)
    let p5 = take_fixed(c1, "=")
    let PTook(_, c2) = p5 else parsed_refused(p5)
    let p6 = parse_expr_or_block(c2, depth)
    let PTook(body, c3) = p6 else parsed_refused(p6)
    PTook(HVal(name, body), c3)
  elif at_kind(c, TIdent) && kind_at(c, 1, TIdent) then
    parse_graded_arm(c, depth)
  else
    parse_operation_arm(c, depth)

-- lint: allow(L0101)
fn parse_graded_arm(c : Cursor, depth : Int) : Parsed(HandlerArm) =
  let p1 = take_word(c, TIdent)
  let PTook(grade, c1) = p1 else parsed_refused(p1)
  let p2 = take_word(c1, TIdent)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  if grade == "many" then
    fail_run(
        c,
        c2,
        "a `many` clause binds a continuation after `resume` and takes no leading grade",
      )
  elif grade /= "once" && grade /= "never" then
    fail_run(c, c2, "unknown handler grade (expected `once` or `never`)")
  else
    let p3 = take_fixed(c2, "(")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_binders(c3, Nil)
    let PTook(params, c4) = p4 else parsed_refused(p4)
    let p5 = take_fixed(c4, "=>")
    let PTook(_, c5) = p5 else parsed_refused(p5)
    let p6 = parse_expr_or_block(c5, depth)
    let PTook(body, c6) = p6 else parsed_refused(p6)
    if grade == "once" then
      PTook(HOnce(name, params, body), c6)
    else
      PTook(HNever(name, params, body), c6)

-- lint: allow(L0101)
fn parse_operation_arm(c : Cursor, depth : Int) : Parsed(HandlerArm) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "(")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_binders(c2, Nil)
  let PTook(params, c3) = p3 else parsed_refused(p3)
  if peek_word(c3) /= "resume" then
    fail_run(
        saved,
        c3,
        "a multishot clause names its continuation after `resume`",
      )
  else
    let p4 = take_word(cursor_advance(c3), TIdent)
    let PTook(resume, c4) = p4 else parsed_refused(p4)
    let p5 = take_fixed(c4, "=>")
    let PTook(_, c5) = p5 else parsed_refused(p5)
    let p6 = parse_expr_or_block(c5, depth)
    let PTook(body, c6) = p6 else parsed_refused(p6)
    PTook(HOp(name, params, resume, body), c6)

-- -------------------------------------------------------------------------
-- Layout blocks and statement sugar
-- -------------------------------------------------------------------------

-- A layout block spends one budget unit at entry: blocks nest through
-- statement forms (an open `if` body holding another open `if`) without
-- passing any other spending production, so the block door is where the
-- depth contract must collect.
fn parse_block(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let p1 = descend(depth, c)
  let PTook(spent, _c0) = p1 else parsed_refused(p1)
  parse_block_at(c, spent)

fn parse_block_at(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = take_kind(c, TVOpen)
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = parse_stmts(c1, depth)
  let PTook(body, c2) = p2 else parsed_refused(p2)
  match take_kind(c2, TVClose) of
    PStuck(c3) =>
      -- A completed Stmts can either continue through its separator
      -- or let BlockExpr consume the close. Do not merge an older
      -- position if the close primitive ever gains consuming failure.
      if c3.pos == c2.pos then
        PStuck(cursor_note(c3, TVSemi))
      else
        PStuck(c3)
    PFault(d) => PFault(d)
    PTook(_, c3) =>
      let span = cursor_since(saved, c3)
      PTook(Sp { node = body.node, span = span, synth = body.synth }, c3)

fn parse_stmts(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  if at_fixed(c, "let") then
    parse_let_stmt(c, depth)
  elif at_fixed(c, "var") then
    parse_var_stmt(c, depth)
  elif at_fixed(c, "with") then
    parse_with_stmt(c, depth)
  elif at_fixed(c, "if") then
    let p1 = parse_if_form(c, depth, true)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    parse_stmt_rest(c, e, c1, depth)
  elif at_kind(c, TVClose) then
    PStuck(note_expr(c))
  else
    let p2 = parse_expr(c, depth)
    let PTook(e, c1) = p2 else parsed_refused(p2)
    parse_stmt_rest(c, e, c1, depth)

fn parse_stmt_rest(
  saved : Cursor,
  e : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  if at_kind(c, TVSemi) then
    let p1 = parse_stmts(cursor_advance(c), depth)
    let PTook(rest, c1) = p1 else parsed_refused(p1)
    match try_scrutinee(e) of
      Some(scrutinee) =>
        PTook(build_try_stmt(None, scrutinee, rest, cursor_span(saved).lo), c1)
      None => PTook(made(saved, c1, ELet("_", e, rest)), c1)
  else
    PTook(e, c)

fn try_scrutinee(e : Sp(Expr)) : Option(Sp(Expr)) =
  match e.node of
    ECall(head, args) =>
      match head.node of
        EMarker(marker) =>
          if marker == "try" then
            match args of
              Cons(scrutinee, Nil) => Some(scrutinee)
              _ => None
          else
            None
        _ => None
    _ => None

fn build_try_stmt(
  binder : Option(Sp(Pat)),
  scrutinee : Sp(Expr),
  rest : Sp(Expr),
  lo : Int
) : Sp(Expr) =
  let span = scrutinee.span
  let ok_value =
    match binder of
      None => authored(PWild, span.lo, span.hi)
      Some(pat) => pat
  let ok = authored(PCtor("Ok", [ok_value]), span.lo, span.hi)
  let err_value = authored(PVar("e@"), span.lo, span.hi)
  let err = authored(PCtor("Err", [err_value]), span.lo, span.hi)
  let err_ctor = authored(EVar("Err"), span.lo, span.hi)
  let err_var = authored(EVar("e@"), span.lo, span.hi)
  let rethrow = authored(ECall(err_ctor, [err_var]), span.lo, span.hi)
  let arms = [
      Arm { pat = ok, guard = None, body = rest },
      Arm { pat = err, guard = None, body = rethrow },
    ]
  synthesized(EMatch(scrutinee, arms), lo, lo)

fn build_pattern_let_stmt(
  pat : Sp(Pat),
  value : Sp(Expr),
  rest : Sp(Expr),
  lo : Int
) : Sp(Expr) =
  match try_scrutinee(value) of
    Some(scrutinee) => build_try_stmt(Some(pat), scrutinee, rest, lo)
    None =>
      let arm = Arm { pat = pat, guard = None, body = rest }
      synthesized(EMatch(value, [arm]), lo, lo)

-- A plain `let name = value` statement continuation: a `try` value routes
-- through the try desugar with the name as its binder, anything else is a
-- direct let.
fn finish_ident_let_stmt(
  saved : Cursor,
  c : Cursor,
  name : String,
  value : Sp(Expr),
  rest : Sp(Expr)
) : Sp(Expr) =
  match try_scrutinee(value) of
    Some(scrutinee) =>
      let binder = authored(PVar(name), scrutinee.span.lo, scrutinee.span.hi)
      build_try_stmt(Some(binder), scrutinee, rest, cursor_span(saved).lo)
    None => made(saved, c, ELet(name, value, rest))

-- `let pat = value else fallback`: a two-arm match whose first arm binds the
-- rest of the block and whose wildcard arm is the fallback. The wildcard
-- carries the fallback's span so a pattern that cannot fail reports its dead
-- arm there.
fn build_let_else_stmt(
  pat : Sp(Pat),
  value : Sp(Expr),
  fallback : Sp(Expr),
  rest : Sp(Expr),
  lo : Int
) : Sp(Expr) =
  let wild = authored(PWild, fallback.span.lo, fallback.span.hi)
  let arms = [
      Arm { pat = pat, guard = None, body = rest },
      Arm { pat = wild, guard = None, body = fallback },
    ]
  synthesized(EMatch(value, arms), lo, lo)

-- The fallback and continuation of a `let`-`else` binding, entered with the
-- cursor just past the `else` keyword.
fn parse_let_else(
  saved : Cursor,
  pat : Sp(Pat),
  value : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = parse_expr_or_block(c, depth)
  let PTook(fallback, c1) = p1 else parsed_refused(p1)
  let p2 = take_kind(c1, TVSemi)
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_stmts(c2, depth)
  let PTook(rest, c3) = p3 else parsed_refused(p3)
  PTook(
      build_let_else_stmt(pat, value, fallback, rest, cursor_span(saved).lo),
      c3,
    )

-- The `with` family owns the remainder of its enclosing statement block.  A
-- present virtual semicolon introduces that remainder; without one, preserve
-- the authored statement as the `with` marker so desugaring can report the
-- single "nothing to wrap" diagnostic.
fn parse_with_rest(saved : Cursor, c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  if at_kind(c, TVSemi) then
    parse_stmts(cursor_advance(c), depth)
  else
    let s = cursor_since(saved, c)
    PTook(authored(EMarker("with"), s.lo, s.hi), c)

fn parse_with_stmt(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let c1 = cursor_advance(c)
  if at_kind(c1, TIdent) && fixed_at(c1, 1, "<-") then
    let p2 = take_word(c1, TIdent)
    let PTook(name, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "<-")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    if at_fixed(c3, "handler") then
      parse_named_with_handler(c, name, cursor_advance(c3), depth)
    else
      let p4 = parse_postfix(c3, depth)
      let PTook(call, c4) = p4 else parsed_refused(p4)
      finish_with_call(c, Some(name), call, c4, depth)
  elif at_fixed(c1, "handler") then
    parse_anonymous_with_handler(c, cursor_advance(c1), depth)
  else
    let p1 = parse_postfix(c1, depth)
    let PTook(call, c2) = p1 else parsed_refused(p1)
    finish_with_call(c, None, call, c2, depth)

fn finish_with_call(
  saved : Cursor,
  binder : Option(String),
  call : Sp(Expr),
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = parse_with_rest(saved, c, depth)
  let PTook(rest, c1) = p1 else parsed_refused(p1)
  let params =
    match binder of
      None => Nil
      Some(name) =>
        [
            Param {
              name = name,
              pat = None,
              ty = None,
              is_borrow = false,
              dflt = None
            },
          ]
  let lo = cursor_span(saved).lo
  let lam = synthesized(ELam(params, rest), lo, lo)
  let node =
    match call.node of
      ECall(head, args) => ECall(head, append(args, [lam]))
      _ => ECall(call, [lam])
  PTook(authored(node, lo, cursor_since(saved, c1).hi), c1)

fn parse_with_handler_arms(c : Cursor, depth : Int) : Parsed(List(HandlerArm)) =
  let p1 = parse_brace_open(c)
  let PTook(layout, c1) = p1 else parsed_refused(p1)
  let p2 = parse_handler_arms(c1, depth, layout, Nil)
  let PTook(arms, c2) = p2 else parsed_refused(p2)
  let p3 = take_brace_close(c2, layout)
  let PTook(_, c3) = p3 else parsed_refused(p3)
  PTook(arms, c3)

fn parse_named_with_handler(
  saved : Cursor,
  name : String,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = parse_with_handler_arms(c, depth)
  let PTook(arms, c1) = p1 else parsed_refused(p1)
  let p2 = parse_with_rest(saved, c1, depth)
  let PTook(rest, c2) = p2 else parsed_refused(p2)
  PTook(made(saved, c2, ENamedHandle(name, rest, arms)), c2)

fn parse_anonymous_with_handler(
  saved : Cursor,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Expr)) =
  let p1 = parse_with_handler_arms(c, depth)
  let PTook(arms, c1) = p1 else parsed_refused(p1)
  let p2 = parse_with_rest(saved, c1, depth)
  let PTook(rest, c2) = p2 else parsed_refused(p2)
  let lo = cursor_span(saved).lo
  PTook(synthesized(EHandle(rest, arms, false), lo, lo), c2)

-- lint: allow(L0101)
fn parse_let_stmt(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let c1 = cursor_advance(c)
  if at_kind(c1, TIdent) then
    let p2 = take_word(c1, TIdent)
    let PTook(name, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "=")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_expr_or_block(c3, depth)
    let PTook(value, c4) = p4 else parsed_refused(p4)
    let c5 =
      if at_fixed(c4, "in") then
        cursor_advance(c4)
      else
        c4
    let p6 = take_kind(c5, TVSemi)
    let PTook(_, c6) = p6 else parsed_refused(p6)
    let p7 = parse_stmts(c6, depth)
    let PTook(rest, c7) = p7 else parsed_refused(p7)
    PTook(finish_ident_let_stmt(saved, c7, name, value, rest), c7)
  else
    let p1 = parse_let_pattern(c1, depth)
    let PTook(pat, c2) = p1 else parsed_refused(p1)
    let p5 = take_fixed(c2, "=")
    let PTook(_, c3) = p5 else parsed_refused(p5)
    let p8 = parse_expr_or_block(c3, depth)
    let PTook(value, c4) = p8 else parsed_refused(p8)
    if at_fixed(c4, "else") then
      parse_let_else(saved, pat, value, cursor_advance(c4), depth)
    elif at_fixed(c4, "in") then
      let p9 = take_kind(cursor_advance(c4), TVSemi)
      let PTook(_, c6) = p9 else parsed_refused(p9)
      let p10 = parse_stmts(c6, depth)
      let PTook(rest, c7) = p10 else parsed_refused(p10)
      PTook(build_pattern_let_stmt(pat, value, rest, cursor_span(saved).lo), c7)
    else
      let p9 = take_kind(c4, TVSemi)
      let PTook(_, c6) = p9 else parsed_refused(p9)
      if at_fixed(c6, "else") then
        parse_let_else(saved, pat, value, cursor_advance(c6), depth)
      else
        let p10 = parse_stmts(c6, depth)
        let PTook(rest, c7) = p10 else parsed_refused(p10)
        PTook(
            build_pattern_let_stmt(pat, value, rest, cursor_span(saved).lo),
            c7,
          )

-- An optional `: Type` between a mutable binder and its `:=`. The annotation
-- describes the initializer rather than the binding, so it is returned here and
-- applied to the value.
fn parse_var_ann(c : Cursor, depth : Int) : Parsed(Option(Ty)) =
  if at_fixed(c, ":") then
    let p1 = parse_type(cursor_advance(c), depth)
    let PTook(ty, c1) = p1 else parsed_refused(p1)
    PTook(Some(ty), c1)
  else
    PTook(None, c)

fn parse_var_stmt(c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  let saved = c
  let p1 = take_word(cursor_advance(c), TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = parse_var_ann(c1, depth)
  let PTook(ann, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, ":=")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_expr(c3, depth)
  let PTook(value, c4) = p4 else parsed_refused(p4)
  finish_var_stmt(VarHead(saved, name, ann, value), c4, depth)

-- Everything a mutable declaration's head settled, carried to its tail as one
-- value: the cursor the statement opened at, the binder, the optional annotation
-- on the initializer, and the initializer itself.
type VarHead = VarHead(Cursor, String, Option(Ty), Sp(Expr))

-- The tail of a mutable declaration: the statement separator, the statements the
-- binder scopes over, and the declaration node itself. Split from the head so
-- that neither half carries the whole chain's nesting.
fn finish_var_stmt(head : VarHead, c : Cursor, depth : Int) : Parsed(Sp(Expr)) =
  match head of
    VarHead(saved, name, ann, value) =>
      let p1 = take_kind(c, TVSemi)
      let PTook(_, c1) = p1 else parsed_refused(p1)
      let p2 = parse_stmts(c1, depth)
      let PTook(rest, c2) = p2 else parsed_refused(p2)
      -- The annotation is a node the parser invents, and it stands for the whole
      -- statement, so it carries the declaration's own extent.
      let init =
        match ann of
          None => value
          Some(ty) => remade(saved, c2, EAnn(value, ty))
      PTook(made(saved, c2, EVarDecl(name, init, rest)), c2)
