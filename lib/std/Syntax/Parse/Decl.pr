-- | Whole-program and declaration parsing for the Prism-owned parser.
--
-- This module deliberately keeps declaration dispatch direct. Grammar families
-- that declarations contain live in their own modules; this file owns the
-- top-level layout block, visibility, imports, algebraic data declarations, and
-- function declarations. Additional declaration families extend the dispatch
-- without changing expression precedence or cursor mechanics.

import Data.Foldable (length)
import Data.List (..)
import Data.String (..)
import Syntax.Source (..)
import Syntax.Token (..)
import Syntax.Ast (..)
import Syntax.Cursor (..)
import Syntax.Parse.Support (..)
import Syntax.Parse.Type (..)
import Syntax.Parse.Pattern (..)
import Syntax.Parse.Expr (..)
import Syntax.Parse.DeclClass (..)
import Syntax.Parse.DeclStable (..)

-- A visibility prefix in the surface vocabulary.
type PVis = VPrivate | VPublic | VOpaque deriving (Eq)

type RetSpec = RetSpec { ret: Option(Ty), eff: Option(Row), no_alloc: Bool }

type FnSpec = FnSpec {
  ret: Option(Ty),
  eff: Option(Row),
  constraints: List(Constraint),
  reqs: List(Sp(Expr)),
  enss: List(Ensure),
  measure: Option(Sp(Expr)),
  no_alloc: Bool
}

fn vis_value(v : PVis) : Option(String) =
  match v of
    VPrivate => None
    VPublic => Some("pub")
    VOpaque => Some("opaque")

fn is_sep(c : Cursor) : Bool = at_kind(c, TVSemi) || at_fixed(c, ",")

fn skip_sep(c : Cursor) : Cursor =
  if is_sep(c) then
    cursor_advance(c)
  else
    c

fn at_close(c : Cursor, close : String) : Bool =
  if close == "v\}" then
    at_kind(c, TVClose)
  else
    at_fixed(c, close)

fn take_close(c : Cursor, close : String) : Parsed(Token) =
  if close == "v\}" then
    take_kind(c, TVClose)
  else
    take_fixed(c, close)

fn name_token(c : Cursor) : Parsed(String) =
  match cursor_kind(c) of
    Some(TIdent) => take_word(c, TIdent)
    Some(TUid) => take_word(c, TUid)
    Some(TQual) => take_word(c, TQual)
    _ => PStuck(cursor_note_name(c, "name"))

fn upper_name(c : Cursor) : Parsed(String) =
  match cursor_kind(c) of
    Some(TUid) => take_word(c, TUid)
    Some(TQual) => take_word(c, TQual)
    _ => PStuck(cursor_note_name(c, "uid"))

fn path_parts(s : String) : List(String) = split(char_at(".", 0), s)

fn parse_visibility(c : Cursor) : (PVis, Cursor) =
  if at_fixed(c, "pub") then
    (VPublic, cursor_advance(c))
  elif at_fixed(c, "opaque") then
    (VOpaque, cursor_advance(c))
  else
    (VPrivate, c)

-- -------------------------------------------------------------------------
-- Program and item sequence
-- -------------------------------------------------------------------------

-- | Parse the complete post-layout token stream as a whole source file.
pub fn parse_program(c : Cursor, depth : Int) : Parsed(List(Item)) =
  let p1 = descend(depth, c)
  let PTook(d, c1) = p1 else parsed_refused(p1)
  let p2 = take_kind(c1, TVOpen)
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_items(c2, d, Nil)
  let PTook(items, c3) = p3 else parsed_refused(p3)
  let p4 = take_kind(c3, TVClose)
  let PTook(_, c4) = p4 else parsed_refused(p4)
  match cursor_expect_end(c4) of
    Took(_, c5) => PTook(items, c5)
    Stuck(c5) => PStuck(c5)

fn parse_items(c : Cursor, depth : Int, rev : List(Item)) : Parsed(List(Item)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), c)
  elif at_kind(c, TVSemi) then
    parse_items(cursor_advance(c), depth, rev)
  else
    let p1 = parse_item(c, depth)
    let PTook(item, c1) = p1 else parsed_refused(p1)
    if c1.pos == c.pos then
      PFault(refuse(cursor_span(c), "declaration parser made no progress"))
    else
      parse_items(skip_sep(c1), depth, Cons(item, rev))

-- | Parse one top-level item, including its optional visibility prefix.
pub fn parse_item(c : Cursor, depth : Int) : Parsed(Item) =
  if at_kind(c, TIdent) && peek_word(c) == "deprecated" then
    parse_deprecated(c, depth)
  else
    let (vis, c1) = parse_visibility(c)
    let saved = c1
    if (vis == VPublic && at_kind(c1, TIdent) && peek_word(c1) == "deprecated") then
      parse_deprecated(c1, depth)
    elif at_fixed(c1, "import") then
      parse_import(saved, c1, vis)
    elif at_fixed(c1, "type") then
      parse_data(saved, c1, vis, false, depth)
    elif at_fixed(c1, "newtype") then
      parse_data(saved, c1, vis, true, depth)
    elif at_fixed(c1, "effect") then
      parse_effect_item(c1, depth, vis_value(vis))
    elif at_fixed(c1, "alias") then
      parse_alias_item(c1, depth, vis_value(vis))
    elif at_fixed(c1, "class") then
      parse_class_item(c1, depth, vis_value(vis))
    elif at_fixed(c1, "instance") then
      parse_instance_item(c1, depth, vis_value(vis))
    elif at_fixed(c1, "canonical") then
      parse_canonical_item(c1, depth, vis_value(vis))
    elif at_fixed(c1, "pattern") then
      parse_pattern_decl(c1, depth, vis_value(vis))
    elif at_fixed(c1, "stable") then
      parse_stable_decl(c1, depth, vis_value(vis))
    elif at_fixed(c1, "error") then
      parse_error_decl(saved, c1, vis, depth)
    elif at_fixed(c1, "let") then
      parse_const(saved, c1, vis, depth)
    elif at_fixed(c1, "logic") then
      parse_logic_fn(c1, vis, depth)
    elif (at_fixed(c1, "fn")
        || at_fixed(c1, "replayable")
        || at_fixed(c1, "fip")
        || at_fixed(c1, "fbip")
        || at_kind(c1, TIdent)) then
      parse_fn(saved, c1, vis, depth, "fn")
    else
      PStuck(cursor_note_name(c1, "declaration"))

fn parse_deprecated(c : Cursor, depth : Int) : Parsed(Item) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_word(c1, TStr)
  let PTook(msg, c2) = p2 else parsed_refused(p2)
  let p3 = take_kind(c2, TVSemi)
  let PTook(_, c3) = p3 else parsed_refused(p3)
  if at_kind(c3, TIdent) && peek_word(c3) == "deprecated" then
    PFault(
        refuse(
            cursor_since(saved, c2),
            "a `deprecated` annotation must be followed by a declaration",
          ),
      )
  else
    let p4 = parse_item(c3, depth)
    let PTook(item, c4) = p4 else parsed_refused(p4)
    match attach_deprecation(item, msg) of
      None =>
        PFault(
            refuse(
                cursor_since(saved, c2),
                "a `deprecated` annotation must precede a named declaration",
              ),
          )
      Some(tagged) => PTook(tagged, c4)

fn attach_deprecation(item : Item, msg : String) : Option(Item) =
  match item of
    IImport { .. } => None
    IInstance { .. } => None
    ICanonical { .. } => None
    IData {
      nt = nt,
      name = name,
      params = params,
      param_kinds = pks,
      ctors = ctors,
      derivs = derivs,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          IData {
            nt = nt,
            name = name,
            params = params,
            param_kinds = pks,
            ctors = ctors,
            derivs = derivs,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IEffect {
      name = name,
      params = params,
      ops = ops,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          IEffect {
            name = name,
            params = params,
            ops = ops,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IError { name = name, arg_types = args, span = span, vis = vis, dep = _ } =>
      Some(
          IError {
            name = name,
            arg_types = args,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IEffAlias { name = name, labels = labels, span = span, vis = vis, dep = _ } =>
      Some(
          IEffAlias {
            name = name,
            labels = labels,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    ISynonym {
      name = name,
      params = params,
      ty = ty,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          ISynonym {
            name = name,
            params = params,
            ty = ty,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IClass {
      name = name,
      param = param,
      supers = supers,
      methods = methods,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          IClass {
            name = name,
            param = param,
            supers = supers,
            methods = methods,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IPattern {
      name = name,
      params = params,
      forty = forty,
      viewfn = viewfn,
      makefn = makefn,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          IPattern {
            name = name,
            params = params,
            forty = forty,
            viewfn = viewfn,
            makefn = makefn,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IStable {
      name = name,
      rungs = rungs,
      converters = converters,
      migrations = migrations,
      span = span,
      vis = vis,
      dep = _,
    } =>
      Some(
          IStable {
            name = name,
            rungs = rungs,
            converters = converters,
            migrations = migrations,
            span = span,
            vis = vis,
            dep = Some(msg)
          },
        )
    IDecl { decl = decl, declkind = kind, vis = vis, dep = _ } =>
      Some(IDecl { decl = decl, declkind = kind, vis = vis, dep = Some(msg) })

-- -------------------------------------------------------------------------
-- Imports
-- -------------------------------------------------------------------------

fn parse_import(saved : Cursor, c : Cursor, vis : PVis) : Parsed(Item) =
  let p1 = take_fixed(c, "import")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = upper_name(c1)
  let PTook(path, c2) = p2 else parsed_refused(p2)
  let p3 = parse_import_alias(c2)
  let PTook(mod_alias, c3) = p3 else parsed_refused(p3)
  let p4 = parse_import_names(c3)
  let PTook(spec, c4) = p4 else parsed_refused(p4)
  match spec of
    (names, glob) =>
      PTook(
          IImport {
            path = path_parts(path),
            mod_alias = mod_alias,
            names = names,
            glob = glob,
            reexport = vis == VPublic,
            span = cursor_since(saved, c4)
          },
          c4,
        )

fn parse_import_alias(c : Cursor) : Parsed(Option(String)) =
  if at_fixed(c, "as") then
    let p1 = take_word(cursor_advance(c), TUid)
    let PTook(n, c1) = p1 else parsed_refused(p1)
    PTook(Some(n), c1)
  else
    PTook(None, c)

fn parse_import_names(c : Cursor) : Parsed((Option(List(String)), Bool)) =
  if not(at_fixed(c, "(")) then
    PTook((None, false), c)
  else
    let c1 = cursor_advance(c)
    if at_fixed(c1, "..") then
      let p2 = take_fixed(cursor_advance(c1), ")")
      let PTook(_, c2) = p2 else parsed_refused(p2)
      PTook((None, true), c2)
    else
      let p1 = parse_names_until(c1, ")", Nil)
      let PTook(ns, c2) = p1 else parsed_refused(p1)
      PTook((Some(ns), false), c2)

fn parse_names_until(
  c : Cursor,
  close : String,
  rev : List(String)
) : Parsed(List(String)) =
  if at_fixed(c, close) then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = name_token(c)
    let PTook(n, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_names_until(cursor_advance(c1), close, Cons(n, rev))
    elif at_fixed(c1, close) then
      PTook(reverse(Cons(n, rev)), cursor_advance(c1))
    else
      PStuck(cursor_note_name(c1, close))

-- -------------------------------------------------------------------------
-- Algebraic data and aliases
-- -------------------------------------------------------------------------

fn parse_data(
  saved : Cursor,
  c : Cursor,
  vis : PVis,
  is_newtype : Bool,
  depth : Int
) : Parsed(Item) =
  let c1 = cursor_advance(c)
  let p2 = take_word(c1, TUid)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = parse_type_params(c2)
  let PTook(tp, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "=")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_ctors(c4, depth, Nil)
  let PTook(ctor_spec, c5) = p5 else parsed_refused(p5)
  match ctor_spec of
    (ctors, opened) =>
      let p6 = parse_deriving(c5, Nil)
      let PTook(derivs, c6) = p6 else parsed_refused(p6)
      let c7 =
        if opened && at_kind(c6, TVClose) then
          cursor_advance(c6)
        else
          c6
      match tp of
        (params, kinds) =>
          if is_newtype && not(newtype_shape(ctors)) then
            PFault(
                refuse(
                    cursor_since(saved, c7),
                    "a newtype must have exactly one constructor with one field",
                  ),
              )
          else
            PTook(
                IData {
                  nt = is_newtype,
                  name = name,
                  params = params,
                  param_kinds = if is_newtype then Nil else kinds,
                  ctors = ctors,
                  derivs = derivs,
                  span = cursor_since(saved, c7),
                  vis = vis_value(vis),
                  dep = None
                },
                c7,
              )

fn newtype_shape(ctors : List(Ctor)) : Bool =
  match ctors of
    Cons(c, Nil) =>
      match c.shape of
        CPositional(Cons(_, Nil)) => true
        CRecord(Cons(_, Nil)) => true
        _ => false
    _ => false

fn parse_type_params(c : Cursor) : Parsed((List(String), List(Kind))) =
  if not(at_fixed(c, "(")) then
    PTook((Nil, Nil), c)
  else
    parse_type_params_go(cursor_advance(c), Nil, Nil)

fn parse_type_params_go(
  c : Cursor,
  names : List(String),
  kinds : List(Kind)
) : Parsed((List(String), List(Kind))) =
  if at_fixed(c, ")") then
    PTook((reverse(names), reverse(kinds)), cursor_advance(c))
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = parse_kind_ann(c1)
    let PTook(kind, c2) = p2 else parsed_refused(p2)
    if at_fixed(c2, ",") then
      parse_type_params_go(
          cursor_advance(c2),
          Cons(name, names),
          Cons(kind, kinds),
        )
    elif at_fixed(c2, ")") then
      PTook(
          (reverse(Cons(name, names)), reverse(Cons(kind, kinds))),
          cursor_advance(c2),
        )
    else
      PStuck(cursor_note_name(c2, ")"))

fn parse_kind_ann(c : Cursor) : Parsed(Kind) =
  if not(at_fixed(c, ":")) then
    PTook(KType, c)
  else
    let p1 = take_word(cursor_advance(c), TUid)
    let PTook(k, c1) = p1 else parsed_refused(p1)
    if k == "Type" then
      PTook(KType, c1)
    elif k == "Row" then
      PTook(KRow, c1)
    elif k == "Nat" then
      PTook(KNat, c1)
    else
      PFault(refuse(cursor_since(c, c1), "unknown kind `{k}`"))

fn parse_ctors(
  c : Cursor,
  depth : Int,
  rev : List(Ctor)
) : Parsed((List(Ctor), Bool)) =
  let opened = at_kind(c, TVOpen)
  let c1 =
    if opened then
      cursor_advance(c)
    else
      c
  let p2 = parse_ctors_go(c1, depth, rev, opened)
  let PTook(ctors, c2) = p2 else parsed_refused(p2)
  PTook((ctors, opened), c2)

fn parse_ctors_go(
  c : Cursor,
  depth : Int,
  rev : List(Ctor),
  virtual : Bool
) : Parsed(List(Ctor)) =
  let after_sep =
    if at_kind(c, TVSemi) then
      cursor_advance(c)
    else
      c
  let c0 =
    if at_fixed(after_sep, "|") then
      cursor_advance(after_sep)
    else
      after_sep
  if virtual && at_kind(c0, TVClose) then
    PTook(reverse(rev), cursor_advance(c0))
  elif virtual && at_fixed(c0, "deriving") then
    PTook(reverse(rev), c0)
  elif not(virtual) && not(at_kind(c0, TUid)) then
    PTook(reverse(rev), c0)
  else
    let p1 = parse_ctor(c0, depth)
    let PTook(ctor, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, "|") || at_kind(c1, TVSemi) then
      parse_ctors_go(c1, depth, Cons(ctor, rev), virtual)
    elif virtual && at_kind(c1, TVClose) then
      PTook(reverse(Cons(ctor, rev)), cursor_advance(c1))
    else
      PTook(reverse(Cons(ctor, rev)), c1)

fn parse_ctor(c : Cursor, depth : Int) : Parsed(Ctor) =
  let p1 = take_word(c, TUid)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, "\{") then
    let p2 = parse_ctor_fields(cursor_advance(c1), depth, Nil)
    let PTook(fs, c2) = p2 else parsed_refused(p2)
    PTook(Ctor { name = name, shape = CRecord(fs) }, c2)
  elif at_fixed(c1, "(") then
    let p3 = parse_types_until(cursor_advance(c1), ")", depth, Nil)
    let PTook(ts, c2) = p3 else parsed_refused(p3)
    PTook(Ctor { name = name, shape = CPositional(ts) }, c2)
  else
    PTook(Ctor { name = name, shape = CPositional(Nil) }, c1)

fn parse_ctor_fields(
  c : Cursor,
  depth : Int,
  rev : List(CField)
) : Parsed(List(CField)) =
  if at_fixed(c, "\}") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, ":")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_type(c2, depth)
    let PTook(ty, c3) = p3 else parsed_refused(p3)
    let field = CField { name = name, ty = ty }
    if at_fixed(c3, ",") then
      parse_ctor_fields(cursor_advance(c3), depth, Cons(field, rev))
    elif at_fixed(c3, "\}") then
      PTook(reverse(Cons(field, rev)), cursor_advance(c3))
    else
      let c4 = cursor_note(c3, TFixed(","))
      PStuck(cursor_note(c4, TFixed("\}")))

fn parse_types_until(
  c : Cursor,
  close : String,
  depth : Int,
  rev : List(Ty)
) : Parsed(List(Ty)) =
  if at_fixed(c, close) then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = parse_type_arg(c, depth)
    let PTook(ty, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_types_until(cursor_advance(c1), close, depth, Cons(ty, rev))
    elif at_fixed(c1, close) then
      PTook(reverse(Cons(ty, rev)), cursor_advance(c1))
    else
      let c2 = cursor_note(c1, TFixed(","))
      PStuck(cursor_note(c2, TFixed(close)))

fn parse_deriving(c : Cursor, rev : List(Deriving)) : Parsed(List(Deriving)) =
  if not(at_fixed(c, "deriving")) then
    PTook(reverse(rev), c)
  else
    let p1 = take_fixed(cursor_advance(c), "(")
    let PTook(_, c1) = p1 else parsed_refused(p1)
    parse_deriving_go(c1, Nil)

fn parse_deriving_go(
  c : Cursor,
  rev : List(Deriving)
) : Parsed(List(Deriving)) =
  if at_fixed(c, ")") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let start = c
    let p1 = take_word(c, TUid)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let d = Deriving { name = name, span = cursor_since(start, c1) }
    if at_fixed(c1, ",") then
      parse_deriving_go(cursor_advance(c1), Cons(d, rev))
    elif at_fixed(c1, ")") then
      PTook(reverse(Cons(d, rev)), cursor_advance(c1))
    else
      PStuck(cursor_note_name(c1, ")"))

fn parse_error_decl(
  saved : Cursor,
  c : Cursor,
  vis : PVis,
  depth : Int
) : Parsed(Item) =
  let p1 = take_word(cursor_advance(c), TUid)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, "(") then
    let p2 = parse_types_until(cursor_advance(c1), ")", depth, Nil)
    let PTook(ts, c2) = p2 else parsed_refused(p2)
    PTook(
        IError {
          name = name,
          arg_types = ts,
          span = cursor_since(saved, c2),
          vis = vis_value(vis),
          dep = None
        },
        c2,
      )
  else
    PTook(
        IError {
          name = name,
          arg_types = Nil,
          span = cursor_since(saved, c1),
          vis = vis_value(vis),
          dep = None
        },
        c1,
      )

-- -------------------------------------------------------------------------
-- Function and constant declarations
-- -------------------------------------------------------------------------

fn parse_logic_fn(c : Cursor, vis : PVis, depth : Int) : Parsed(Item) =
  parse_fn(cursor_advance(c), cursor_advance(c), vis, depth, "logic-fn")

fn parse_fn(
  saved : Cursor,
  c : Cursor,
  vis : PVis,
  depth : Int,
  kind : String
) : Parsed(Item) =
  let p1 = parse_fn_mods(c)
  let PTook(mods, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "fn")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = take_word(c2, TIdent)
  let PTook(name, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "(")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_params(c4, depth, 0, Nil)
  let PTook(params, c5) = p5 else parsed_refused(p5)
  let p6 = parse_fn_spec(c5, depth)
  let PTook(spec, c6) = p6 else parsed_refused(p6)
  let p7 = take_fixed(c6, "=")
  let PTook(_, c7) = p7 else parsed_refused(p7)
  let p8 = parse_expr_or_block(c7, depth)
  let PTook(body, c8) = p8 else parsed_refused(p8)
  let p9 = parse_where_block(c8, depth)
  let PTook(wheres, c9) = p9 else parsed_refused(p9)
  match mods of
    (is_test, totality, fip_mode, is_replayable) =>
      let decl =
        Decl {
          name = name,
          params = params,
          ret = spec.ret,
          eff = spec.eff,
          constraints = spec.constraints,
          body = body,
          wheres = wheres,
          reqs = spec.reqs,
          enss = spec.enss,
          measure = spec.measure,
          is_test = is_test,
          totality = totality,
          fip_word = fip_mode,
          is_replayable = is_replayable,
          is_no_alloc = spec.no_alloc,
          span = cursor_since(saved, c9)
        }
      PTook(
          IDecl {
            decl = decl,
            declkind = kind,
            vis = vis_value(vis),
            dep = None
          },
          c9,
        )

fn parse_fn_spec(c : Cursor, depth : Int) : Parsed(FnSpec) =
  let p1 = parse_ret_spec(c, depth)
  let PTook(ret, c1) = p1 else parsed_refused(p1)
  let p2 = parse_given(c1, depth)
  let PTook(constraints, c2) = p2 else parsed_refused(p2)
  let p3 = parse_requires(c2, depth, Nil)
  let PTook(reqs, c3) = p3 else parsed_refused(p3)
  let p4 = parse_ensures(c3, depth, Nil)
  let PTook(enss, c4) = p4 else parsed_refused(p4)
  let p5 = parse_decreases(c4, depth)
  let PTook(measure, c5) = p5 else parsed_refused(p5)
  PTook(
      FnSpec {
        ret = ret.ret,
        eff = ret.eff,
        constraints = constraints,
        reqs = reqs,
        enss = enss,
        measure = measure,
        no_alloc = ret.no_alloc
      },
      c5,
    )

fn parse_ret_spec(c : Cursor, depth : Int) : Parsed(RetSpec) =
  if not(at_fixed(c, ":")) then
    PTook(RetSpec { ret = None, eff = None, no_alloc = false }, c)
  else
    let after_colon = cursor_advance(c)
    if at_fixed(after_colon, "!") then
      parse_retired_ret_spec(c, after_colon, depth)
    else
      match parse_type_head(after_colon, depth) of
        PFault(d) => PFault(d)
        PStuck(c1) =>
          -- RetAnn also has the two retired `: ! ...` productions. Their
          -- leading bang is part of this entry-state expectation union.
          if c1.pos == after_colon.pos then
            PStuck(cursor_note(c1, TFixed("!")))
          else
            PStuck(c1)
        PTook(raw, c1) =>
          if at_fixed(c1, "!") then
            let p2 = parse_effect_row(c1, depth)
            let PTook(row, c2) = p2 else parsed_refused(p2)
            match attach_return_effect(raw, row) of
              Some(with_eff) =>
                match lift_noalloc(with_eff) of
                  (ret, no_alloc) =>
                    PTook(
                        RetSpec {
                          ret = Some(ret),
                          eff = None,
                          no_alloc = no_alloc
                        },
                        c2,
                      )
              None =>
                match lift_noalloc(raw) of
                  (ret, no_alloc) =>
                    PTook(
                        RetSpec {
                          ret = Some(ret),
                          eff = Some(row),
                          no_alloc = no_alloc
                        },
                        c2,
                      )
          else
            match lift_noalloc(raw) of
              (ret, no_alloc) =>
                PTook(
                    RetSpec {
                      ret = Some(ret),
                      eff = None,
                      no_alloc = no_alloc
                    },
                    c1,
                  )

fn parse_retired_ret_spec(
  start : Cursor,
  bang : Cursor,
  depth : Int
) : Parsed(RetSpec) =
  let braced = at_fixed(cursor_advance(bang), "\{")
  let p1 = parse_effect_row(bang, depth)
  let PTook(_, c1) = p1 else parsed_refused(p1)
  match parse_type(c1, depth) of
    PFault(d) => PFault(d)
    PStuck(c2) =>
      if not(braced) && c2.pos == c1.pos then
        PStuck(cursor_note(c2, TFixed("\{")))
      else
        PStuck(c2)
    PTook(_, c2) =>
      PFault(
          refuse(
              cursor_since(start, c2),
              "the effect row now follows the result type: write `: Result ! \{Effects\}` instead of `: !\{Effects\} Result`",
            ),
        )

fn lift_noalloc(t : Ty) : (Ty, Bool) =
  match t of
    TyUsage(inner, facts) =>
      match facts of
        Cons(f, Nil) =>
          if f == "noalloc" then
            (inner, true)
          else
            (TyUsage(inner, facts), false)
        _ => (TyUsage(inner, facts), false)
    _ => (t, false)

-- Attach a suffix to a returned closure, including through an outer forall.
-- `None` means the parsed result was a value type and the row belongs to the
-- declaration itself.
fn attach_return_effect(t : Ty, row : Row) : Option(Ty) =
  match t of
    TyFun(params, _, cod) => Some(TyFun(params, row, cod))
    TyForall(vars, body) =>
      match attach_return_effect(body, row) of
        Some(inner) => Some(TyForall(vars, inner))
        None => None
    _ => None

fn parse_given(c : Cursor, depth : Int) : Parsed(List(Constraint)) =
  if not(at_fixed(c, "given")) then
    PTook(Nil, c)
  else
    parse_constraints(cursor_advance(c), depth, Nil)

fn parse_constraints(
  c : Cursor,
  depth : Int,
  rev : List(Constraint)
) : Parsed(List(Constraint)) =
  let saved = c
  let p1 = take_word(c, TUid)
  let PTook(cls, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "(")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_type(c2, depth)
  let PTook(ty, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, ")")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let con = Constraint { cls = cls, ty = ty, span = cursor_since(saved, c4) }
  if at_fixed(c4, ",") then
    parse_constraints(cursor_advance(c4), depth, Cons(con, rev))
  else
    PTook(reverse(Cons(con, rev)), c4)

fn parse_requires(
  c : Cursor,
  depth : Int,
  rev : List(Sp(Expr))
) : Parsed(List(Sp(Expr))) =
  if not(at_fixed(c, "requires")) then
    PTook(reverse(rev), c)
  else
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    parse_requires(c1, depth, Cons(e, rev))

fn parse_ensures(
  c : Cursor,
  depth : Int,
  rev : List(Ensure)
) : Parsed(List(Ensure)) =
  if not(at_fixed(c, "ensures")) then
    PTook(reverse(rev), c)
  else
    let p1 = take_fixed(cursor_advance(c), "|")
    let PTook(_, c1) = p1 else parsed_refused(p1)
    let p2 = take_word(c1, TIdent)
    let PTook(binder, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "|")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_expr(c3, depth)
    let PTook(e, c4) = p4 else parsed_refused(p4)
    parse_ensures(c4, depth, Cons(Ensure { binder = binder, expr = e }, rev))

fn parse_decreases(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if peek_word(c) /= "decreases" then
    PTook(None, c)
  else
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    PTook(Some(e), c1)

fn parse_where_block(c : Cursor, depth : Int) : Parsed(List(NamedExpr)) =
  if not(at_fixed(c, "where")) then
    PTook(Nil, c)
  else
    let p1 = take_kind(cursor_advance(c), TVOpen)
    let PTook(_, c1) = p1 else parsed_refused(p1)
    parse_where_bindings(c1, depth, Nil)

fn parse_where_bindings(
  c : Cursor,
  depth : Int,
  rev : List(NamedExpr)
) : Parsed(List(NamedExpr)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), cursor_advance(c))
  elif at_kind(c, TVSemi) then
    parse_where_bindings(cursor_advance(c), depth, rev)
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "=")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_expr_or_block(c2, depth)
    let PTook(value, c3) = p3 else parsed_refused(p3)
    parse_where_bindings(
        c3,
        depth,
        Cons(NamedExpr { name = name, value = value }, rev),
      )

fn parse_fn_mods(c : Cursor) : Parsed((Bool, Option(String), Option(String), Bool)) =
  let (words, c1, remaining) = take_fn_mod_words(c, 3, Nil)
  if fn_mod_follow(c1) then
    match classify_fn_mod_words(words) of
      None =>
        let written = str_join(" ", words)
        PFault(
            refuse(
                cursor_since(c, c1),
                concat(
                    "`",
                    concat(
                        written,
                        "` is not a declaration modifier; expected `test`, `total`, or `assume total` before `fn`",
                      ),
                  ),
              ),
          )
      Some((is_test, totality)) => parse_reserved_fn_mods(c1, is_test, totality)
  else
    -- DeclMods reduces, and runs its deliberate validation, only when its
    -- lookahead is a reserved modifier or `fn`. A fourth identifier or a
    -- layout boundary is instead a generic miss at that lookahead.
    PStuck(note_fn_mod_follow(c1, remaining > 0, remaining == 2))

fn take_fn_mod_words(
  c : Cursor,
  remaining : Int,
  rev : List(String)
) : (List(String), Cursor, Int) =
  if remaining > 0 && at_kind(c, TIdent) then
    take_fn_mod_words(cursor_advance(c), remaining - 1, Cons(peek_word(c), rev))
  else
    (reverse(rev), c, remaining)

fn fn_mod_follow(c : Cursor) : Bool =
  at_fixed(c, "replayable")
    || at_fixed(c, "fip")
    || at_fixed(c, "fbip")
    || at_fixed(c, "fn")

fn note_fn_mod_follow(
  c : Cursor,
  allow_ident : Bool,
  allow_deprecation_string : Bool
) : Cursor =
  let c1 =
    if allow_ident then
      cursor_note(c, TIdent)
    else
      c
  let c2 =
    if allow_deprecation_string then
      cursor_note(c1, TStr)
    else
      c1
  let c3 = cursor_note(c2, TFixed("replayable"))
  let c4 = cursor_note(c3, TFixed("fip"))
  let c5 = cursor_note(c4, TFixed("fbip"))
  cursor_note(c5, TFixed("fn"))

fn classify_fn_mod_words(words : List(String)) : Option((Bool, Option(String))) =
  match words of
    Nil => Some((false, None))
    Cons(a, Nil) =>
      if a == "test" then
        Some((true, None))
      elif a == "total" then
        Some((false, Some("prove")))
      else
        None
    Cons(a, Cons(b, Nil)) =>
      if a == "test" && b == "total" then
        Some((true, Some("prove")))
      elif a == "assume" && b == "total" then
        Some((false, Some("assume")))
      else
        None
    Cons(a, Cons(b, Cons(c, Nil))) =>
      if a == "test" && b == "assume" && c == "total" then
        Some((true, Some("assume")))
      else
        None
    _ => None

fn parse_reserved_fn_mods(
  c : Cursor,
  is_test : Bool,
  totality : Option(String)
) : Parsed((Bool, Option(String), Option(String), Bool)) =
  if at_fixed(c, "replayable") then
    let c1 = cursor_advance(c)
    if at_fixed(c1, "fip") || at_fixed(c1, "fbip") then
      let mode =
        if at_fixed(c1, "fip") then
          "fip"
        else
          "fbip"
      let c2 = cursor_advance(c1)
      if at_fixed(c2, "fn") then
        PTook((is_test, totality, Some(mode), true), c2)
      else
        PStuck(cursor_note(c2, TFixed("fn")))
    elif at_fixed(c1, "fn") then
      PTook((is_test, totality, None, true), c1)
    else
      let c2 = cursor_note(c1, TFixed("fip"))
      let c3 = cursor_note(c2, TFixed("fbip"))
      PStuck(cursor_note(c3, TFixed("fn")))
  elif at_fixed(c, "fip") || at_fixed(c, "fbip") then
    let mode =
      if at_fixed(c, "fip") then
        "fip"
      else
        "fbip"
    let c1 = cursor_advance(c)
    if at_fixed(c1, "fn") then
      PTook((is_test, totality, Some(mode), false), c1)
    else
      PStuck(cursor_note(c1, TFixed("fn")))
  else
    PTook((is_test, totality, None, false), c)

fn parse_params(
  c : Cursor,
  depth : Int,
  index : Int,
  rev : List(Param)
) : Parsed(List(Param)) =
  if at_fixed(c, ")") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let borrowed = at_fixed(c, "borrow")
    let c0 =
      if borrowed then
        cursor_advance(c)
      else
        c
    match parse_pattern(c0, depth) of
      PFault(d) => PFault(d)
      PStuck(c1) =>
        -- At the parameter's first token the closing paren and the borrow
        -- marker are live alternatives beside a pattern start; once anything
        -- of the pattern has been consumed, its own expectations stand alone.
        if c1.pos == c.pos then
          PStuck(cursor_note(cursor_note(c1, TFixed(")")), TFixed("borrow")))
        else
          PStuck(c1)
      PTook(pat, c1) =>
        let p2 = parse_param_type(c1, depth)
        let PTook(ty, c2) = p2 else parsed_refused(p2)
        let had_default = at_fixed(c2, ":=")
        let p3 = parse_param_default(c2, depth)
        let PTook(dflt, c3) = p3 else parsed_refused(p3)
        let param =
          match pat.node of
            PVar(n) =>
              Param {
                name = n,
                pat = None,
                ty = ty,
                is_borrow = borrowed,
                dflt = dflt
              }
            PWild =>
              Param {
                name = "_",
                pat = None,
                ty = ty,
                is_borrow = borrowed,
                dflt = dflt
              }
            _ =>
              Param {
                name = "arg@{index}",
                pat = Some(pat),
                ty = ty,
                is_borrow = borrowed,
                dflt = dflt
              }
        if at_fixed(c3, ",") then
          parse_params(cursor_advance(c3), depth, index + 1, Cons(param, rev))
        elif at_fixed(c3, ")") then
          PTook(reverse(Cons(param, rev)), cursor_advance(c3))
        else
          -- Param has reduced at this exact position. The enclosing
          -- comma list and the optional default are all still live.
          let c4 = cursor_note(c3, TFixed(","))
          let c5 =
            if had_default then
              c4
            else
              cursor_note(c4, TFixed(":="))
          PStuck(cursor_note(c5, TFixed(")")))

fn parse_param_type(c : Cursor, depth : Int) : Parsed(Option(Ty)) =
  if at_fixed(c, ":") then
    let p1 = parse_type(cursor_advance(c), depth)
    let PTook(t, c1) = p1 else parsed_refused(p1)
    PTook(Some(t), c1)
  else
    PTook(None, c)

fn parse_param_default(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if at_fixed(c, ":=") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    PTook(Some(e), c1)
  else
    PTook(None, c)

fn parse_ret(c : Cursor, depth : Int) : Parsed(Option(Ty)) =
  if at_fixed(c, ":") then
    let p1 = parse_type(cursor_advance(c), depth)
    let PTook(t, c1) = p1 else parsed_refused(p1)
    PTook(Some(t), c1)
  else
    PTook(None, c)

fn parse_const(
  saved : Cursor,
  c : Cursor,
  vis : PVis,
  depth : Int
) : Parsed(Item) =
  let p1 = take_word(cursor_advance(c), TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = parse_ret(c1, depth)
  let PTook(ret, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "=")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_expr_or_block(c3, depth)
  let PTook(body, c4) = p4 else parsed_refused(p4)
  let decl =
    Decl {
      name = name,
      params = Nil,
      ret = ret,
      eff = None,
      constraints = Nil,
      body = body,
      wheres = Nil,
      reqs = Nil,
      enss = Nil,
      measure = None,
      is_test = false,
      totality = None,
      fip_word = None,
      is_replayable = false,
      is_no_alloc = false,
      span = cursor_since(saved, c4)
    }
  PTook(
      IDecl {
        decl = decl,
        declkind = "const",
        vis = vis_value(vis),
        dep = None
      },
      c4,
    )
