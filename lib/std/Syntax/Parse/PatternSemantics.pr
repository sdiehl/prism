-- | Pure Pattern action lowerings used by the generated structural parser.

import Data.List (..)
import Data.String (ends_with)
import Syntax.Source (..)
import Syntax.Ast (..)
import Syntax.Parse.Build (..)
import Syntax.Parse.Support (surface_float, surface_int)

-- The byte length of an integer literal's width suffix, `i64` or `u64`.
fn pattern_suffix_len() : Int = 3

-- | Lower an integer literal pattern, splitting off its width suffix and
-- folding a leading minus into the digits.
pub fn pattern_int(raw : String, negative : Bool, span : Span) : Sp(Pat) =
  let n = str_len(raw)
  let (digits, suffix) =
    if ends_with("i64", raw) then
      (substring(raw, 0, n - pattern_suffix_len()), SufI64)
    elif ends_with("u64", raw) then
      (substring(raw, 0, n - pattern_suffix_len()), SufU64)
    else
      (raw, SufNone)
  let value = surface_int(digits)
  authored(
      PInt(if negative then concat("-", value) else value, suffix),
      span.lo,
      span.hi,
    )

-- | Lower a float literal pattern, folding a leading minus into the value.
pub fn pattern_float(raw : String, negative : Bool, span : Span) : Sp(Pat) =
  let value = surface_float(raw)
  authored(
      PFloat(if negative then concat("-", value) else value),
      span.lo,
      span.hi,
    )

-- | Lower a list literal pattern to the `Cons`/`Nil` spine it abbreviates.
pub fn pattern_list(items : List(Sp(Pat)), outer : Span) : Sp(Pat) =
  widened(
      pattern_list_tail(items, zero_width(PCtor("Nil", Nil), outer.hi)),
      outer.lo,
      outer.hi,
    )

fn pattern_list_tail(items : List(Sp(Pat)), rest : Sp(Pat)) : Sp(Pat) =
  match items of
    Nil => rest
    Cons(head, tail) =>
      authored(
          PCtor("Cons", [head, pattern_list_tail(tail, rest)]),
          head.span.lo,
          head.span.hi,
        )
