-- | Pattern-synonym and stable-family declarations.
--
-- These two declaration families carry more parse-time validation than the
-- ordinary top-level forms. Keeping them together and out of the declaration
-- dispatcher makes that validation visible without turning `Syntax.Parse.Decl`
-- into a second grammar file.
--
-- The public functions start at the declaration keyword and return a complete
-- `Item`. They are intentionally shaped for direct dispatch from
-- `Syntax.Parse.Decl`: the caller supplies the remaining depth budget and the
-- already-decoded visibility.

import Data.Foldable (length)
import Data.List (..)
import Syntax.Source (..)
import Syntax.Token (..)
import Syntax.Ast (..)
import Syntax.Cursor (..)
import Syntax.Diagnostic (..)
import Syntax.Parse.Support (..)
import Syntax.Parse.Type (..)
import Syntax.Parse.Expr (..)

-- A parsed pattern-declaration clause before its family-level invariants have
-- been checked.
type PatternClause = PatternClause { word: String, expr: Sp(Expr), span: Span }

-- The three surface forms admitted in a stable block share one comma-separated
-- sequence, but have different ordering rules after parsing.
type StableEntry
  = SERung(Rung)
  | SEConverter(Converter)
  | SEMigrations(List(Migration))

type StableParts = StableParts {
  rungs: List(Rung),
  converters: List(Converter),
  migrations: List(Migration),
  has_migrations: Bool,
  saw_body: Bool
}

type Checked(a) = CheckBad(Diagnostic) | CheckOk(a)

-- -------------------------------------------------------------------------
-- Pattern declarations
-- -------------------------------------------------------------------------

-- | Parse a complete `pattern` declaration.
--
-- The clause assembler enforces the surface contract at parse time: one
-- one-argument `view`, at most one `make`, and a `make` arity equal to the
-- pattern parameter count. A bare name is admitted for `view` because it may
-- name a class-dispatched view method; every other clause body must be a
-- lambda.
pub fn parse_pattern_decl(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let p1 = descend(depth, c)
  let PTook(d, c1) = p1 else parsed_refused(p1)
  parse_pattern_decl_body(c1, d, vis)

-- lint: allow(L0101)
fn parse_pattern_decl_body(
  saved : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let p1 = take_fixed(saved, "pattern")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_word(c1, TUid)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "(")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_ident_list(c3, ")", Nil)
  let PTook(params, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "for")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = take_word(c5, TUid)
  let PTook(for_ty, c6) = p6 else parsed_refused(p6)
  let p7 = take_fixed(c6, "=")
  let PTook(_, c7) = p7 else parsed_refused(p7)
  let p8 = parse_pattern_clauses(c7, depth)
  let PTook(clauses, c8) = p8 else parsed_refused(p8)
  assemble_pattern(saved, c8, name, params, for_ty, clauses, vis)

-- A conventional comma list with an optional trailing comma. The closing
-- delimiter is consumed here.
-- lint: allow(L0105)
fn parse_ident_list(
  c : Cursor,
  close : String,
  rev : List(String)
) : Parsed(List(String)) =
  if at_fixed(c, close) then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = take_word(c, TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_ident_list(cursor_advance(c1), close, Cons(name, rev))
    elif at_fixed(c1, close) then
      PTook(reverse(Cons(name, rev)), cursor_advance(c1))
    else
      PStuck(note_comma_or(c1, close))

fn parse_pattern_clauses(
  c : Cursor,
  depth : Int
) : Parsed(List(PatternClause)) =
  if at_kind(c, TVOpen) then
    parse_pattern_clause_block(cursor_advance(c), depth, Nil)
  else
    let p1 = parse_pattern_clause(c, depth)
    let PTook(clause, c1) = p1 else parsed_refused(p1)
    PTook([clause], c1)

-- lint: allow(L0105)
fn parse_pattern_clause_block(
  c : Cursor,
  depth : Int,
  rev : List(PatternClause)
) : Parsed(List(PatternClause)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), cursor_advance(c))
  elif at_kind(c, TVSemi) then
    parse_pattern_clause_block(cursor_advance(c), depth, rev)
  else
    let p1 = parse_pattern_clause(c, depth)
    let PTook(clause, c1) = p1 else parsed_refused(p1)
    if at_kind(c1, TVSemi) then
      parse_pattern_clause_block(cursor_advance(c1), depth, Cons(clause, rev))
    elif at_kind(c1, TVClose) then
      parse_pattern_clause_block(c1, depth, Cons(clause, rev))
    else
      let c2 = cursor_note(c1, TVSemi)
      PStuck(cursor_note(c2, TVClose))

fn parse_pattern_clause(c : Cursor, depth : Int) : Parsed(PatternClause) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(word, c1) = p1 else parsed_refused(p1)
  let p2 = parse_expr(c1, depth)
  let PTook(expr, c2) = p2 else parsed_refused(p2)
  if word /= "view" && word /= "make" then
    PFault(
        refuse(
            cursor_since(saved, c2),
            "expected `view` or `make` in pattern declaration",
          ),
      )
  else
    PTook(
        PatternClause {
          word = word,
          expr = expr,
          span = cursor_since(saved, c2)
        },
        c2,
      )

-- lint: allow(L0103)
fn assemble_pattern(
  saved : Cursor,
  c : Cursor,
  name : String,
  params : List(String),
  for_ty : String,
  clauses : List(PatternClause),
  vis : Option(String)
) : Parsed(Item) =
  match (collect_pattern_clauses(name, length(params), clauses, None, None)) of
    CheckBad(d) => PFault(d)
    CheckOk(parts) =>
      match parts of
        (None, _) =>
          PFault(
              refuse(
                  cursor_since(saved, c),
                  "pattern `{name}` needs a `view` clause",
                ),
            )
        (Some(viewfn), makefn) =>
          PTook(
              IPattern {
                name = name,
                params = params,
                forty = for_ty,
                viewfn = viewfn,
                makefn = makefn,
                span = cursor_since(saved, c),
                vis = vis,
                dep = None
              },
              c,
            )

fn collect_pattern_clauses(
  pattern_name : String,
  make_arity : Int,
  clauses : List(PatternClause),
  viewfn : Option(Sp(Expr)),
  makefn : Option(Sp(Expr))
) : Checked((Option(Sp(Expr)), Option(Sp(Expr)))) =
  match clauses of
    Nil => CheckOk((viewfn, makefn))
    Cons(clause, rest) =>
      let want =
        if clause.word == "view" then
          1
        else
          make_arity
      match clause_arity(clause.word, clause.expr) of
        None =>
          CheckBad(
              refuse(clause.span, "`{clause.word}` clause must be a lambda"),
            )
        Some(got) =>
          if got /= want then
            CheckBad(
                refuse(
                    clause.span,
                    "`{clause.word}` for pattern `{pattern_name}` must take {want} argument(s), this lambda takes {got}",
                  ),
              )
          elif clause.word == "view" then
            match viewfn of
              Some(_) =>
                CheckBad(
                    refuse(
                        clause.span,
                        "duplicate `view` clause in pattern `{pattern_name}`",
                      ),
                  )
              None =>
                collect_pattern_clauses(
                    pattern_name,
                    make_arity,
                    rest,
                    Some(clause.expr),
                    makefn,
                  )
          else
            match makefn of
              Some(_) =>
                CheckBad(
                    refuse(
                        clause.span,
                        "duplicate `make` clause in pattern `{pattern_name}`",
                      ),
                  )
              None =>
                collect_pattern_clauses(
                    pattern_name,
                    make_arity,
                    rest,
                    viewfn,
                    Some(clause.expr),
                  )

-- A view may be a class method name. Makes and all other view expressions
-- remain lambdas, matching the authoritative parse-time normalization.
fn clause_arity(word : String, e : Sp(Expr)) : Option(Int) =
  match e.node of
    ELam(params, _) => Some(length(params))
    EVar(_) =>
      if word == "view" then
        Some(1)
      else
        None
    _ => None

-- -------------------------------------------------------------------------
-- Stable declarations
-- -------------------------------------------------------------------------

-- | Parse a complete `stable` declaration, including rungs, converters, and
-- an optional migrations table.
--
-- Stable entries are parsed in their authored order. The assembler rejects an
-- empty family, a rung after converters or migrations, and duplicate migration
-- tables before constructing the `IStable` item.
pub fn parse_stable_decl(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let p1 = descend(depth, c)
  let PTook(d, c1) = p1 else parsed_refused(p1)
  parse_stable_decl_body(c1, d, vis)

fn parse_stable_decl_body(
  saved : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let p1 = take_fixed(saved, "stable")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_word(c1, TUid)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "\{")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let empty =
    StableParts {
      rungs = Nil,
      converters = Nil,
      migrations = Nil,
      has_migrations = false,
      saw_body = false
    }
  let p4 = parse_stable_entries(saved, c3, depth, name, empty)
  let PTook(parts, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "\}")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  if length(parts.rungs) == 0 then
    PFault(
        refuse(
            cursor_since(saved, c5),
            "`stable {name}` declares no version rungs",
          ),
      )
  else
    PTook(
        IStable {
          name = name,
          rungs = parts.rungs,
          converters = parts.converters,
          migrations = parts.migrations,
          span = cursor_since(saved, c5),
          vis = vis,
          dep = None
        },
        c5,
      )

fn parse_stable_entries(
  decl_start : Cursor,
  c : Cursor,
  depth : Int,
  family : String,
  parts : StableParts
) : Parsed(StableParts) =
  if at_fixed(c, "\}") then
    PTook(parts, c)
  else
    let p1 = parse_stable_entry(c, depth)
    let PTook(entry, c1) = p1 else parsed_refused(p1)
    match add_stable_entry(decl_start, c1, family, parts, entry) of
      CheckBad(d) => PFault(d)
      CheckOk(next) =>
        if at_fixed(c1, ",") then
          parse_stable_entries(
              decl_start,
              cursor_advance(c1),
              depth,
              family,
              next,
            )
        elif at_fixed(c1, "\}") then
          PTook(next, c1)
        else
          PStuck(note_comma_or(c1, "\}"))

fn parse_stable_entry(c : Cursor, depth : Int) : Parsed(StableEntry) =
  match cursor_kind(c) of
    Some(TUid) =>
      let p1 = parse_rung(c, depth)
      let PTook(rung, c1) = p1 else parsed_refused(p1)
      PTook(SERung(rung), c1)
    Some(TIdent) =>
      let word = peek_word(c)
      if word == "migrations" then
        let p2 = parse_migrations(c, depth)
        let PTook(rows, c1) = p2 else parsed_refused(p2)
        PTook(SEMigrations(rows), c1)
      elif word == "upgrade" || word == "downgrade" then
        let p3 = parse_converter(c, depth)
        let PTook(converter, c1) = p3 else parsed_refused(p3)
        PTook(SEConverter(converter), c1)
      else
        PFault(
            refuse(
                cursor_span(c),
                "expected a version rung, `upgrade`, `downgrade`, or `migrations`, found `{word}`",
              ),
          )
    _ => PStuck(note_stable_entry(c))

fn add_stable_entry(
  decl_start : Cursor,
  c : Cursor,
  family : String,
  parts : StableParts,
  entry : StableEntry
) : Checked(StableParts) =
  match entry of
    SERung(rung) =>
      if parts.saw_body then
        CheckBad(
            refuse(
                rung.span,
                "rung `{rung.name}` must come before the converters and migrations in `stable {family}`",
              ),
          )
      else
        CheckOk(StableParts { ..parts, rungs = append(parts.rungs, [rung]) })
    SEConverter(converter) =>
      CheckOk(
          StableParts {
            ..parts,
            converters = append(parts.converters, [converter]),
            saw_body = true
          },
        )
    SEMigrations(rows) =>
      if parts.has_migrations then
        CheckBad(
            refuse(
                cursor_since(decl_start, c),
                "`stable {family}` has two migration tables",
              ),
          )
      else
        CheckOk(
            StableParts {
              ..parts,
              migrations = rows,
              has_migrations = true,
              saw_body = true
            },
          )

-- -------------------------------------------------------------------------
-- Stable rungs
-- -------------------------------------------------------------------------

-- lint: allow(L0101)
fn parse_rung(c : Cursor, depth : Int) : Parsed(Rung) =
  let saved = c
  let p1 = take_word(c, TUid)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "=")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "\{")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_rung_body(c3, depth)
  let PTook(body, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "\}")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = parse_frozen_badge(c5)
  let PTook(frozen, c6) = p6 else parsed_refused(p6)
  match body of
    (base, fields) =>
      PTook(
          Rung {
            name = name,
            base = base,
            fields = fields,
            frozen = frozen,
            span = cursor_since(saved, c6)
          },
          c6,
        )

fn parse_rung_body(
  c : Cursor,
  depth : Int
) : Parsed((Option(String), List(RungField))) =
  if at_fixed(c, "..") then
    let p1 = take_word(cursor_advance(c), TUid)
    let PTook(base, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, "\}") then
      PTook((Some(base), Nil), c1)
    elif at_fixed(c1, ",") then
      let p2 = parse_rung_field(cursor_advance(c1), depth)
      let PTook(field, c2) = p2 else parsed_refused(p2)
      let p3 = parse_rung_field_tail(c2, depth, [field], false)
      let PTook(fields, c3) = p3 else parsed_refused(p3)
      PTook((Some(base), fields), c3)
    else
      PStuck(note_comma_or(c1, "\}"))
  elif at_fixed(c, "\}") then
    PTook((None, Nil), c)
  else
    let p4 = parse_rung_field(c, depth)
    let PTook(field, c1) = p4 else parsed_refused(p4)
    let p5 = parse_rung_field_tail(c1, depth, [field], true)
    let PTook(fields, c2) = p5 else parsed_refused(p5)
    PTook((None, fields), c2)

fn parse_rung_field_tail(
  c : Cursor,
  depth : Int,
  fields : List(RungField),
  allow_trailing : Bool
) : Parsed(List(RungField)) =
  if not(at_fixed(c, ",")) then
    PTook(fields, c)
  else
    let c1 = cursor_advance(c)
    if at_fixed(c1, "\}") && allow_trailing then
      PTook(fields, c1)
    else
      let p2 = parse_rung_field(c1, depth)
      let PTook(field, c2) = p2 else parsed_refused(p2)
      parse_rung_field_tail(c2, depth, append(fields, [field]), allow_trailing)

fn parse_rung_field(c : Cursor, depth : Int) : Parsed(RungField) =
  let p1 = take_word(c, TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, ":")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_type(c2, depth)
  let PTook(ty, c3) = p3 else parsed_refused(p3)
  if at_fixed(c3, "=") then
    let p4 = parse_expr(cursor_advance(c3), depth)
    let PTook(dflt, c4) = p4 else parsed_refused(p4)
    PTook(RungField { name = name, ty = ty, dflt = Some(dflt) }, c4)
  else
    PTook(RungField { name = name, ty = ty, dflt = None }, c3)

-- Optional in the grammar, but once an identifier follows a rung it is
-- committed as the contextual badge and checked deliberately.
fn parse_frozen_badge(c : Cursor) : Parsed(Option(String)) =
  if not(at_kind(c, TIdent)) then
    PTook(None, c)
  else
    let saved = c
    let p1 = take_word(c, TIdent)
    let PTook(word, c1) = p1 else parsed_refused(p1)
    if word /= "frozen" then
      PFault(
          refuse(
              cursor_since(saved, c1),
              "expected `frozen` after a rung, found `{word}`",
            ),
        )
    else
      let p2 = take_word(c1, TStr)
      let PTook(digest, c2) = p2 else parsed_refused(p2)
      PTook(Some(digest), c2)

-- -------------------------------------------------------------------------
-- Hand-written converters
-- -------------------------------------------------------------------------

-- lint: allow(L0101)
fn parse_converter(c : Cursor, depth : Int) : Parsed(Converter) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(dir, c1) = p1 else parsed_refused(p1)
  if dir /= "upgrade" && dir /= "downgrade" then
    PFault(
        refuse(
            cursor_since(saved, c1),
            "expected `upgrade` or `downgrade`, found `{dir}`",
          ),
      )
  else
    let p2 = take_word(c1, TUid)
    let PTook(from, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "->")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = take_word(c3, TUid)
    let PTook(to, c4) = p4 else parsed_refused(p4)
    let p5 = take_fixed(c4, "=")
    let PTook(_, c5) = p5 else parsed_refused(p5)
    let p6 = parse_converter_body(c5, depth)
    let PTook(body, c6) = p6 else parsed_refused(p6)
    let p7 = parse_drop_loss(c6)
    let PTook(dropped, c7) = p7 else parsed_refused(p7)
    match body of
      (base, overrides) =>
        PTook(
            Converter {
              dir = dir,
              from = from,
              to = to,
              base = base,
              overrides = overrides,
              drop_loss = dropped,
              span = cursor_since(saved, c7)
            },
            c7,
          )

fn parse_converter_body(
  c : Cursor,
  depth : Int
) : Parsed((Sp(Expr), List(NamedExpr))) =
  let p1 = take_fixed(c, "\{")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "..")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr(c2, depth)
  let PTook(base, c3) = p3 else parsed_refused(p3)
  let p4 = parse_converter_fields(c3, depth, Nil)
  let PTook(fields, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "\}")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  PTook((base, fields), c5)

-- Unlike ordinary comma lists, converter fields do not admit a trailing comma.
fn parse_converter_fields(
  c : Cursor,
  depth : Int,
  fields : List(NamedExpr)
) : Parsed(List(NamedExpr)) =
  if not(at_fixed(c, ",")) then
    PTook(fields, c)
  else
    let p1 = take_word(cursor_advance(c), TIdent)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "=")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_expr(c2, depth)
    let PTook(value, c3) = p3 else parsed_refused(p3)
    parse_converter_fields(c3, depth, append(fields, [
        NamedExpr { name = name, value = value },
      ]))

-- As with `frozen`, a following identifier commits to this optional contextual
-- suffix and receives a precise spelling diagnostic on mismatch.
fn parse_drop_loss(c : Cursor) : Parsed(List(String)) =
  if not(at_kind(c, TIdent)) then
    PTook(Nil, c)
  else
    let saved = c
    let p1 = take_word(c, TIdent)
    let PTook(word, c1) = p1 else parsed_refused(p1)
    if word /= "drop_loss" then
      PFault(
          refuse(
              cursor_since(saved, c1),
              "expected `drop_loss`, found `{word}`",
            ),
        )
    else
      let p2 = take_fixed(c1, "(")
      let PTook(_, c2) = p2 else parsed_refused(p2)
      parse_ident_list(c2, ")", Nil)

-- -------------------------------------------------------------------------
-- Migration tables and routes
-- -------------------------------------------------------------------------

fn parse_migrations(c : Cursor, depth : Int) : Parsed(List(Migration)) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(word, c1) = p1 else parsed_refused(p1)
  if word /= "migrations" then
    PFault(
        refuse(
            cursor_since(saved, c1),
            "expected `migrations`, found `{word}`",
          ),
      )
  else
    let p2 = take_fixed(c1, "\{")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_migration_rows(c2, depth, Nil)
    let PTook(rows, c3) = p3 else parsed_refused(p3)
    let p4 = take_fixed(c3, "\}")
    let PTook(_, c4) = p4 else parsed_refused(p4)
    PTook(rows, c4)

fn parse_migration_rows(
  c : Cursor,
  depth : Int,
  rows : List(Migration)
) : Parsed(List(Migration)) =
  if at_fixed(c, "\}") then
    PTook(rows, c)
  else
    let p1 = parse_migration_row(c, depth)
    let PTook(row, c1) = p1 else parsed_refused(p1)
    if c1.pos == c.pos then
      PFault(refuse(cursor_span(c), "migration parser made no progress"))
    else
      parse_migration_rows(c1, depth, append(rows, [row]))

fn parse_migration_row(c : Cursor, depth : Int) : Parsed(Migration) =
  let saved = c
  let p1 = take_word(c, TUid)
  let PTook(from, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "->")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = take_word(c2, TUid)
  let PTook(to, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "=")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_migration_route(c4, depth)
  let PTook(route, c5) = p5 else parsed_refused(p5)
  PTook(
      Migration {
        from = from,
        to = to,
        route = route,
        span = cursor_since(saved, c5)
      },
      c5,
    )

fn parse_migration_route(c : Cursor, depth : Int) : Parsed(MigrationRoute) =
  let saved = c
  let p1 = take_word(c, TIdent)
  let PTook(word, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, "(") then
    parse_version_route(saved, word, cursor_advance(c1), depth)
  elif word == "auto" then
    PTook(MAuto, c1)
  else
    PFault(
        refuse(
            cursor_since(saved, c1),
            "expected `auto` or `version(...)`, found `{word}`",
          ),
      )

-- lint: allow(L0101)
fn parse_version_route(
  saved : Cursor,
  word : String,
  c : Cursor,
  depth : Int
) : Parsed(MigrationRoute) =
  let p1 = parse_version_arg(c, depth)
  let PTook(up, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, ",")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_version_arg(c2, depth)
  let PTook(down, c3) = p3 else parsed_refused(p3)
  let c4 =
    if at_fixed(c3, ",") then
      cursor_advance(c3)
    else
      c3
  let p5 = take_fixed(c4, ")")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  match (up, down) of
    ((up_name, up_dir), (down_name, down_dir)) =>
      if word /= "version" then
        PFault(
            refuse(
                cursor_since(saved, c5),
                "expected `auto` or `version(...)`, found `{word}`",
              ),
          )
      elif up_name /= "upgrade" || down_name /= "downgrade" then
        PFault(
            refuse(
                cursor_since(saved, c5),
                "`version(...)` takes `upgrade = ..., downgrade = ...`",
              ),
          )
      else
        PTook(MVersion(up_dir, down_dir), c5)

fn parse_version_arg(c : Cursor, depth : Int) : Parsed((String, MigrationDir)) =
  let p1 = take_word(c, TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "=")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_expr(c2, depth)
  let PTook(expr, c3) = p3 else parsed_refused(p3)
  PTook((name, migration_dir(expr)), c3)

fn migration_dir(e : Sp(Expr)) : MigrationDir =
  match e.node of
    EVar(name) =>
      if name == "auto" then
        DAuto
      else
        DExpr(e)
    _ => DExpr(e)

-- -------------------------------------------------------------------------
-- Shared expectations
-- -------------------------------------------------------------------------

fn note_comma_or(c : Cursor, close : String) : Cursor =
  cursor_note(cursor_note(c, TFixed(",")), TFixed(close))

fn note_stable_entry(c : Cursor) : Cursor =
  let c1 = cursor_note(c, TUid)
  let c2 = cursor_note_name(c1, "upgrade")
  let c3 = cursor_note_name(c2, "downgrade")
  cursor_note_name(c3, "migrations")
