pub type GeneratedFieldReceipt = GFShorthand | GFExplicit(GeneratedPatternReceipt)

type GeneratedFieldDone = FieldDone(PatField, GeneratedFieldReceipt)

fn pattern_value(done : GeneratedPatternDone) : Sp(Pat) =
  match done of
    PatternDone(value, _) => value

fn pattern_receipt(done : GeneratedPatternDone) : GeneratedPatternReceipt =
  match done of
    PatternDone(_, receipt) => receipt

fn pattern_done(
  node : Pat,
  start : Cursor,
  c : Cursor,
  receipt : GeneratedPatternReceipt
) : Parsed(GeneratedPatternDone) =
  PTook(PatternDone(pattern_sp(node, start, c), receipt), c)

fn pattern_sp(node : Pat, start : Cursor, c : Cursor) : Sp(Pat) =
