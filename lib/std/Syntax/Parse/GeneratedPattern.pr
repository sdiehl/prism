fn pattern_suppress(c : Cursor) : Bool =
  at_fixed(c, ":")
    || at_fixed(c, ":=")
    || at_fixed(c, "if")
    || at_fixed(c, "=>")
    || at_fixed(c, ")")
    || at_fixed(c, "]")
