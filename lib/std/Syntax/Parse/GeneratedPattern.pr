            GFShorthand,
          ),
        c1,
      )

fn generated_field_follow(
  c : Cursor,
  receipt : GeneratedFieldReceipt
) : Cursor =
  let c1 = cursor_note(cursor_note(c, TFixed(",")), TFixed("\}"))
  match receipt of
    GFShorthand => cursor_note(c1, TFixed("="))
    GFExplicit(child) => generated_pattern_note_receipt(c1, child)
