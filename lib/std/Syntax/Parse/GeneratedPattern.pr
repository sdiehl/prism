fn generated_record_more(
  start : Cursor,
  name : String,
  depth : Int,
  c : Cursor,
  rev : List(PatField)
) : Parsed(GeneratedPatternDone) =
  if at_fixed(c, "\}") then
    generated_record_done(start, name, rev, false, cursor_advance(c))
  elif at_fixed(c, "..") then
    generated_record_rest(start, name, rev, c)
  else
    match generated_record_field(c, depth) of
      PStuck(c1) =>
        PStuck(
            if c1.pos == c.pos then cursor_note(cursor_note(c1, TFixed("..")), TFixed("\}")) else c1,
          )
      PFault(d) => PFault(d)
      PTook(done, c1) =>
        match done of
          FieldDone(field, receipt) =>
            let rev1 = Cons(field, rev)
            if at_fixed(c1, "\}") then
              generated_record_done(
                  start,
                  name,
                  rev1,
                  false,
                  cursor_advance(c1),
                )
            elif at_fixed(c1, ",") then
              let c2 = cursor_advance(c1)
              if at_fixed(c2, "\}") then
                generated_record_done(
                    start,
                    name,
                    rev1,
                    false,
                    cursor_advance(c2),
                  )
              elif at_fixed(c2, "..") then
                generated_record_rest(start, name, rev1, c2)
              else
                generated_record_more(start, name, depth, c2, rev1)
            else
              PStuck(generated_field_follow(c1, receipt))

fn generated_record_rest(
  start : Cursor,
  name : String,
  rev : List(PatField),
  c : Cursor
) : Parsed(GeneratedPatternDone) =
  let p1 = take_fixed(cursor_advance(c), "\}")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  generated_record_done(start, name, rev, true, c1)

fn generated_record_done(
  start : Cursor,
  name : String,
  rev : List(PatField),
  spread : Bool,
  c : Cursor
) : Parsed(GeneratedPatternDone) =
  pattern_done(PRecord(name, reverse(rev), spread), start, c, PRPlain)

fn generated_record_field(
  c : Cursor,
  depth : Int
) : Parsed(GeneratedFieldDone) =
  let p1 = take_word(c, TIdent)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  if at_fixed(c1, "=") then
    generated_bind(generated_parse_pattern(cursor_advance(c1), depth)) fn(done, c2)
