-- | Effects, classes, instances, canonical designations, and the shared
-- `alias` declaration family for the Prism-owned parser.
--
-- These declarations share two pieces of grammar that do not belong in the
-- top-level dispatcher: `given` constraints and member lists.  Effect, class,
-- and instance members are layout-delimited; a real brace is recognized as the
-- retired form and receives the same directed rewrite as the bootstrap parser.
-- Instance methods are parsed here as complete function declarations so this
-- module does not depend on private helpers in `Syntax.Parse.Decl`.

import Data.List (..)
import Syntax.Source (..)
import Syntax.Token (..)
import Syntax.Ast (..)
import Syntax.Cursor (..)
import Syntax.Parse.Support (..)
import Syntax.Parse.Type (..)
import Syntax.Parse.Pattern (..)
import Syntax.Parse.Expr (..)

-- -------------------------------------------------------------------------
-- Shared token and layout helpers
-- -------------------------------------------------------------------------

fn at_sep(c : Cursor) : Bool = at_fixed(c, ",") || at_kind(c, TVSemi)

fn skip_sep(c : Cursor) : Cursor =
  if at_sep(c) then
    cursor_advance(c)
  else
    c

fn expect_layout_open(c : Cursor, family : String) : Parsed(Token) =
  if at_fixed(c, "\{") then
    let member =
      if family == "effect" then
        "operation"
      elif family == "class" then
        "method"
      else
        "member"
    PFault(
        refuse(
            cursor_span(c),
            "{family} bodies use layout: remove the braces and put each {member} on its own indented line",
          ),
      )
  else
    take_kind(c, TVOpen)

fn take_uid(c : Cursor) : Parsed(String) = take_word(c, TUid)

fn take_ident(c : Cursor) : Parsed(String) = take_word(c, TIdent)

-- An unkinded type-parameter list, used by effects and aliases.  A trailing
-- comma is accepted because the bootstrap grammar's `Comma` production does.
fn parse_ty_params(c : Cursor) : Parsed(List(String)) =
  if not(at_fixed(c, "(")) then
    PTook(Nil, c)
  else
    parse_ty_params_go(cursor_advance(c), Nil)

-- lint: allow(L0105)
fn parse_ty_params_go(c : Cursor, rev : List(String)) : Parsed(List(String)) =
  if at_fixed(c, ")") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = take_ident(c)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_ty_params_go(cursor_advance(c1), Cons(name, rev))
    elif at_fixed(c1, ")") then
      PTook(reverse(Cons(name, rev)), cursor_advance(c1))
    else
      PStuck(cursor_note_name(c1, ")"))

-- -------------------------------------------------------------------------
-- Given constraints
-- -------------------------------------------------------------------------

-- | Parse an optional `given Class(Type), ...` clause.  This is public because
-- ordinary function declarations and the other declaration-family modules use
-- exactly the same qualifier.
pub fn parse_given_clause(c : Cursor, depth : Int) : Parsed(List(Constraint)) =
  if not(at_fixed(c, "given")) then
    PTook(Nil, c)
  else
    let p1 = parse_constraint(cursor_advance(c), depth)
    let PTook(first, c1) = p1 else parsed_refused(p1)
    parse_given_more(c1, depth, [first])

fn parse_given_more(
  c : Cursor,
  depth : Int,
  acc : List(Constraint)
) : Parsed(List(Constraint)) =
  if at_fixed(c, ",") then
    let p1 = parse_constraint(cursor_advance(c), depth)
    let PTook(next, c1) = p1 else parsed_refused(p1)
    parse_given_more(c1, depth, append(acc, [next]))
  else
    PTook(acc, c)

fn parse_constraint(c : Cursor, depth : Int) : Parsed(Constraint) =
  let saved = c
  let p1 = take_uid(c)
  let PTook(cls, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "(")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_type(c2, depth)
  let PTook(ty, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, ")")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  PTook(Constraint { cls = cls, ty = ty, span = cursor_since(saved, c4) }, c4)

fn constraint_names(cs : List(Constraint)) : List(String) =
  match cs of
    Nil => Nil
    Cons(c, rest) => Cons(c.cls, constraint_names(rest))

-- -------------------------------------------------------------------------
-- Effect declarations
-- -------------------------------------------------------------------------

-- | Parse an `effect` item. `c` points at the keyword, and `vis` is the
-- already-decoded visibility prefix (`None`, `Some("pub")`, or
-- `Some("opaque")`).
pub fn parse_effect_item(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let saved = c
  let p1 = take_fixed(c, "effect")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_uid(c1)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = parse_ty_params(c2)
  let PTook(params, c3) = p3 else parsed_refused(p3)
  let p4 = expect_layout_open(c3, "effect")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_effect_ops(c4, depth, Nil)
  let PTook(ops, c5) = p5 else parsed_refused(p5)
  let p6 = take_kind(c5, TVClose)
  let PTook(_, c6) = p6 else parsed_refused(p6)
  PTook(
      IEffect {
        name = name,
        params = params,
        ops = ops,
        span = cursor_since(saved, c6),
        vis = vis,
        dep = None
      },
      c6,
    )

-- lint: allow(L0105)
fn parse_effect_ops(
  c : Cursor,
  depth : Int,
  rev : List(EffOp)
) : Parsed(List(EffOp)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), c)
  elif at_sep(c) then
    parse_effect_ops(cursor_advance(c), depth, rev)
  else
    let p1 = parse_effect_op(c, depth)
    let PTook(op, c1) = p1 else parsed_refused(p1)
    if c1.pos == c.pos then
      PFault(refuse(cursor_span(c), "effect operation parser made no progress"))
    else
      parse_effect_ops(skip_sep(c1), depth, Cons(op, rev))

fn parse_effect_op(c : Cursor, depth : Int) : Parsed(EffOp) =
  let first = peek_word(c)
  let graded = at_kind(c, TIdent) && at_kind(cursor_advance(c), TIdent)
  if graded then
    if first == "never" then
      parse_effect_op_named(cursor_advance(c), depth, Some("never"))
    elif first == "once" then
      parse_effect_op_named(cursor_advance(c), depth, Some("once"))
    elif first == "many" then
      parse_effect_op_named(cursor_advance(c), depth, None)
    else
      PFault(
          refuse(
              cursor_span(c),
              "`{first}` is not a grade: an operation grade is `never`, `once`, or `many`, or omit it for `many`",
            ),
        )
  else
    parse_effect_op_named(c, depth, None)

fn parse_effect_op_named(
  c : Cursor,
  depth : Int,
  grade : Option(String)
) : Parsed(EffOp) =
  let p1 = take_ident(c)
  let PTook(name, c1) = p1 else parsed_refused(p1)
  let p2 = take_fixed(c1, "(")
  let PTook(_, c2) = p2 else parsed_refused(p2)
  let p3 = parse_effect_params(c2, depth, Nil)
  let PTook(params, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, ":")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  let p5 = parse_type(c4, depth)
  let PTook(ret, c5) = p5 else parsed_refused(p5)
  PTook(EffOp { name = name, params = params, ret = ret, grade = grade }, c5)

-- lint: allow(L0105)
fn parse_effect_params(
  c : Cursor,
  depth : Int,
  rev : List(Ty)
) : Parsed(List(Ty)) =
  if at_fixed(c, ")") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = parse_effect_param(c, depth)
    let PTook(ty, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_effect_params(cursor_advance(c1), depth, Cons(ty, rev))
    elif at_fixed(c1, ")") then
      PTook(reverse(Cons(ty, rev)), cursor_advance(c1))
    else
      PStuck(cursor_note_name(c1, ")"))

fn parse_effect_param(c : Cursor, depth : Int) : Parsed(Ty) =
  if at_kind(c, TIdent) && at_fixed(cursor_advance(c), ":") then
    parse_type(cursor_advance(cursor_advance(c)), depth)
  else
    parse_type(c, depth)

-- -------------------------------------------------------------------------
-- Alias declarations
-- -------------------------------------------------------------------------

-- | Parse the shared `alias` family. A brace RHS constructs an effect alias;
-- every other RHS is a type synonym. The optional parameter list is retained
-- only for a synonym, matching the bootstrap AST.
pub fn parse_alias_item(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let saved = c
  let p1 = take_fixed(c, "alias")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_uid(c1)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = parse_ty_params(c2)
  let PTook(params, c3) = p3 else parsed_refused(p3)
  let p4 = take_fixed(c3, "=")
  let PTook(_, c4) = p4 else parsed_refused(p4)
  if at_fixed(c4, "\{") then
    parse_effect_alias_rhs(saved, name, c4, depth, vis)
  else
    let p5 = parse_type(c4, depth)
    let PTook(ty, c5) = p5 else parsed_refused(p5)
    PTook(
        ISynonym {
          name = name,
          params = params,
          ty = ty,
          span = cursor_since(saved, c5),
          vis = vis,
          dep = None
        },
        c5,
      )

fn parse_effect_alias_rhs(
  saved : Cursor,
  name : String,
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let p1 = parse_alias_labels(cursor_advance(c), depth, Nil)
  let PTook(labels, c1) = p1 else parsed_refused(p1)
  PTook(
      IEffAlias {
        name = name,
        labels = labels,
        span = cursor_since(saved, c1),
        vis = vis,
        dep = None
      },
      c1,
    )

-- lint: allow(L0105)
fn parse_alias_labels(
  c : Cursor,
  depth : Int,
  rev : List(EffLabel)
) : Parsed(List(EffLabel)) =
  if at_fixed(c, "\}") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let p1 = parse_eff_label(c, depth)
    let PTook(label, c1) = p1 else parsed_refused(p1)
    if at_fixed(c1, ",") then
      parse_alias_labels(cursor_advance(c1), depth, Cons(label, rev))
    elif at_fixed(c1, "\}") then
      PTook(reverse(Cons(label, rev)), cursor_advance(c1))
    else
      PStuck(cursor_note_name(c1, "\}"))

-- -------------------------------------------------------------------------
-- Classes
-- -------------------------------------------------------------------------

-- | Parse a class declaration, including marker classes without a body and
-- layout bodies containing method signatures.
pub fn parse_class_item(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let saved = c
  let p1 = take_fixed(c, "class")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_uid(c1)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "(")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = take_ident(c3)
  let PTook(param, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, ")")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = parse_given_clause(c5, depth)
  let PTook(supers, c6) = p6 else parsed_refused(p6)
  parse_class_body(saved, name, param, constraint_names(supers), c6, depth, vis)

-- lint: allow(L0103)
fn parse_class_body(
  saved : Cursor,
  name : String,
  param : String,
  supers : List(String),
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  if at_fixed(c, "\{") then
    let p1 = expect_layout_open(c, "class")
    let PTook(_, c1) = p1 else parsed_refused(p1)
    PStuck(c1)
  elif not(at_kind(c, TVOpen)) then
    PTook(
        IClass {
          name = name,
          param = param,
          supers = supers,
          methods = Nil,
          span = cursor_since(saved, c),
          vis = vis,
          dep = None
        },
        c,
      )
  else
    let p2 = take_kind(c, TVOpen)
    let PTook(_, c1) = p2 else parsed_refused(p2)
    let p3 = parse_class_methods(c1, depth, Nil)
    let PTook(methods, c2) = p3 else parsed_refused(p3)
    let p4 = take_kind(c2, TVClose)
    let PTook(_, c3) = p4 else parsed_refused(p4)
    PTook(
        IClass {
          name = name,
          param = param,
          supers = supers,
          methods = methods,
          span = cursor_since(saved, c3),
          vis = vis,
          dep = None
        },
        c3,
      )

-- lint: allow(L0105)
fn parse_class_methods(
  c : Cursor,
  depth : Int,
  rev : List(Method)
) : Parsed(List(Method)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), c)
  elif at_sep(c) then
    parse_class_methods(cursor_advance(c), depth, rev)
  else
    let p1 = take_ident(c)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, ":")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_type(c2, depth)
    let PTook(ty, c3) = p3 else parsed_refused(p3)
    parse_class_methods(
        skip_sep(c3),
        depth,
        Cons(Method { name = name, ty = ty }, rev),
      )

-- -------------------------------------------------------------------------
-- Instances and instance methods
-- -------------------------------------------------------------------------

-- | Parse an instance declaration, including marker instances and layout
-- bodies of complete function declarations. Visibility is accepted for the
-- uniform dispatcher API; the phase-independent instance AST has no visibility
-- field, matching the bootstrap export.
-- lint: allow(L0101)
pub fn parse_instance_item(
  c : Cursor,
  depth : Int,
  vis : Option(String)
) : Parsed(Item) =
  let saved = c
  let p1 = take_fixed(c, "instance")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_ident(c1)
  let PTook(name, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, ":")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = take_uid(c3)
  let PTook(cls, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, "(")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = parse_type(c5, depth)
  let PTook(head, c6) = p6 else parsed_refused(p6)
  let p7 = take_fixed(c6, ")")
  let PTook(_, c7) = p7 else parsed_refused(p7)
  let p8 = parse_given_clause(c7, depth)
  let PTook(context, c8) = p8 else parsed_refused(p8)
  parse_instance_body(saved, name, cls, head, context, c8, depth, vis)

-- lint: allow(L0103)
fn parse_instance_body(
  saved : Cursor,
  name : String,
  cls : String,
  head : Ty,
  context : List(Constraint),
  c : Cursor,
  depth : Int,
  _vis : Option(String)
) : Parsed(Item) =
  if at_fixed(c, "\{") then
    let p1 = expect_layout_open(c, "instance")
    let PTook(_, c1) = p1 else parsed_refused(p1)
    PStuck(c1)
  elif not(at_kind(c, TVOpen)) then
    PTook(
        IInstance {
          name = name,
          cls = cls,
          head = head,
          context = context,
          decls = Nil,
          span = cursor_since(saved, c)
        },
        c,
      )
  else
    let p2 = take_kind(c, TVOpen)
    let PTook(_, c1) = p2 else parsed_refused(p2)
    let p3 = parse_instance_methods(c1, depth, Nil)
    let PTook(methods, c2) = p3 else parsed_refused(p3)
    let p4 = take_kind(c2, TVClose)
    let PTook(_, c3) = p4 else parsed_refused(p4)
    PTook(
        IInstance {
          name = name,
          cls = cls,
          head = head,
          context = context,
          decls = methods,
          span = cursor_since(saved, c3)
        },
        c3,
      )

-- lint: allow(L0105)
fn parse_instance_methods(
  c : Cursor,
  depth : Int,
  rev : List(Decl)
) : Parsed(List(Decl)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), c)
  elif at_sep(c) then
    parse_instance_methods(cursor_advance(c), depth, rev)
  else
    let p1 = parse_method_decl(c, depth)
    let PTook(method, c1) = p1 else parsed_refused(p1)
    if c1.pos == c.pos then
      PFault(refuse(cursor_span(c), "instance method parser made no progress"))
    else
      parse_instance_methods(skip_sep(c1), depth, Cons(method, rev))

-- Leading contextual modifiers are consumed only in their canonical order:
-- `test`, then `total` or `assume total`.
fn parse_method_mods(c : Cursor) : Parsed((Bool, Option(String), Cursor)) =
  let is_test = peek_word(c) == "test"
  let c1 =
    if is_test then
      cursor_advance(c)
    else
      c
  if peek_word(c1) == "assume" then
    let c2 = cursor_advance(c1)
    if peek_word(c2) == "total" then
      PTook((is_test, Some("assume"), cursor_advance(c2)), c)
    else
      PFault(
          refuse(
              cursor_span(c1),
              "`assume` is not a declaration modifier by itself; write `assume total`",
            ),
        )
  elif peek_word(c1) == "total" then
    PTook((is_test, Some("prove"), cursor_advance(c1)), c)
  else
    PTook((is_test, None, c1), c)

fn parse_method_decl(c : Cursor, depth : Int) : Parsed(Decl) =
  let saved = c
  let p1 = parse_method_mods(c)
  let PTook(mods, _) = p1 else parsed_refused(p1)
  match mods of
    (is_test, totality, c1) =>
      let is_replayable = at_fixed(c1, "replayable")
      let c2 =
        if is_replayable then
          cursor_advance(c1)
        else
          c1
      let fip_word =
        if at_fixed(c2, "fip") then
          Some("fip")
        elif at_fixed(c2, "fbip") then
          Some("fbip")
        else
          None
      let c3 =
        match fip_word of
          None => c2
          Some(_) => cursor_advance(c2)
      let p4 = take_fixed(c3, "fn")
      let PTook(_, c4) = p4 else parsed_refused(p4)
      let p5 = take_ident(c4)
      let PTook(name, c5) = p5 else parsed_refused(p5)
      let p6 = take_fixed(c5, "(")
      let PTook(_, c6) = p6 else parsed_refused(p6)
      let p7 = parse_method_params(c6, depth, 0, Nil)
      let PTook(params, c7) = p7 else parsed_refused(p7)
      parse_method_after_params(
          saved,
          name,
          params,
          c7,
          depth,
          is_test,
          totality,
          fip_word,
          is_replayable,
        )

-- lint: allow(L0101, L0103)
fn parse_method_after_params(
  saved : Cursor,
  name : String,
  params : List(Param),
  c : Cursor,
  depth : Int,
  is_test : Bool,
  totality : Option(String),
  fip_word : Option(String),
  is_replayable : Bool
) : Parsed(Decl) =
  let p1 = parse_return_ann(c, depth)
  let PTook(ann, c1) = p1 else parsed_refused(p1)
  match ann of
    (ret0, eff, no_alloc) =>
      let p2 = parse_given_clause(c1, depth)
      let PTook(constraints, c2) = p2 else parsed_refused(p2)
      let p3 = parse_requires(c2, depth, Nil)
      let PTook(reqs, c3) = p3 else parsed_refused(p3)
      let p4 = parse_ensures(c3, depth, Nil)
      let PTook(enss, c4) = p4 else parsed_refused(p4)
      let p5 = parse_decreases(c4, depth)
      let PTook(measure, c5) = p5 else parsed_refused(p5)
      let p6 = take_fixed(c5, "=")
      let PTook(_, c6) = p6 else parsed_refused(p6)
      let p7 = parse_expr_or_block(c6, depth)
      let PTook(body, c7) = p7 else parsed_refused(p7)
      let p8 = parse_where_block(c7, depth)
      let PTook(wheres, c8) = p8 else parsed_refused(p8)
      PTook(
          Decl {
            name = name,
            params = params,
            ret = ret0,
            eff = eff,
            constraints = constraints,
            body = body,
            wheres = wheres,
            reqs = reqs,
            enss = enss,
            measure = measure,
            is_test = is_test,
            totality = totality,
            fip_word = fip_word,
            is_replayable = is_replayable,
            is_no_alloc = no_alloc,
            span = cursor_since(saved, c8)
          },
          c8,
        )

-- lint: allow(L0105)
fn parse_method_params(
  c : Cursor,
  depth : Int,
  index : Int,
  rev : List(Param)
) : Parsed(List(Param)) =
  if at_fixed(c, ")") then
    PTook(reverse(rev), cursor_advance(c))
  else
    let borrowed = at_fixed(c, "borrow")
    let c0 =
      if borrowed then
        cursor_advance(c)
      else
        c
    let p1 = parse_pattern(c0, depth)
    let PTook(pat, c1) = p1 else parsed_refused(p1)
    let p2 = parse_optional_type(c1, depth)
    let PTook(ty, c2) = p2 else parsed_refused(p2)
    let p3 = parse_optional_default(c2, depth)
    let PTook(dflt, c3) = p3 else parsed_refused(p3)
    let param =
      match pat.node of
        PVar(n) =>
          Param {
            name = n,
            pat = None,
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          }
        PWild =>
          Param {
            name = "_",
            pat = None,
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          }
        _ =>
          Param {
            name = "arg@{index}",
            pat = Some(pat),
            ty = ty,
            is_borrow = borrowed,
            dflt = dflt
          }
    if at_fixed(c3, ",") then
      parse_method_params(
          cursor_advance(c3),
          depth,
          index + 1,
          Cons(param, rev),
        )
    elif at_fixed(c3, ")") then
      PTook(reverse(Cons(param, rev)), cursor_advance(c3))
    else
      PStuck(cursor_note_name(c3, ")"))

fn parse_optional_type(c : Cursor, depth : Int) : Parsed(Option(Ty)) =
  if at_fixed(c, ":") then
    let p1 = parse_type(cursor_advance(c), depth)
    let PTook(ty, c1) = p1 else parsed_refused(p1)
    PTook(Some(ty), c1)
  else
    PTook(None, c)

fn parse_optional_default(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if at_fixed(c, ":=") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    PTook(Some(e), c1)
  else
    PTook(None, c)

-- -------------------------------------------------------------------------
-- Function return annotations
-- -------------------------------------------------------------------------

-- The result type and its declaration effect have a shared `!` token.  Parse
-- the type through a capped view of the cursor, then attach the row to a
-- function result (including beneath `forall`) or retain it as the
-- declaration's ambient effect for every other result.
-- lint: allow(L0101)
fn parse_return_ann(
  c : Cursor,
  depth : Int
) : Parsed((Option(Ty), Option(Row), Bool)) =
  if not(at_fixed(c, ":")) then
    PTook((None, None, false), c)
  elif at_fixed(cursor_advance(c), "!") then
    PFault(
        refuse(
            cursor_since(c, cursor_advance(cursor_advance(c))),
            "the effect row now follows the result type: write `: Result ! \{Effects\}` instead of `: !\{Effects\} Result`",
          ),
      )
  else
    let start = cursor_advance(c)
    match find_top_bang(start, start.pos, 0, 0, 0) of
      None =>
        let p1 = parse_type(start, depth)
        let PTook(ty, c1) = p1 else parsed_refused(p1)
        match lift_noalloc(ty) of
          (ret, no_alloc) => PTook((Some(ret), None, no_alloc), c1)
      Some(stop) =>
        let capped = cap_cursor(start, stop)
        let p2 = parse_type(capped, depth)
        let PTook(ty, c1) = p2 else parsed_refused(p2)
        if c1.pos /= stop then
          PStuck(cursor_note_name(full_cursor(start, c1), "type"))
        else
          let c2 = full_cursor(start, c1)
          let p3 = parse_effect_row(c2, depth)
          let PTook(row, c3) = p3 else parsed_refused(p3)
          match attach_decl_effect(ty, row) of
            (ret, eff) =>
              match lift_noalloc(ret) of
                (ret2, no_alloc) => PTook((Some(ret2), eff, no_alloc), c3)

fn lift_noalloc(ty : Ty) : (Ty, Bool) =
  match ty of
    TyUsage(inner, facts) =>
      match facts of
        Cons(fact, Nil) =>
          if fact == "noalloc" then
            (inner, true)
          else
            (ty, false)
        _ => (ty, false)
    _ => (ty, false)

fn attach_decl_effect(ty : Ty, row : Row) : (Ty, Option(Row)) =
  match ty of
    TyFun(params, _, ret) => (TyFun(params, row, ret), None)
    TyForall(vars, body) =>
      match attach_decl_effect(body, row) of
        (body2, None) => (TyForall(vars, body2), None)
        (_, Some(eff)) => (ty, Some(eff))
    _ => (ty, Some(row))

fn cap_cursor(c : Cursor, stop : Int) : Cursor =
  let toks = take(stop, array_to_list(c.toks))
  let end_span =
    match cursor_peek_at(c, stop - c.pos) of
      None => c.stop
      Some(t) => t.span.lo
  Cursor {
    toks = array_of_list(toks),
    pos = c.pos,
    stop = end_span,
    far = min(c.far, stop),
    wanted = c.wanted
  }

fn full_cursor(base : Cursor, parsed : Cursor) : Cursor =
  Cursor { ..base, pos = parsed.pos }

-- lint: allow(L0101)
fn find_top_bang(
  c : Cursor,
  i : Int,
  parens : Int,
  brackets : Int,
  braces : Int
) : Option(Int) =
  if i >= cursor_count(c) then
    None
  else
    let t = array_get(c.toks, i)
    match t.kind of
      TVOpen =>
        if parens == 0 && brackets == 0 && braces == 0 then
          None
        else
          find_top_bang(c, i + 1, parens, brackets, braces)
      TVSemi =>
        if parens == 0 && brackets == 0 && braces == 0 then
          None
        else
          find_top_bang(c, i + 1, parens, brackets, braces)
      TVClose =>
        if parens == 0 && brackets == 0 && braces == 0 then
          None
        else
          find_top_bang(c, i + 1, parens, brackets, braces)
      TFixed(s) =>
        if s == "(" then
          find_top_bang(c, i + 1, parens + 1, brackets, braces)
        elif s == ")" then
          if parens == 0 && brackets == 0 && braces == 0 then
            None
          else
            find_top_bang(c, i + 1, max(0, parens - 1), brackets, braces)
        elif s == "[" then
          find_top_bang(c, i + 1, parens, brackets + 1, braces)
        elif s == "]" then
          if parens == 0 && brackets == 0 && braces == 0 then
            None
          else
            find_top_bang(c, i + 1, parens, max(0, brackets - 1), braces)
        elif s == "\{" then
          find_top_bang(c, i + 1, parens, brackets, braces + 1)
        elif s == "\}" then
          if parens == 0 && brackets == 0 && braces == 0 then
            None
          else
            find_top_bang(c, i + 1, parens, brackets, max(0, braces - 1))
        elif s == "!" && parens == 0 && brackets == 0 && braces == 0 then
          Some(i)
        elif ((s == "="
            || s == ","
            || s == "given"
            || s == "requires"
            || s == "ensures"
            || s == "where")
            && parens == 0
            && brackets == 0
            && braces == 0) then
          None
        else
          find_top_bang(c, i + 1, parens, brackets, braces)
      TIdent =>
        if (token_text(t) == "decreases"
            && parens == 0
            && brackets == 0
            && braces == 0) then
          None
        else
          find_top_bang(c, i + 1, parens, brackets, braces)
      _ => find_top_bang(c, i + 1, parens, brackets, braces)

-- -------------------------------------------------------------------------
-- Function clauses
-- -------------------------------------------------------------------------

-- lint: allow(L0105)
fn parse_requires(
  c : Cursor,
  depth : Int,
  rev : List(Sp(Expr))
) : Parsed(List(Sp(Expr))) =
  if at_fixed(c, "requires") then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    parse_requires(c1, depth, Cons(e, rev))
  else
    PTook(reverse(rev), c)

-- lint: allow(L0105)
fn parse_ensures(
  c : Cursor,
  depth : Int,
  rev : List(Ensure)
) : Parsed(List(Ensure)) =
  if at_fixed(c, "ensures") then
    let p1 = take_fixed(cursor_advance(c), "|")
    let PTook(_, c1) = p1 else parsed_refused(p1)
    let p2 = take_ident(c1)
    let PTook(binder, c2) = p2 else parsed_refused(p2)
    let p3 = take_fixed(c2, "|")
    let PTook(_, c3) = p3 else parsed_refused(p3)
    let p4 = parse_expr(c3, depth)
    let PTook(expr, c4) = p4 else parsed_refused(p4)
    parse_ensures(c4, depth, Cons(Ensure { binder = binder, expr = expr }, rev))
  else
    PTook(reverse(rev), c)

fn parse_decreases(c : Cursor, depth : Int) : Parsed(Option(Sp(Expr))) =
  if peek_word(c) == "decreases" then
    let p1 = parse_expr(cursor_advance(c), depth)
    let PTook(e, c1) = p1 else parsed_refused(p1)
    PTook(Some(e), c1)
  else
    PTook(None, c)

fn parse_where_block(c : Cursor, depth : Int) : Parsed(List(NamedExpr)) =
  if not(at_fixed(c, "where")) then
    PTook(Nil, c)
  else
    let p1 = take_kind(cursor_advance(c), TVOpen)
    let PTook(_, c1) = p1 else parsed_refused(p1)
    parse_where_bindings(c1, depth, Nil)

-- lint: allow(L0105)
fn parse_where_bindings(
  c : Cursor,
  depth : Int,
  rev : List(NamedExpr)
) : Parsed(List(NamedExpr)) =
  if at_kind(c, TVClose) then
    PTook(reverse(rev), cursor_advance(c))
  elif at_kind(c, TVSemi) then
    parse_where_bindings(cursor_advance(c), depth, rev)
  else
    let p1 = take_ident(c)
    let PTook(name, c1) = p1 else parsed_refused(p1)
    let p2 = take_fixed(c1, "=")
    let PTook(_, c2) = p2 else parsed_refused(p2)
    let p3 = parse_expr_or_block(c2, depth)
    let PTook(value, c3) = p3 else parsed_refused(p3)
    parse_where_bindings(
        c3,
        depth,
        Cons(NamedExpr { name = name, value = value }, rev),
      )

-- -------------------------------------------------------------------------
-- Canonical instance designations
-- -------------------------------------------------------------------------

-- | Parse `canonical Class(Head) = instance_name`.
-- lint: allow(L0101)
pub fn parse_canonical_item(
  c : Cursor,
  depth : Int,
  _vis : Option(String)
) : Parsed(Item) =
  let saved = c
  let p1 = take_fixed(c, "canonical")
  let PTook(_, c1) = p1 else parsed_refused(p1)
  let p2 = take_uid(c1)
  let PTook(cls, c2) = p2 else parsed_refused(p2)
  let p3 = take_fixed(c2, "(")
  let PTook(_, c3) = p3 else parsed_refused(p3)
  let p4 = parse_type(c3, depth)
  let PTook(head, c4) = p4 else parsed_refused(p4)
  let p5 = take_fixed(c4, ")")
  let PTook(_, c5) = p5 else parsed_refused(p5)
  let p6 = take_fixed(c5, "=")
  let PTook(_, c6) = p6 else parsed_refused(p6)
  let p7 = take_ident(c6)
  let PTook(name, c7) = p7 else parsed_refused(p7)
  PTook(
      ICanonical {
        cls = cls,
        head = head,
        name = name,
        span = cursor_since(saved, c7)
      },
      c7,
    )
