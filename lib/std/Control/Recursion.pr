-- | Type-changing folds and unfolds over ordinary recursive datatypes.
--
-- A datatype opts in by defining its own one-layer base type plus three small
-- structural functions: `project` opens one recursive layer, `embed` closes one,
-- and `map_layer` changes only recursive positions. There is deliberately no
-- universal fixed-point carrier: values keep their normal application-facing
-- datatype, and the adapters remain local enough to audit beside its
-- constructors.
--
-- The structural laws are `embed(project(x)) == x`,
-- `project(embed(layer)) == layer`, and the usual identity and composition laws
-- for `map_layer`. Mapping must preserve the layer constructor and every
-- non-recursive field, visit each recursive position exactly once, and visit
-- them left to right in declaration order. Those laws make `project`, `embed`,
-- and `map_layer` an honest one-layer view rather than a second interpretation
-- of the datatype.
--
-- `cata` and `para` terminate on finite values when `project` returns only
-- strict subterms. `ana` and `hylo` terminate when their coalgebra eventually
-- produces layers with no recursive positions. A materialized
-- `cata(..., ana(..., seed))` allocates the intermediate recursive value;
-- `hylo` applies the same unfold and fold one layer at a time without that
-- carrier. They agree for pure algebra and coalgebra pairs, but effects can make
-- their observation order differ, so the library performs no automatic fusion.
--
-- Every algebra, coalgebra, and mapper row is open. Effects performed by
-- `map_layer` and the recursive callback it invokes are observed in the
-- mapper's promised left-to-right order; no scheme handles, masks, or reorders
-- them.

-- | Collapse a finite recursive value bottom-up. `project` exposes one layer,
-- `map_layer` replaces each recursive child with its folded answer, and
-- `algebra` consumes the resulting layer.
--
-- This parameterized binary tree keeps payload type `a` separate from the
-- recursive hole `r`; summing it demonstrates a type-changing fold.
--
-- ```prism
-- # type Tree(a) = Leaf(a) | Branch(Tree(a), Tree(a))
-- # type TreeF(a, r) = LeafF(a) | BranchF(r, r)
-- # fn project(t : Tree(a)) : TreeF(a, Tree(a)) = match t of { Leaf(x) => LeafF(x), Branch(l, r) => BranchF(l, r) }
-- # fn map_layer(f : (r) -> s ! {| e}, layer : TreeF(a, r)) : TreeF(a, s) ! {| e} =
-- #   match layer of
-- #     LeafF(x) => LeafF(x)
-- #     BranchF(l, r) =>
-- #       let l1 = f(l)
-- #       let r1 = f(r)
-- #       BranchF(l1, r1)
-- # fn sum_layer(layer : TreeF(Int, Int)) : Int = match layer of { LeafF(n) => n, BranchF(l, r) => l + r }
-- fn main() =
--   cata(project, map_layer, sum_layer, Branch(Leaf(1), Branch(Leaf(2), Leaf(3))))
-- ```
-- ```output
-- 6
-- ```
pub fn cata(
  project : (r) -> recursive_layer,
  map_layer : ((r) -> a ! {| e}, recursive_layer) -> answer_layer ! {| e},
  algebra : (answer_layer) -> a ! {| e},
  value : r
) : a ! { | e} =
  algebra(
      map_layer(
          \(child) -> cata(project, map_layer, algebra, child),
          project(value),
        ),
    )

-- | Build a finite recursive value top-down. `coalgebra` expands a seed into
-- one layer of new seeds, `map_layer` recursively replaces those seeds with
-- values, and `embed` closes the layer.
--
-- ```prism
-- # type Tree(a) = Leaf(a) | Branch(Tree(a), Tree(a))
-- # type TreeF(a, r) = LeafF(a) | BranchF(r, r)
-- # fn embed(layer : TreeF(a, Tree(a))) : Tree(a) = match layer of { LeafF(x) => Leaf(x), BranchF(l, r) => Branch(l, r) }
-- # fn map_layer(f : (r) -> s ! {| e}, layer : TreeF(a, r)) : TreeF(a, s) ! {| e} =
-- #   match layer of
-- #     LeafF(x) => LeafF(x)
-- #     BranchF(l, r) =>
-- #       let l1 = f(l)
-- #       let r1 = f(r)
-- #       BranchF(l1, r1)
-- # fn split_tree_seed(seed : (String, Int)) : TreeF(String, (String, Int)) = match seed of { (name, depth) => if depth <= 0 then LeafF(name) else BranchF((concat(name, "L"), depth - 1), (concat(name, "R"), depth - 1)) }
-- fn main() = ana(split_tree_seed, map_layer, embed, ("x", 1))
-- ```
-- ```output
-- Branch(Leaf(xL), Leaf(xR))
-- ```
pub fn ana(
  coalgebra : (seed) -> seed_layer ! {| e},
  map_layer : ((seed) -> r ! {| e}, seed_layer) -> recursive_layer ! {| e},
  embed : (recursive_layer) -> r,
  seed : seed
) : r ! { | e} =
  embed(
      map_layer(
          \(next) -> ana(coalgebra, map_layer, embed, next),
          coalgebra(seed),
        ),
    )

-- | Fold bottom-up while retaining each original child beside its folded
-- answer. The algebra receives `(original, answer)` at every recursive
-- position, so it can reuse, inspect, or return an untouched subtree.
--
-- This string-carrying lambda term returns the original argument whenever an
-- application has the literal identity function on its left.
--
-- ```prism
-- # type Term = Var(String) | App(Term, Term) | Lam(String, Term)
-- # type TermF(r) = VarF(String) | AppF(r, r) | LamF(String, r)
-- # fn project(t : Term) : TermF(Term) = match t of { Var(x) => VarF(x), App(f, x) => AppF(f, x), Lam(x, body) => LamF(x, body) }
-- # fn embed(layer : TermF(Term)) : Term = match layer of { VarF(x) => Var(x), AppF(f, x) => App(f, x), LamF(x, body) => Lam(x, body) }
-- # fn map_layer(f : (r) -> s ! {| e}, layer : TermF(r)) : TermF(s) ! {| e} =
-- #   match layer of
-- #     VarF(x) => VarF(x)
-- #     AppF(l, r) =>
-- #       let l1 = f(l)
-- #       let r1 = f(r)
-- #       AppF(l1, r1)
-- #     LamF(x, body) => LamF(x, f(body))
-- # fn simplify(layer : TermF((Term, Term))) : Term =
-- #   match layer of
-- #     VarF(x) => Var(x)
-- #     LamF(x, (_old, body)) => Lam(x, body)
-- #     AppF((old_f, f), (_old_x, x)) =>
-- #       match old_f of
-- #         Lam(name, Var(body_name)) => if name == body_name then x else App(f, x)
-- #         _ => App(f, x)
-- fn main() =
--   para(project, map_layer, simplify, App(Lam("x", Var("x")), App(Var("f"), Var("y"))))
-- ```
-- ```output
-- App(Var(f), Var(y))
-- ```
pub fn para(
  project : (r) -> recursive_layer,
  map_layer : ((r) -> (r, a) ! {| e}, recursive_layer) -> paired_layer ! {| e},
  algebra : (paired_layer) -> a ! {| e},
  value : r
) : a ! { | e} =
  algebra(
      map_layer(
          \(child) -> (child, para(project, map_layer, algebra, child)),
          project(value),
        ),
    )

-- | Unfold a seed and fold each produced layer directly, without allocating an
-- intermediate recursive value. For pure callbacks this equals materializing
-- with `ana` and consuming with `cata`; effects retain the explicit mapper's
-- order and are not a general fusion law.
--
-- This monomorphic string-carrying lambda base functor builds nested lambdas
-- conceptually and counts their nodes without ever constructing a `Term`.
--
-- ```prism
-- # type TermF(r) = VarF(String) | AppF(r, r) | LamF(String, r)
-- # fn map_layer(f : (r) -> s ! {| e}, layer : TermF(r)) : TermF(s) ! {| e} =
-- #   match layer of
-- #     VarF(x) => VarF(x)
-- #     AppF(l, r) =>
-- #       let l1 = f(l)
-- #       let r1 = f(r)
-- #       AppF(l1, r1)
-- #     LamF(x, body) => LamF(x, f(body))
-- # fn nested_lambdas(depth : Int) : TermF(Int) = if depth <= 0 then VarF("x") else LamF("x", depth - 1)
-- # fn count_layer(layer : TermF(Int)) : Int = match layer of { VarF(_) => 1, AppF(l, r) => 1 + l + r, LamF(_, body) => 1 + body }
-- fn main() = hylo(nested_lambdas, map_layer, count_layer, 3)
-- ```
-- ```output
-- 4
-- ```
pub fn hylo(
  coalgebra : (seed) -> seed_layer ! {| e},
  map_layer : ((seed) -> a ! {| e}, seed_layer) -> answer_layer ! {| e},
  algebra : (answer_layer) -> a ! {| e},
  seed : seed
) : a ! { | e} =
  algebra(
      map_layer(
          \(next) -> hylo(coalgebra, map_layer, algebra, next),
          coalgebra(seed),
        ),
    )
