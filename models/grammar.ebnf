(* Canonical Prism surface grammar.

   This is hand-written documentation that mirrors the real parser in
   crates/prism-syntax/src/grammar.lalrpop (terminal spellings from
   crates/prism-syntax/src/lex/token.rs, AST node names from
   crates/prism-syntax/src/ast.rs). Its keyword coverage is machine-checked:
   a test (tests/language/grammar_ebnf.rs) fails if the lexer defines a reserved word
   this file never mentions as a terminal. Structure and precedence are not
   checked, so treat the lalrpop file as authoritative for fine precedence
   detail where the two ever disagree. The reference manual (docs/src/spec.md) renders the sections below
   by mdbook anchor include, so this file is the one place each rule lives.

   Layout / offside: the lexer feeds the parser, then an offside pass inserts the
   virtual layout tokens vopen (v{), vclose (v}) and vsep (v;) around and between
   items that share an indentation column. They are the only way blocks and
   statement separators are formed; there are no literal braces for blocks
   (record / handler / match braces are real { }). A vsep between two constructs
   is a newline at the same column, and vopen ... vclose is an indented region. *)

(* ANCHOR: notation *)
x  y      juxtaposition: x followed by y
x | y     alternative: x or y
[ x ]     option: zero or one x
{ x }     repetition: zero or more x
( x )     grouping
"fn"      a terminal (literal token), in double quotes
varid     a nonterminal, in lower case
x , ...   a comma-separated list of one or more x
(* ANCHOR_END: notation *)

(* ANCHOR: lexical *)
varid    ->  (lower | "_") { idchar }
conid    ->  upper { idchar }
qualid   ->  conid "." ident { "." ident }
ident    ->  varid | conid
idchar   ->  letter | digit | "_"

integer  ->  digits [ "i64" | "u64" ]
float    ->  digits "." digits [ exponent ]
          |  digits exponent
exponent ->  ( "e" | "E" ) [ "+" | "-" ] digits
-- A digit separator "_" is admissible only flanked by two digits, so leading,
-- trailing, doubled, and adjacent-to-"."/"e" separators are rejected. Exponent
-- notation always denotes a float; the exponent sign lives in the lexer and does
-- not collide with the unary-minus operator.
digits   ->  digit { [ "_" ] digit }
char     ->  "'" ( graphic | escape | "\\'" ) "'"
string   ->  cooked | raw
cooked   ->  "\"" { strchar | escape | interp } "\""
interp   ->  "{" expr "}"
escape   ->  "\\" ( "n" | "t" | "r" | "\\" | "{" | "}" | "\"" )
comment  ->  "--" { any character other than newline }

-- A raw string spans lines and takes its body verbatim: no escapes, no
-- interpolation, and no way to write the closing delimiter inside it. The
-- newline each delimiter sits against is not part of the text, and the
-- indentation every non-blank line shares is the source's, not the string's.
raw      ->  "r\"\"\"" { any character, up to the first "\"\"\"" } "\"\"\""

-- An interpolated string "a{e}b{e}c" is lexed into the pieces below, each
-- carrying its literal segment; the holes are re-lexed as expressions.
istart   ->  "\"" { strchar } "{"
imid     ->  "}" { strchar } "{"
iend     ->  "}" { strchar } "\""

-- Virtual layout tokens, synthesized by the offside pass; no source spelling.
vopen    ->  "v{"   -- start of an indented block
vclose   ->  "v}"   -- end of an indented block
vsep     ->  "v;"   -- a newline at the same column (item / statement separator)
(* ANCHOR_END: lexical *)

(* ANCHOR: program *)
program   ->  { topdecl }                       -- separated by layout

topdecl   ->  [ deprecated ] [ "pub" ] item
           |  [ deprecated ] "opaque" ( datatype | newtype )
deprecated -> "deprecated" string               -- annotation line: marks the next item superseded ("deprecated" is contextual, not reserved)
item      ->  import | datatype | newtype | synonym | rowalias
           |  classdecl | instancedecl | canonicaldecl | effectdecl
           |  errordecl | patterndecl | stabledecl | constdecl | fundecl

import    ->  "import" modpath [ "as" conid ]
                [ "(" ( [ name , ... ] | ".." ) ")" ]
modpath   ->  conid { "." conid }
name      ->  varid | conid

datatype  ->  "type" conid [ kindedvars ] "=" ctorsrhs
newtype   ->  "newtype" conid [ tyvars ] "=" ctor [ deriving ]
synonym   ->  "alias" conid [ tyvars ] "=" type
rowalias  ->  "alias" conid "=" "{" [ label , ... ] "}"
tyvars    ->  "(" varid , ... ")"
kindedvars -> "(" tyvar , ... ")"               -- a data-type parameter may carry a kind
tyvar     ->  varid [ ":" kind ]
kind      ->  "Type" | "Row" | "Nat"            -- "Row" ranges over an effect row, "Nat" over a dimension
ctorsrhs  ->  ctor { "|" ctor } [ deriving ]
           |  vopen ctor { [ vsep ] "|" ctor } [ [ vsep ] deriving ] vclose
ctor      ->  conid [ "(" typearg , ... ")" ]
           |  conid "{" [ field , ... ] "}"
field     ->  varid ":" type
deriving  ->  "deriving" "(" [ conid , ... ] ")"

constdecl ->  "let" varid [ ":" type ] "=" body
fundecl   ->  [ "logic" ] [ "test" ] [ [ "assume" ] "total" ] [ "replayable" ] [ "fip" | "fbip" ]
                "fn" varid "(" [ param , ... ] ")"
                [ retann ] [ given ] { requires } { ensures } [ decreases ] "=" body [ wheres ]
                -- a usage row spelling exactly "@ noalloc" at the root of the
                -- return annotation is the declaration's allocation certificate;
                -- "logic fn" is a proof-level (SMT) declaration, never a runtime fn;
                -- "test" and "total"/"assume" are contextual
                -- declaration modifiers, not reserved words, so all three stay
                -- usable as ordinary identifiers everywhere else
param     ->  [ "borrow" ] pattern [ ":" type ] [ ":=" expr ]
                -- a bare varid (or "_") is the ordinary named parameter and binds
                -- without testing; any other pattern is matched around the body and
                -- must be irrefutable, so it has no name to pass by keyword
retann    ->  ":" type [ decleff ]              -- result first, e.g. `: Int ! {State}`
decleff   ->  "!" "{" [ label , ... ] [ "|" varid ] "}"
           |  "!"                                -- an explicit empty effect row
given     ->  "given" constraint , ...
requires  ->  "requires" expr                    -- an SMT precondition clause
ensures   ->  "ensures" "|" varid "|" expr       -- an SMT postcondition over the result binder
decreases ->  "decreases" expr                    -- contextual; a ranking measure for a total fn
constraint -> conid "(" type ")"
wheres    ->  "where" vopen [ wherebind { vsep wherebind } ] vclose
wherebind ->  varid "=" body
(* ANCHOR_END: program *)

(* ANCHOR: decls *)
-- Class, instance, and effect bodies are layout blocks (no `where`, no braces):
-- the head ends the line and the members follow on indented lines. A brace here
-- is a parse error. A marker class or its instance has no members, so the body is
-- absent and the declaration is its bare head.
classdecl    ->  "class" conid "(" varid ")" [ given ] [ vopen [ sig { armsep sig } ] vclose ]
instancedecl ->  "instance" varid ":" conid "(" type ")" [ given ]
                   [ vopen [ fundecl { armsep fundecl } ] vclose ]
canonicaldecl -> "canonical" conid "(" type ")" "=" varid
sig          ->  varid ":" type

effectdecl   ->  "effect" conid [ tyvars ] vopen [ effop { armsep effop } ] vclose
effop        ->  [ grade ] varid "(" [ effparam , ... ] ")" ":" type
effparam     ->  type | varid ":" type             -- a binder name is accepted but not retained
grade        ->  "many" | "once" | "never"        -- many is the unmarked default
armsep       ->  "," | vsep
errordecl    ->  "error" conid [ "(" typearg , ... ")" ]

patterndecl  ->  "pattern" conid "(" [ varid , ... ] ")" "for" conid "=" patclauses
patclauses   ->  patclause | vopen patclause { vsep patclause } [ vsep ] vclose
patclause    ->  ( "view" | "make" ) expr

-- A `stable` block declares a serializable type's frozen version history:
-- the rungs and migration routes, plus hand-written converters for the type
-- mutations the compiler cannot generate. Real braces, so entries are
-- comma-separated. "frozen", "upgrade", "downgrade", and "drop_loss" are
-- contextual, recognized positionally inside the block rather than reserved.
stabledecl   ->  "stable" conid "{" [ stableitem , ... ] "}"
stableitem   ->  rung | converter | migrations
rung         ->  conid "=" "{" [ ".." conid { "," rungfield }
                                | rungfield { "," rungfield } ] "}" [ "frozen" string ]
rungfield    ->  varid ":" type [ "=" expr ]     -- an additive field carries a default
converter    ->  ( "upgrade" | "downgrade" ) conid "->" conid "="
                   "{" ".." expr { "," varid "=" expr } "}" [ "drop_loss" "(" [ varid , ... ] ")" ]
migrations   ->  "migrations" "{" { migration } "}"
migration    ->  conid "->" conid "=" migrateroute
migrateroute ->  "auto"
              |  "version" "(" "upgrade" "=" migdir ","
                   "downgrade" "=" migdir [ "," ] ")"
migdir       ->  expr                                -- a bare varid `auto` is normalized to the derived route
(* ANCHOR_END: decls *)

(* ANCHOR: types *)
type    ->  "forall" varid { varid } "." type
         |  funarrow [ row ]                    -- row applies only to a function type
         |  utype
arrow   ->  funarrow | utype
funarrow -> "(" [ type , ... ] ")" "->" arrow   -- n-ary domain
          | utype "->" arrow                    -- single domain
utype   ->  atype [ "@" usagerow ]              -- usage (coeffect) row on an atomic type
usagerow -> varid                               -- single-fact sugar: T @ noalloc
         |  "{" varid , ... "}"                 -- fact set, canonical order alphabetical
                                                    -- an open `@ {fact | tail}` is reserved but rejected
atype   ->  scalar
         |  "[" type "]"                          -- List(type)
         |  ( conid | qualid ) [ "(" typearg , ... ")" ] -- type constructor
         |  varid [ "(" typearg , ... ")" ]       -- variable, possibly applied
         |  "(" type ")"
         |  "(" type "," [ type , ... ] ")"       -- tuple (including a one-tuple)
         |  "#" "(" [ type , ... ] ")"            -- unboxed tuple
         |  "#" "{" [ field , ... ] "}"           -- unboxed record
typearg ->  type
         |  rowlit                                -- argument for a Row-kinded parameter
         |  digits                                 -- dimension literal for a Nat-kinded parameter, e.g. Vec(Int, 3)
rowlit  ->  "{" [ label , ... ] [ "|" varid ] "}" -- effect-row literal, e.g. Cmd(Int, {IO})
scalar  ->  "Int" | "I64" | "U64" | "Bool" | "Unit" | "Float" | "Char" | "String"

row     ->  "!" "{" [ label , ... ] [ "|" varid ] "}"
         |  "!"                                   -- empty row, effectful position
label   ->  ( varid | conid | qualid ) [ "(" typearg , ... ")" ]
(* ANCHOR_END: types *)

(* ANCHOR: expr *)
body    ->  expr | block
block   ->  vopen stmts vclose
stmts   ->  expr
         |  expr vsep stmts
         |  "if" expr "then" body { [ vsep ] "elif" expr "then" body }
                [ vsep stmts ]                       -- an open if need not have an else
         |  "let" varid "=" expr [ "in" ] vsep stmts
         |  "let" varid "=" block vsep stmts
         |  "let" letpat "=" expr [ "in" ] vsep stmts
         |  "let" letpat "=" block vsep stmts
         |  "let" letpat "=" expr [ vsep ] "else" body vsep stmts
         |  "let" letpat "=" block vsep "else" body vsep stmts
         |  "var" varid [ ":" type ] ":=" expr vsep stmts
         |  "with" [ varid "<-" ] "handler" handler vsep stmts
         |  "with" [ varid "<-" ] appexpr vsep stmts

expr    ->  "if" expr "then" body { [ vsep ] "elif" expr "then" body }
                [ vsep ] "else" body
         |  "let" ( varid | letpat ) "=" expr "in" expr
         |  "\\" "(" [ param , ... ] ")" "->" expr  -- lambda
         |  "match" expr "of" matcharms
         |  "handle" expr "with" [ "partial" ] handler
         |  "throw" conid [ "(" expr , ... ")" ]
         |  "try" body [ vsep ] "catch" catcharms
         |  "transact" body [ vsep ] "else" body
         |  "for" gen { "," qual } "do" body
         |  "while" expr "do" body                    -- while loop
         |  "loop" body                               -- unconditional loop
         |  "probe" string "do" body                  -- named instrumentation; body runs only when enabled
         |  "reflect" ( "fn" | "type" ) ( ident | qualid ) -- quote a declaration of this file as a string
         |  "return" expr                             -- early return
         |  lvalue ":=" expr                          -- assignment
         |  lvalue ( "+=" | "-=" | "*=" | "%=" ) expr  -- compound assignment
         |  opexpr

opexpr  ->  opexpr binop opexpr                      -- binop and binding per 4.1
         |  negexpr
negexpr ->  "-" negexpr                              -- unary minus, "tight prefix":
                                                     -- looser than application and
                                                     -- exponentiation, tighter than the
                                                     -- remaining binops
         |  powexpr
powexpr ->  appexpr [ "^" negexpr ]                  -- exponentiation is right-associative
appexpr ->  appexpr "(" [ arg , ... ] [ "using" iname , ... ] ")"
                                                     -- application; `using` selects instances
         |  appexpr "(" [ arg , ... ] ")" "fn" trailerparams block
                                                     -- trailing lambda argument
         |  appexpr "[" expr [ "," expr , ... ] "]" -- indexed or multi-indexed read
         |  appexpr "." varid                         -- field access
         |  appexpr "." "#" varid                    -- unboxed-field access
         |  appexpr "." "[" path "]"                -- collect a path's foci
         |  appexpr "." varid "(" [ expr , ... ] ")" -- method call (UFCS)
         |  appexpr "." varid "(" [ expr , ... ] ")" "fn" trailerparams block
         |  appexpr "." varid "fn" trailerparams block
         |  appexpr "?." varid                        -- optional chaining
         |  appexpr "?"                               -- try marker
         |  atom
arg     ->  [ varid ":=" ] expr                      -- an argument may be passed by name
iname   ->  varid                                     -- an instance name
trailerparams -> [ "(" param { "," param } ")" ]
atom    ->  integer | float | char | string | "true" | "false" | "(" ")"
         |  "break" | "continue"                      -- loop control
         |  "?" varid                                  -- named typed hole
         |  "error" "(" [ expr , ... ] ")"           -- the panic builtin remains callable
         |  varid | conid | qualid
         |  "(" expr ")" | "(" expr ":" type ")"
         |  "(" expr "," [ expr , ... ] ")"           -- tuple (including a one-tuple)
         |  "#" "(" [ expr , ... ] ")"                -- unboxed tuple
         |  "#" "{" [ fieldval , ... ] "}"            -- unboxed record
         |  "[" [ expr , ... ] "]"                    -- list
         |  "[" expr { "," expr } ".." expr "]"      -- arithmetic range
         |  "[" expr "for" gen { "," qual } "]"       -- comprehension
         |  conid "{" [ fieldval , ... ] "}"          -- record
         |  conid "{" ".." expr { "," fieldval } "}" -- record update
         |  "{" expr "|" pathupdate , ... "}"        -- path update
         |  "#" "path" ( varid { "." varid }
                         | conid "." varid { "." varid } ) -- path literal; an uppercase head anchors its type
         |  "mask" "<" conid ">" "(" expr ")"

arm      ->  pattern [ "if" expr ] "=>" body
matcharms -> "{" [ arm { armsep arm } ] "}"
           | vopen [ arm { armsep arm } ] vclose
gen      ->  varid "in" expr
qual     ->  "if" expr | "let" varid "=" expr
fieldval ->  varid "=" expr                          -- a record field binding
path     ->  pathseg { "." pathseg }                 -- a nested field path
pathseg  ->  varid | "each" | "?" ( conid | qualid ) -- field step, bulk map over a collection, or case-narrowing step
          |  pathseg "[" expr "]"                      -- indexed step
          |  "(" path "where" expr ")"                 -- filtered traversal
          |  "[" expr "]" { "[" expr "]" }            -- a path may begin with an index
pathupdate -> path ( "=" | "~" | "+=" | "-=" | "*=" | "%=" ) expr
lvalue   ->  varid { "." varid | "[" expr [ "," expr , ... ] "]" }
          |  "get" "(" ")" ( "." varid | "[" expr [ "," expr , ... ] "]" )
                { "." varid | "[" expr [ "," expr , ... ] "]" }
binop    ->  "??" | "|>" | ">>" | "<<" | "||" | "&&" -- binding given in 4.1
         |  "==" | "/=" | "<" | "<=" | ">" | ">="
         |  "+" | "-" | "*" | "/" | "%"
(* ANCHOR_END: expr *)

(* ANCHOR: pattern *)
pattern  ->  patalt { "|" patalt }                   -- alternation: any alternative matches
patalt   ->  conid [ "(" pattern , ... ")" ]         -- constructor
          |  qualid [ "(" pattern , ... ")" ]        -- qualified constructor
          |  conid "{" [ fieldpat { "," fieldpat } [ "," ".." ] | ".." ] "}"
                                                       -- record fields may pun; ".." is trailing
          |  varid                                    -- variable binding
          |  "_"                                      -- wildcard
          |  integer | float | char | "true" | "false"
          |  "-" ( integer | float )                  -- negative literal

          |  "[" [ pattern , ... ] "]"                -- list
          |  "(" pattern "," [ pattern , ... ] ")"   -- tuple (including a one-tuple)
fieldpat ->  varid [ "=" pattern ]                    -- a bare field is a pun
letpat   ->  ( conid | qualid ) [ "(" pattern , ... ")" ] -- a `let` destructures with a
          |  "(" pattern "," [ pattern , ... ] ")"   -- constructor or tuple pattern only,
                                                     -- and admits no alternation; it may
                                                     -- be refutable only under `else`
(* ANCHOR_END: pattern *)

(* ANCHOR: handler *)
handler   ->  "{" [ hclause , ... ] "}"
           |  vopen [ hclause { armsep hclause } ] vclose

hclause   ->  "return" varid "=>" body                 -- result transform
           |  varid "(" [ varid , ... ] ")" "resume" varid "=>" body  -- multishot op: continuation after `resume`
           |  "once" varid "(" [ varid , ... ] ")" "=>" body -- tail-resumptive sugar
           |  "never" varid "(" [ varid , ... ] ")" "=>" body -- non-resumable
           |  "val" varid "=" body                     -- install-time constant

catcharm  ->  conid [ "(" varid , ... ")" ] "=>" body
catcharms ->  "{" [ catcharm , ... ] "}"
            | vopen [ catcharm { armsep catcharm } ] vclose
(* ANCHOR_END: handler *)
