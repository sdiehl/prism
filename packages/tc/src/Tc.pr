-- | The type-and-row core of a Prism typechecker, written in Prism.
--
-- This library is the Prism-written type-and-row heart of the shadow checker:
-- the type, row, scheme, and error ADTs, the free-variable collectors, rigid
-- substitution with composition, metavariable zonking, row normalization, type
-- and row unification with occurs checks, and generalization and
-- instantiation. The grammar mirrors the statics sketch: value types and
-- computation types are split in the call-by-push-value style, a computation
-- is a returned value with an effect row or a function into a computation, and
-- rows are unordered sets of distinct labels over a closed, rigid, or
-- metavariable tail.
--
-- Identities follow the front end's discipline: rigid type and row variables
-- are branded `Data.Name` identities minted by resolution, never spellings,
-- and metavariable classes live in a payload-carrying union-find, so solving a
-- class solves every alias of it. The solver is written in the effects style:
-- `Control.Solve` carries fresh-meta allocation, substitution lookup, and
-- class joining as one effect, discharged once at `run_tc` together with the
-- aborting refusal, so every rule below reads as direct style and the
-- structural operations stay pure.
--
-- ```prism
-- # import Control.Solve (..)
-- fn demo() : String ! {Solve(Sol), TcFail} =
--   let m = fresh_ty_meta()
--   unify_v(v_fun([VInt], c_ret(m, row_closed([label0("IO")]))), v_fun([VInt], c_ret(VBool, row_closed([label0("IO")]))))
--   show_vty(zonk_v(m))
--
-- fn main() =
--   match run_tc(\() -> demo()) of
--     Ok(shown) => println(shown)
--     Err(_e) => println("no")
-- ```
-- ```output
-- Bool
-- ```

import Control.Solve (Solve, eval_solve, sv_assign, sv_equiv, sv_fresh, sv_root, sv_solution, sv_union)
import Control.Fresh (Fresh)
import Data.Name (Name, Binder, fresh_binder, bound_name, name_id)
import Data.List (map, reverse, foldl, append, filter)
import Data.Map (map_empty, map_lookup, map_insert, map_to_list)
import Data.Set (set_insert, set_member)

-- The two rigid-variable namespaces, branded so a type identity can never
-- stand where a row identity belongs.

-- | The brand for rigid type-variable identities. A marker type carries no
-- instances of its own; the payload's instances do the work.
-- lint: allow(L0203)
pub type TyVarSpace = TyVarTag

-- | The brand for rigid row-variable identities, distinct from the type-
-- variable brand so the two can never be confused.
-- lint: allow(L0203)
pub type RowVarSpace = RowVarTag

-- Value types, computation types, and rows, in the statics sketch's grammar.

-- | A value type: the primitives, a saturated constructor application, a
-- tuple, a thunked computation, a rigid variable, or a metavariable class.
pub type VTy
  = VInt
  | VFloat
  | VBool
  | VUnit
  | VString
  | VCon(String, List(VTy))
  | VTuple(List(VTy))
  | VThunk(CTy)
  | VVar(Name(TyVarSpace))
  | VMeta(Int)
  deriving (Eq, Show)

-- | A computation type: a value returned against an effect row, or a
-- function from value types into a further computation.
pub type CTy = CRet(VTy, Row) | CFun(List(VTy), CTy) deriving (Eq, Show)

-- | An effect label: a name applied to value-type arguments.
pub type Label = Label { name: String, args: List(VTy) } deriving (Eq, Show)

-- | A row tail: closed, a rigid row variable, or a row metavariable.
pub type Tail
  = TailClosed
  | TailVar(Name(RowVarSpace))
  | TailMeta(Int)
  deriving (Eq, Show)

-- | An effect row: labels over a tail. `row_normalize` is the canonical form;
-- every function below that consumes a row normalizes first.
pub type Row = Row { labels: List(Label), tail: Tail } deriving (Eq, Show)

-- | A polymorphic scheme: rigid type and row binders over a value type.
pub type Scheme = Scheme {
  tyvars: List(Binder(TyVarSpace)),
  rowvars: List(Binder(RowVarSpace)),
  body: VTy
} deriving (Eq, Show)

-- | Why checking refused.
pub type TcError
  = Mismatch(String, String)
  | RowMismatch(String, String)
  | OccursV(Int, String)
  | OccursRow(Int, String)
  | DuplicateLabel(String)
  deriving (Eq, Show)

-- | The aborting refusal effect: `tc_fail` abandons the current check with a
-- structured `TcError`, and `run_tc` turns the abandonment into an `Err`.
pub effect TcFail
  never tc_abort(TcError) : a

-- | Abandon the current check with a structured error.
pub fn tc_fail(e : TcError) : a ! {TcFail} = tc_abort(e)

-- Constructor conveniences the rules read naturally through.

-- | The thunked function type taking `params` to the computation `body`.
pub fn v_fun(params : List(VTy), body : CTy) : VTy = VThunk(CFun(params, body))

-- | The computation returning `v` while performing the effects in `r`.
pub fn c_ret(v : VTy, r : Row) : CTy = CRet(v, r)

-- | An effect label with no type arguments.
pub fn label0(name : String) : Label = Label { name = name, args = [] }

-- | The row of exactly `labels`, admitting no further effects.
pub fn row_closed(labels : List(Label)) : Row =
  Row { labels = labels, tail = TailClosed }

-- | The row of `labels` over `tail`, open to whatever the tail admits.
pub fn row_open(labels : List(Label), tail : Tail) : Row =
  Row { labels = labels, tail = tail }

-- The solver: type and row metavariable classes in one forest behind the
-- `Solve` effect, sharing one key supply. Every class root owns its solution
-- knowledge; `run_tc` installs the join policy once, at the checking region's
-- edge, so no rule below ever names the forest.

-- | What a metavariable class knows: nothing yet, or its solution.
pub type Sol
  = TyUnsolved
  | TySolved(VTy)
  | RowUnsolved
  | RowSolved(Row)
  deriving (Eq, Show)

-- | Run a checking computation against a fresh solver, catching refusals.
pub fn run_tc(action : () -> a ! {Solve(Sol), TcFail | e}) : Result(a, TcError) ! { | e} =
  run_tc_with(merge_sol, action)

-- | `run_tc` with an explicit join policy: the solver strategy is the
-- handler, so a different `combine` swaps the strategy without touching a
-- single rule.
pub fn run_tc_with(
  combine : (Sol, Sol) -> Sol,
  action : () -> a ! {Solve(Sol), TcFail | e}
) : Result(a, TcError) ! { | e} =
  handle eval_solve(combine, action) with
    never tc_abort(err) => Err(err)
    return v => Ok(v)

-- | The default join policy: keep whichever side knows a solution. Type and
-- row classes never meet, because unions are only ever taken within one kind.
pub fn merge_sol(kept : Sol, lost : Sol) : Sol =
  match (kept, lost) of
    (TyUnsolved, other) => other
    (RowUnsolved, other) => other
    (k, _lost) => k

-- | Allocate an unsolved type metavariable.
pub fn fresh_ty_meta() : VTy ! {Solve(Sol)} = VMeta(sv_fresh(TyUnsolved))

-- | Allocate an unsolved row metavariable, ready to stand as a row tail.
pub fn fresh_row_meta() : Tail ! {Solve(Sol)} = TailMeta(sv_fresh(RowUnsolved))

fn ty_solution(a : Int) : Option(VTy) ! {Solve(Sol)} =
  match sv_solution(a) of
    Some(TySolved(t)) => Some(t)
    _ => None

fn row_solution(a : Int) : Option(Row) ! {Solve(Sol)} =
  match sv_solution(a) of
    Some(RowSolved(r)) => Some(r)
    _ => None

-- Zonking: chase every solved metavariable to its current knowledge. Zonking
-- twice is the same as zonking once, because a zonked term contains only
-- unsolved roots.

-- | Chase every solved metavariable in a value type to its solution.
pub fn zonk_v(ty : VTy) : VTy ! {Solve(Sol)} =
  match ty of
    VMeta(a) =>
      let r = sv_root(a)
      match ty_solution(r) of
        None => VMeta(r)
        Some(t) => zonk_v(t)
    VCon(name, args) => VCon(name, zonk_each(args))
    VTuple(items) => VTuple(zonk_each(items))
    VThunk(c) => VThunk(zonk_c(c))
    other => other

fn zonk_each(tys : List(VTy)) : List(VTy) ! {Solve(Sol)} =
  match tys of
    Nil => Nil
    Cons(t, rest) => Cons(zonk_v(t), zonk_each(rest))

-- | Chase every solved metavariable in a computation type to its solution.
pub fn zonk_c(c : CTy) : CTy ! {Solve(Sol)} =
  match c of
    CRet(v, r) => CRet(zonk_v(v), zonk_row(r))
    CFun(params, body) => CFun(zonk_each(params), zonk_c(body))

-- | Chase every solved metavariable in a row to its solution, splicing the
-- labels a solved tail carries into the row.
pub fn zonk_row(r : Row) : Row ! {Solve(Sol)} =
  match r.tail of
    TailMeta(a) =>
      let root = sv_root(a)
      match row_solution(root) of
        None => Row { labels = zonk_labels(r.labels), tail = TailMeta(root) }
        Some(solved) =>
          let deeper = zonk_row(solved)
          Row {
            labels = append(zonk_labels(r.labels), deeper.labels),
            tail = deeper.tail
          }
    _ => Row { labels = zonk_labels(r.labels), tail = r.tail }

fn zonk_labels(ls : List(Label)) : List(Label) ! {Solve(Sol)} =
  match ls of
    Nil => Nil
    Cons(l, rest) =>
      Cons(Label { name = l.name, args = zonk_each(l.args) }, zonk_labels(rest))

-- Rigid substitution: finite maps from rigid identities to types and rows,
-- with application and composition. This is the instrument of instantiation;
-- metavariable solving goes through the forests above instead.

-- | A rigid substitution: finite maps from rigid type and row identities to
-- the types and rows they stand for.
-- lint: allow(L0203)
pub type Subst = Subst {
  tys: Map(Name(TyVarSpace), VTy),
  rows: Map(Name(RowVarSpace), Row)
}

-- | The substitution that maps nothing.
pub let subst_empty : Subst = Subst { tys = map_empty, rows = map_empty }

-- | Extend a substitution so the rigid type variable `v` stands for `t`.
pub fn subst_ty(s : Subst, v : Name(TyVarSpace), t : VTy) : Subst =
  { s | tys = map_insert(v, t, s.tys) }

-- | Extend a substitution so the rigid row variable `v` stands for `r`.
pub fn subst_row(s : Subst, v : Name(RowVarSpace), r : Row) : Subst =
  { s | rows = map_insert(v, r, s.rows) }

-- | Apply a substitution to a value type.
pub fn apply_v(s : Subst, ty : VTy) : VTy =
  match ty of
    VVar(v) =>
      match map_lookup(v, s.tys) of
        Some(t) => t
        None => ty
    VCon(name, args) => VCon(name, map(\(t) -> apply_v(s, t), args))
    VTuple(items) => VTuple(map(\(t) -> apply_v(s, t), items))
    VThunk(c) => VThunk(apply_c(s, c))
    other => other

-- | Apply a substitution to a computation type.
pub fn apply_c(s : Subst, c : CTy) : CTy =
  match c of
    CRet(v, r) => CRet(apply_v(s, v), apply_row(s, r))
    CFun(params, body) =>
      CFun(map(\(t) -> apply_v(s, t), params), apply_c(s, body))

-- | Apply a substitution to a row, growing it with whatever labels a mapped
-- tail brings.
pub fn apply_row(s : Subst, r : Row) : Row =
  let applied = map(\(l) -> apply_label(s, l), r.labels)
  match r.tail of
    TailVar(v) =>
      match map_lookup(v, s.rows) of
        Some(grown) =>
          Row { labels = append(applied, grown.labels), tail = grown.tail }
        None => Row { labels = applied, tail = r.tail }
    _ => Row { labels = applied, tail = r.tail }

fn apply_label(s : Subst, l : Label) : Label =
  Label { name = l.name, args = map(\(t) -> apply_v(s, t), l.args) }

-- | The substitution equal to applying `first` and then `second`.
pub fn subst_compose(second : Subst, first : Subst) : Subst =
  Subst { tys = compose_tys(second, first), rows = compose_rows(second, first) }

fn compose_tys(second : Subst, first : Subst) : Map(Name(TyVarSpace), VTy) =
  let mapped = ct_mapped(second, map_to_list(first.tys), map_empty)
  ct_keep(first, map_to_list(second.tys), mapped)

fn ct_mapped(
  second : Subst,
  entries : List((Name(TyVarSpace), VTy)),
  acc : Map(Name(TyVarSpace), VTy)
) : Map(Name(TyVarSpace), VTy) =
  match entries of
    Nil => acc
    Cons((v, t), rest) =>
      ct_mapped(second, rest, map_insert(v, apply_v(second, t), acc))

fn ct_keep(
  first : Subst,
  entries : List((Name(TyVarSpace), VTy)),
  acc : Map(Name(TyVarSpace), VTy)
) : Map(Name(TyVarSpace), VTy) =
  match entries of
    Nil => acc
    Cons((v, t), rest) =>
      match map_lookup(v, first.tys) of
        Some(_shadowed) => ct_keep(first, rest, acc)
        None => ct_keep(first, rest, map_insert(v, t, acc))

fn compose_rows(second : Subst, first : Subst) : Map(Name(RowVarSpace), Row) =
  let mapped = cr_mapped(second, map_to_list(first.rows), map_empty)
  cr_keep(first, map_to_list(second.rows), mapped)

fn cr_mapped(
  second : Subst,
  entries : List((Name(RowVarSpace), Row)),
  acc : Map(Name(RowVarSpace), Row)
) : Map(Name(RowVarSpace), Row) =
  match entries of
    Nil => acc
    Cons((v, r), rest) =>
      cr_mapped(second, rest, map_insert(v, apply_row(second, r), acc))

fn cr_keep(
  first : Subst,
  entries : List((Name(RowVarSpace), Row)),
  acc : Map(Name(RowVarSpace), Row)
) : Map(Name(RowVarSpace), Row) =
  match entries of
    Nil => acc
    Cons((v, r), rest) =>
      match map_lookup(v, first.rows) of
        Some(_shadowed) => cr_keep(first, rest, acc)
        None => cr_keep(first, rest, map_insert(v, r, acc))

-- Free variables: rigid identities and metavariable ids, collected in
-- first-occurrence order without duplicates.

-- The collector answers membership from an ordered set and keeps the ids it
-- has admitted in reverse first-occurrence order beside it. A bare list would
-- answer membership by scanning and admit a new id by copying every cell
-- already collected, which is quadratic in the metas one type mentions.
--
-- The set's brand is written rather than left open. A set's representation
-- depends on the ordering it was built under, and this one is stored in a
-- named carrier instead of flowing through a signature, so the ordering is
-- fixed once here rather than chosen afresh at each use.
type Seen = Seen { member: Map(Int, Unit, Canonical), order: List(Int) }

fn seen_empty() : Seen = Seen { member = map_empty, order = [] }

fn add_int(seen : Seen, x : Int) : Seen =
  if set_member(x, seen.member) then
    seen
  else
    Seen { member = set_insert(x, seen.member), order = Cons(x, seen.order) }

-- | The ids admitted, restored to first-occurrence order.
fn seen_ids(seen : Seen) : List(Int) = reverse(seen.order)

fn elem_int(xs : List(Int), x : Int) : Bool =
  match xs of
    Nil => false
    Cons(y, rest) => y == x || elem_int(rest, x)

-- Type and row classes share one solver id space, but their syntax positions
-- determine their kinds. Keep separate first-seen indexes for kind-safe
-- generalization and a third index for the legacy combined-order API.
type FreeMetas = FreeMetas { all: Seen, tys: Seen, rows: Seen }

fn free_empty() : FreeMetas =
  FreeMetas { all = seen_empty(), tys = seen_empty(), rows = seen_empty() }

fn add_ty_meta(free : FreeMetas, x : Int) : FreeMetas =
  FreeMetas {
    all = add_int(free.all, x),
    tys = add_int(free.tys, x),
    rows = free.rows
  }

fn add_row_meta(free : FreeMetas, x : Int) : FreeMetas =
  FreeMetas {
    all = add_int(free.all, x),
    tys = free.tys,
    rows = add_int(free.rows, x)
  }

-- | Every metavariable class occurring in a value type, in first-seen order
-- and without repeats. New code should prefer the kind-separated collectors.
pub fn free_metas_v(ty : VTy) : List(Int) = seen_ids(fm_v(ty, free_empty()).all)

-- | Type metavariable classes occurring in a value type, in first-seen order.
pub fn free_ty_metas_v(ty : VTy) : List(Int) = seen_ids(fm_v(ty, free_empty()).tys)

-- | Row metavariable classes occurring in a value type, in first-seen order.
pub fn free_row_metas_v(ty : VTy) : List(Int) =
  seen_ids(fm_v(ty, free_empty()).rows)

-- | Type metavariable classes occurring in a row's label arguments, in
-- first-seen order.
pub fn free_ty_metas_row(r : Row) : List(Int) =
  seen_ids(fm_row(r, free_empty()).tys)

-- | Row metavariable classes occurring in a row, in first-seen order.
pub fn free_row_metas_row(r : Row) : List(Int) =
  seen_ids(fm_row(r, free_empty()).rows)

fn fm_v(ty : VTy, acc : FreeMetas) : FreeMetas =
  match ty of
    VMeta(a) => add_ty_meta(acc, a)
    VCon(_name, args) => fm_each(args, acc)
    VTuple(items) => fm_each(items, acc)
    VThunk(c) => fm_c(c, acc)
    _ => acc

fn fm_each(tys : List(VTy), acc : FreeMetas) : FreeMetas =
  match tys of
    Nil => acc
    Cons(t, rest) => fm_each(rest, fm_v(t, acc))

fn fm_c(c : CTy, acc : FreeMetas) : FreeMetas =
  match c of
    CRet(v, r) => fm_row(r, fm_v(v, acc))
    CFun(params, body) => fm_c(body, fm_each(params, acc))

fn fm_row(r : Row, acc : FreeMetas) : FreeMetas =
  let with_labels = fm_labels(r.labels, acc)
  match r.tail of
    TailMeta(a) => add_row_meta(with_labels, a)
    _ => with_labels

fn fm_labels(ls : List(Label), acc : FreeMetas) : FreeMetas =
  match ls of
    Nil => acc
    Cons(l, rest) => fm_labels(rest, fm_each(l.args, acc))

-- Row normalization: sort the labels by name, refuse duplicates. Two
-- normalized rows are equal exactly when the rows are equivalent, which is
-- what makes the canonical form a decision procedure for the sketch's row
-- equivalence.

fn label_lt(a : Label, b : Label) : Bool = cmp(a.name, b.name) < 0

fn insert_label(l : Label, ls : List(Label)) : List(Label) =
  match ls of
    Nil => [l]
    Cons(h, rest) =>
      if label_lt(l, h) then
        Cons(l, ls)
      else
        Cons(h, insert_label(l, rest))

fn sort_labels(ls : List(Label)) : List(Label) =
  foldl(\(acc, l) -> insert_label(l, acc), Nil, ls)

fn has_dup(ls : List(Label)) : Option(String) =
  match ls of
    Nil => None
    Cons(_l, Nil) => None
    Cons(a, Cons(b, rest)) =>
      if a.name == b.name then
        Some(a.name)
      else
        has_dup(Cons(b, rest))

-- | The label ordering half of normalization, without the duplicate refusal:
-- labels sorted by name over the same tail. Rows that differ only in the order
-- their labels were written have one sorted form, so a renderer that must stay
-- pure can still print the canonical spelling.
pub fn row_sorted(r : Row) : Row =
  Row { labels = sort_labels(r.labels), tail = r.tail }

-- | The canonical form of a row: labels sorted by name, refusing a duplicate.
pub fn row_normalize(r : Row) : Row ! {TcFail} =
  let sorted = row_sorted(r)
  match has_dup(sorted.labels) of
    Some(name) => tc_fail(DuplicateLabel(name))
    None => sorted

-- Occurs checks: a metavariable class must not appear in its own solution.

fn occurs_v(a : Int, ty : VTy) : Bool ! {Solve(Sol)} =
  match zonk_v(ty) of
    VMeta(b) => sv_equiv(a, b)
    VCon(_name, args) => occurs_each(a, args)
    VTuple(items) => occurs_each(a, items)
    VThunk(c) => occurs_c(a, c)
    _ => false

fn occurs_each(a : Int, tys : List(VTy)) : Bool ! {Solve(Sol)} =
  match tys of
    Nil => false
    Cons(t, rest) => occurs_v(a, t) || occurs_each(a, rest)

fn occurs_c(a : Int, c : CTy) : Bool ! {Solve(Sol)} =
  match c of
    CRet(v, r) => occurs_v(a, v) || occurs_labels(a, r.labels)
    CFun(params, body) => occurs_each(a, params) || occurs_c(a, body)

fn occurs_labels(a : Int, ls : List(Label)) : Bool ! {Solve(Sol)} =
  match ls of
    Nil => false
    Cons(l, rest) => occurs_each(a, l.args) || occurs_labels(a, rest)

fn row_occurs(a : Int, r : Row) : Bool ! {Solve(Sol)} =
  let z = zonk_row(r)
  match z.tail of
    TailMeta(b) => sv_equiv(a, b)
    _ => false

-- Unification.

fn solve_ty(a : Int, ty : VTy) : Unit ! {Solve(Sol), TcFail} =
  let t = zonk_v(ty)
  if occurs_v(a, t) then
    tc_fail(OccursV(a, show_vty(t)))
  else
    sv_assign(a, TySolved(t))

-- | Unify two value types, solving metavariable classes as it goes.
pub fn unify_v(left : VTy, right : VTy) : Unit ! {Solve(Sol), TcFail} =
  let a = zonk_v(left)
  let b = zonk_v(right)
  match (a, b) of
    (VMeta(x), VMeta(y)) =>
      if sv_equiv(x, y) then
        ()
      else
        sv_union(x, y)
    (VMeta(x), t) => solve_ty(x, t)
    (t, VMeta(x)) => solve_ty(x, t)
    (VInt, VInt) => ()
    (VFloat, VFloat) => ()
    (VBool, VBool) => ()
    (VUnit, VUnit) => ()
    (VString, VString) => ()
    (VVar(x), VVar(y)) =>
      if x == y then
        ()
      else
        mismatch(a, b)
    (VCon(n1, args1), VCon(n2, args2)) =>
      if n1 == n2 then
        unify_each(a, b, args1, args2)
      else
        mismatch(a, b)
    (VTuple(items1), VTuple(items2)) => unify_each(a, b, items1, items2)
    (VThunk(c1), VThunk(c2)) => unify_c(c1, c2)
    _ => mismatch(a, b)

fn mismatch(a : VTy, b : VTy) : Unit ! {TcFail} =
  tc_fail(Mismatch(show_vty(a), show_vty(b)))

fn unify_each(
  ctx_a : VTy,
  ctx_b : VTy,
  xs : List(VTy),
  ys : List(VTy)
) : Unit ! {Solve(Sol), TcFail} =
  match (xs, ys) of
    (Nil, Nil) => ()
    (Cons(x, xrest), Cons(y, yrest)) =>
      unify_v(x, y)
      unify_each(ctx_a, ctx_b, xrest, yrest)
    _ => mismatch(ctx_a, ctx_b)

-- | Unify two computation types: results, rows, and parameters pairwise.
pub fn unify_c(left : CTy, right : CTy) : Unit ! {Solve(Sol), TcFail} =
  match (left, right) of
    (CRet(v1, r1), CRet(v2, r2)) =>
      unify_v(v1, v2)
      unify_row(r1, r2)
    (CFun(p1, b1), CFun(p2, b2)) =>
      unify_each(VThunk(left), VThunk(right), p1, p2)
      unify_c(b1, b2)
    _ => tc_fail(Mismatch(show_cty(left), show_cty(right)))

-- Row unification: after zonking and normalizing, unify the shared labels'
-- arguments pairwise, then reconcile each side's leftover labels with the
-- other side's tail. Two open tails meet in a fresh middle tail; a closed
-- tail admits no leftovers.

fn split_common(
  xs : List(Label),
  ys : List(Label)
) : (List((Label, Label)), List(Label), List(Label)) =
  match (xs, ys) of
    (Nil, _rest) => ([], [], ys)
    (_rest, Nil) => ([], xs, [])
    (Cons(x, xrest), Cons(y, yrest)) =>
      if x.name == y.name then
        match split_common(xrest, yrest) of
          (both, lx, ly) => (Cons((x, y), both), lx, ly)
      elif cmp(x.name, y.name) < 0 then
        match split_common(xrest, ys) of
          (both, lx, ly) => (both, Cons(x, lx), ly)
      else
        match split_common(xs, yrest) of
          (both, lx, ly) => (both, lx, Cons(y, ly))

fn unify_label_args(pairs : List((Label, Label))) : Unit ! {Solve(Sol), TcFail} =
  match pairs of
    Nil => ()
    Cons((x, y), rest) =>
      unify_each(VCon(x.name, x.args), VCon(y.name, y.args), x.args, y.args)
      unify_label_args(rest)

fn row_mismatch(a : Row, b : Row) : a ! {TcFail} =
  tc_fail(RowMismatch(show_row(a), show_row(b)))

fn solve_row_tail(
  a : Int,
  leftover : List(Label),
  tail : Tail
) : Unit ! {Solve(Sol), TcFail} =
  let target = Row { labels = leftover, tail = tail }
  if row_occurs(a, target) then
    tc_fail(OccursRow(a, show_row(target)))
  else
    sv_assign(a, RowSolved(target))

-- | Unify two rows: shared labels pairwise, then each side's leftovers
-- against the other side's tail.
pub fn unify_row(left : Row, right : Row) : Unit ! {Solve(Sol), TcFail} =
  let a = row_normalize(zonk_row(left))
  let b = row_normalize(zonk_row(right))
  match split_common(a.labels, b.labels) of
    (both, extra_a, extra_b) =>
      unify_label_args(both)
      match (a.tail, b.tail) of
        (TailClosed, TailClosed) =>
          match (extra_a, extra_b) of
            (Nil, Nil) => ()
            _ => row_mismatch(a, b)
        (TailMeta(x), TailClosed) =>
          match extra_b2_closed(extra_a) of
            true => solve_row_tail(x, extra_b, TailClosed)
            false => row_mismatch(a, b)
        (TailClosed, TailMeta(y)) =>
          match extra_b2_closed(extra_b) of
            true => solve_row_tail(y, extra_a, TailClosed)
            false => row_mismatch(a, b)
        (TailMeta(x), TailMeta(y)) =>
          if sv_equiv(x, y) then
            match (extra_a, extra_b) of
              (Nil, Nil) => ()
              _ => row_mismatch(a, b)
          else
            let middle = fresh_row_meta()
            solve_row_tail(x, extra_b, middle)
            solve_row_tail(y, extra_a, middle)
        (TailVar(x), TailVar(y)) =>
          if x == y && closed_extras(extra_a, extra_b) then
            ()
          else
            row_mismatch(a, b)
        (TailMeta(x), TailVar(_v)) =>
          if closed_only(extra_a) then
            solve_row_tail(x, extra_b, b.tail)
          else
            row_mismatch(a, b)
        (TailVar(_v), TailMeta(y)) =>
          if closed_only(extra_b) then
            solve_row_tail(y, extra_a, a.tail)
          else
            row_mismatch(a, b)
        _ => row_mismatch(a, b)

fn closed_extras(extra_a : List(Label), extra_b : List(Label)) : Bool =
  closed_only(extra_a) && closed_only(extra_b)

fn closed_only(extra : List(Label)) : Bool =
  match extra of
    Nil => true
    _ => false

fn extra_b2_closed(extra : List(Label)) : Bool = closed_only(extra)

-- | Absorb `used` into the ambient row `have`: everything `used` performs must
-- already be admitted by `have`, while `have` stays free to admit more. This is
-- containment, not equality, which is what lets a pure callee stand in an
-- effectful caller. A closed `used` is reconciled over a fresh residual tail
-- that soaks up whatever `have` admits beyond it; an open `used` has no fixed
-- extent to contain and unifies outright, growing both sides to their union.
pub fn row_absorb(have : Row, used : Row) : Unit ! {Solve(Sol), TcFail} =
  let u = zonk_row(used)
  match u.tail of
    TailClosed => unify_row(have, row_open(u.labels, fresh_row_meta()))
    _ => unify_row(have, u)

-- | The pure part of handling: drop every label whose effect name is in
-- `handled`, keeping the tail, so an open row stays open to whatever its tail
-- admits. A handler's residual row is this subtraction; folding the residual
-- back into the ambient row is ordinary unification at the use site.
pub fn row_discharge(r : Row, handled : List(String)) : Row =
  Row {
    labels = filter(\(l) -> not(handled_name(handled, l.name)), r.labels),
    tail = r.tail
  }

fn handled_name(handled : List(String), name : String) : Bool =
  match handled of
    Nil => false
    Cons(h, rest) => h == name || handled_name(rest, name)

-- Row defaulting. A row metavariable that survives checking unconstrained
-- stands for "nothing more is performed here", so its principal reading is the
-- closed row. Defaulting is a rewrite of the type rather than a solver
-- assignment, so one reading of a shared class never forecloses another.

-- | Zonk `ty` and read every surviving row metavariable tail as closed. Rigid
-- row tails are left alone: those are quantified, not unconstrained.
--
-- Top-level declaration inference uses this before `generalize` to default
-- unwritten residual rows. Local generalization may instead quantify a row
-- class explicitly; the kind-separated collectors keep that operation safe.
pub fn close_rows_v(ty : VTy) : VTy ! {Solve(Sol)} = close_tails_v(zonk_v(ty))

-- | Zonk `ty` and close every surviving row metavariable except the listed
-- classes. The keep set is normalized to current solver roots, so callers may
-- retain evidence captured before same-kind classes were joined.
--
-- Declaration inference uses this to preserve only the residual classes
-- reached from written open rows. With an empty keep set this is exactly
-- `close_rows_v`, so unwritten top-level tails keep their existing default.
pub fn close_rows_v_except(keep : List(Int), ty : VTy) : VTy ! {Solve(Sol)} =
  close_tails_except_v(root_ids(keep), zonk_v(ty))

-- | Zonk a row and read a surviving metavariable tail as closed, so an
-- inferred row can be read off as the definite set of effects performed.
pub fn close_rows_row(r : Row) : Row ! {Solve(Sol)} = close_tails_row(zonk_row(r))

fn close_tails_v(ty : VTy) : VTy =
  match ty of
    VCon(name, args) => VCon(name, map(close_tails_v, args))
    VTuple(items) => VTuple(map(close_tails_v, items))
    VThunk(c) => VThunk(close_tails_c(c))
    other => other

fn close_tails_c(c : CTy) : CTy =
  match c of
    CRet(v, r) => CRet(close_tails_v(v), close_tails_row(r))
    CFun(params, body) => CFun(map(close_tails_v, params), close_tails_c(body))

fn close_tails_row(r : Row) : Row =
  let labels = map(close_tails_label, r.labels)
  match r.tail of
    TailMeta(_a) => Row { labels = labels, tail = TailClosed }
    _ => Row { labels = labels, tail = r.tail }

fn close_tails_label(l : Label) : Label =
  Label { name = l.name, args = map(close_tails_v, l.args) }

fn close_tails_except_v(keep : List(Int), ty : VTy) : VTy =
  match ty of
    VCon(name, args) =>
      VCon(name, map(\(arg) -> close_tails_except_v(keep, arg), args))
    VTuple(items) =>
      VTuple(map(\(item) -> close_tails_except_v(keep, item), items))
    VThunk(c) => VThunk(close_tails_except_c(keep, c))
    other => other

fn close_tails_except_c(keep : List(Int), c : CTy) : CTy =
  match c of
    CRet(v, r) =>
      CRet(close_tails_except_v(keep, v), close_tails_except_row(keep, r))
    CFun(params, body) =>
      CFun(
          map(\(param) -> close_tails_except_v(keep, param), params),
          close_tails_except_c(keep, body),
        )

fn close_tails_except_row(keep : List(Int), r : Row) : Row =
  let labels = map(\(label) -> close_tails_except_label(keep, label), r.labels)
  match r.tail of
    TailMeta(a) =>
      Row {
        labels = labels,
        tail = if elem_int(keep, a) then r.tail else TailClosed
      }
    _ => Row { labels = labels, tail = r.tail }

fn close_tails_except_label(keep : List(Int), l : Label) : Label =
  Label {
    name = l.name,
    args = map(\(arg) -> close_tails_except_v(keep, arg), l.args)
  }

-- Generalization and instantiation. Generalizing promotes every metavariable
-- free in the zonked type but not in the held sets to a fresh rigid binder of
-- the same kind; instantiating opens rows before types.

-- | Generalize a value type over every type and row metavariable free in it
-- and not held by the surrounding environment or ambient effect row.
pub fn generalize(
  held_ty : List(Int),
  held_row : List(Int),
  ty : VTy
) : Scheme ! {Solve(Sol), Fresh} =
  let z = zonk_v(ty)
  let held_ty_roots = root_ids(held_ty)
  let held_row_roots = root_ids(held_row)
  let tys = filter(\(m) -> not(elem_int(held_ty_roots, m)), free_ty_metas_v(z))
  let rows =
    filter(\(m) -> not(elem_int(held_row_roots, m)), free_row_metas_v(z))
  gen_rows(rows, [], tys, z)

fn root_ids(ids : List(Int)) : List(Int) ! {Solve(Sol)} =
  match ids of
    Nil => []
    Cons(id, rest) => Cons(sv_root(id), root_ids(rest))

-- The binders are minted in candidate order and the accumulator is reversed
-- once at the end, which keeps the scheme's quantifier order stable.
-- lint: allow(L0105)
fn gen_rows(
  metas : List(Int),
  binders : List(Binder(RowVarSpace)),
  ty_metas : List(Int),
  body : VTy
) : Scheme ! {Solve(Sol), Fresh} =
  match metas of
    Nil => gen_tys(ty_metas, [], reverse(binders), body)
    Cons(m, rest) =>
      let binder = fresh_binder("r")
      let solution = Row { labels = [], tail = TailVar(bound_name(binder)) }
      sv_assign(m, RowSolved(solution))
      gen_rows(rest, Cons(binder, binders), ty_metas, zonk_v(body))

-- lint: allow(L0105)
fn gen_tys(
  metas : List(Int),
  binders : List(Binder(TyVarSpace)),
  row_binders : List(Binder(RowVarSpace)),
  body : VTy
) : Scheme ! {Solve(Sol), Fresh} =
  match metas of
    Nil =>
      Scheme { tyvars = reverse(binders), rowvars = row_binders, body = body }
    Cons(m, rest) =>
      let binder = fresh_binder("t")
      sv_assign(m, TySolved(VVar(bound_name(binder))))
      gen_tys(rest, Cons(binder, binders), row_binders, zonk_v(body))

-- | Instantiate a scheme, opening row binders before type binders.
pub fn instantiate(scheme : Scheme) : VTy ! {Solve(Sol)} =
  inst_rows(scheme.rowvars, subst_empty, scheme.tyvars, scheme.body)

fn inst_rows(
  binders : List(Binder(RowVarSpace)),
  s : Subst,
  ty_binders : List(Binder(TyVarSpace)),
  body : VTy
) : VTy ! {Solve(Sol)} =
  match binders of
    Nil => inst_tys(ty_binders, s, body)
    Cons(b, rest) =>
      let r = row_open([], fresh_row_meta())
      inst_rows(rest, subst_row(s, bound_name(b), r), ty_binders, body)

fn inst_tys(
  binders : List(Binder(TyVarSpace)),
  s : Subst,
  body : VTy
) : VTy ! {Solve(Sol)} =
  match binders of
    Nil => apply_v(s, body)
    Cons(b, rest) =>
      let m = fresh_ty_meta()
      inst_tys(rest, subst_ty(s, bound_name(b), m), body)

-- Stable pretty-printing: rigid identities render through deterministic
-- positional hints, metavariables by class id.

-- | Render a value type in the surface syntax's spelling.
pub fn show_vty(ty : VTy) : String =
  match ty of
    VInt => "Int"
    VFloat => "Float"
    VBool => "Bool"
    VUnit => "Unit"
    VString => "String"
    VCon(name, Nil) => name
    VCon(name, args) => "{name}({join_tys(args)})"
    VTuple(items) => "({join_tys(items)})"
    VThunk(c) => show_cty(c)
    VVar(v) => "a{name_id(v)}"
    VMeta(a) => "?{a}"

fn join_tys(tys : List(VTy)) : String =
  match tys of
    Nil => ""
    Cons(t, Nil) => show_vty(t)
    Cons(t, rest) => "{show_vty(t)}, {join_tys(rest)}"

-- | Render a computation type as its result against its row.
pub fn show_cty(c : CTy) : String =
  match c of
    CRet(v, r) => "{show_vty(v)} ! {show_row(r)}"
    CFun(params, body) => "({join_tys(params)}) -> {show_cty(body)}"

-- | Render a row in brace syntax, naming the tail when the row is open.
pub fn show_row(r : Row) : String =
  let inner = join_labels(r.labels)
  match r.tail of
    TailClosed => "\{{inner}\}"
    TailVar(v) => "\{{inner} | r{name_id(v)}\}"
    TailMeta(a) => "\{{inner} | ?{a}\}"

fn join_labels(ls : List(Label)) : String =
  match ls of
    Nil => ""
    Cons(l, Nil) => show_label(l)
    Cons(l, rest) => "{show_label(l)}, {join_labels(rest)}"

fn show_label(l : Label) : String =
  match l.args of
    Nil => l.name
    args => "{l.name}({join_tys(args)})"

-- | Render a scheme, quantifiers first.
pub fn show_scheme(s : Scheme) : String =
  match s.tyvars of
    Nil => show_vty(s.body)
    vs => "forall {join_binders(vs)}. {show_vty(s.body)}"

fn join_binders(bs : List(Binder(TyVarSpace))) : String =
  match bs of
    Nil => ""
    Cons(b, Nil) => "a{name_id(bound_name(b))}"
    Cons(b, rest) => "a{name_id(bound_name(b))} {join_binders(rest)}"

fn main() =
  match run_tc(\() -> demo_main()) of
    Ok(shown) => println(shown)
    Err(_e) => println("tc demo failed")

fn demo_main() : String ! {Solve(Sol), TcFail} =
  let m = fresh_ty_meta()
  let io = row_closed([label0("IO")])
  unify_v(v_fun([VInt], c_ret(m, io)), v_fun([VInt], c_ret(VBool, io)))
  show_vty(zonk_v(m))
