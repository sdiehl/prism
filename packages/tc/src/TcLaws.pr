-- | The property laws of the type-and-row core, run by `prism test`.
--
-- These laws state the type-and-row core's contract executably: rigid
-- substitution, zonking idempotence, unification order-independence,
-- generalization's ambient-capture refusal, and deterministic row
-- normalization. Generators stay shallow (types of depth three, labels from a
-- fixed pool) because the laws are structural, not adversarial.

import Tc (..)
import Quickcheck (..)
import Control.Solve (Solve)
import Control.Fresh (Fresh, run_fresh)
import Data.Name (Name, Binder, fresh_binder, bound_name)
import Data.List (reverse, foldl, append)
import Data.Foldable (length)

-- Deterministic rigid names for the substitution laws: identities 0 and 1 in
-- each namespace, minted by replaying the same fresh seed.
fn ty_names() : (Name(TyVarSpace), Name(TyVarSpace)) =
  run_fresh(\() -> mint_two_tys())

fn mint_two_tys() : (Name(TyVarSpace), Name(TyVarSpace)) ! {Fresh} =
  let a = mint_ty()
  let b = mint_ty()
  (bound_name(a), bound_name(b))

fn mint_ty() : Binder(TyVarSpace) ! {Fresh} = fresh_binder("t")

-- The deepest generated type. The laws are structural, so depth buys nothing
-- past the point where every constructor shape has appeared.
let gen_depth : Int = 3

-- A shallow generated type over the two rigid names and small metas.
fn gen_vty() : Gen(VTy) = gen_sized(\(size) -> gen_vty_at(min(size, gen_depth)))

fn gen_vty_at(depth : Int) : Gen(VTy) =
  if depth <= 0 then
    gen_leaf()
  else
    gen_choose(gen_leaf(), [
        gen_map(\(t) -> VCon("T", [t]), gen_vty_at(depth - 1)),
        gen_map2(
            \(a, b) -> VTuple([a, b]),
            gen_vty_at(depth - 1),
            gen_vty_at(depth - 1),
          ),
        gen_map2(
            \(t, r) -> v_fun([t], c_ret(t, r)),
            gen_vty_at(depth - 1),
            gen_row_shallow(),
          ),
      ])

fn gen_leaf() : Gen(VTy) =
  match ty_names() of
    (na, nb) =>
      gen_choose(gen_const(VInt), [
          gen_const(VBool),
          gen_const(VUnit),
          gen_const(VVar(na)),
          gen_const(VVar(nb)),
        ])

fn gen_label_pool() : Gen(Label) =
  gen_map(label0, gen_one_of("A", ["B", "C", "D"]))

fn gen_row_shallow() : Gen(Row) =
  gen_map(\(ls) -> row_closed(dedup_labels(ls)), gen_list(gen_label_pool()))

fn dedup_labels(ls : List(Label)) : List(Label) =
  foldl(\(acc, l) -> if label_in(acc, l) then acc else Cons(l, acc), Nil, ls)

fn label_in(ls : List(Label), l : Label) : Bool =
  match ls of
    Nil => false
    Cons(h, rest) => h.name == l.name || label_in(rest, l)

-- A generated substitution binding the two rigid names.
fn gen_subst() : Gen(Subst) =
  match ty_names() of
    (na, nb) =>
      gen_map2(
          \(t1, t2) -> subst_ty(subst_ty(subst_empty, na, t1), nb, t2),
          gen_vty(),
          gen_vty(),
        )

-- Law: applying the empty substitution is the identity.
fn prop_subst_empty(t : VTy) : Bool = apply_v(subst_empty, t) == t

test fn subst_empty_is_identity() =
  match quickcheck(gen_vty(), prop_subst_empty) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: applying a composed substitution matches sequential application.
fn prop_compose(pair : (Subst, (Subst, VTy))) : Bool =
  match pair of
    (s2, (s1, t)) =>
      apply_v(subst_compose(s2, s1), t) == apply_v(s2, apply_v(s1, t))

test fn compose_matches_sequential() =
  match (quickcheck(
        gen_pair(gen_subst(), gen_pair(gen_subst(), gen_vty())),
        prop_compose,
      )) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: zonking is idempotent, including through solved metas.
fn zonk_twice_agrees(t : VTy) : Bool ! {Solve(Sol), TcFail} =
  let m = fresh_ty_meta()
  unify_v(m, t)
  let once = zonk_v(m)
  once == zonk_v(once)

fn prop_zonk_idempotent(t : VTy) : Bool =
  match run_tc(\() -> zonk_twice_agrees(t)) of
    Ok(held) => held
    Err(_e) => true

test fn zonk_is_idempotent() =
  match quickcheck(gen_vty(), prop_zonk_idempotent) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: unification is order-independent modulo canonical meta naming. The
-- probe unifies a chain of metas against a generated type in both orders and
-- compares the canonicalized rendering of the chain's head.
fn chain_solved(t : VTy, flipped : Bool) : String ! {Solve(Sol), TcFail} =
  let m1 = fresh_ty_meta()
  let m2 = fresh_ty_meta()
  if flipped then
    unify_v(m2, t)
    unify_v(m1, m2)
  else
    unify_v(m1, m2)
    unify_v(m2, t)
  show_vty(zonk_v(m1))

fn prop_unify_order(t : VTy) : Bool =
  run_tc(\() -> chain_solved(t, false)) == run_tc(\() -> chain_solved(t, true))

test fn unify_is_order_independent() =
  match quickcheck(gen_vty(), prop_unify_order) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: the solver strategy lives in the handler alone. Unification only ever
-- joins classes with at most one solution in play, so any join policy that
-- keeps the solved side is observationally the same checker.
fn merge_flip(kept : Sol, lost : Sol) : Sol =
  match (kept, lost) of
    (k, TyUnsolved) => k
    (k, RowUnsolved) => k
    (_k, solved) => solved

fn prop_policy_swap(t : VTy) : Bool =
  run_tc_with(merge_sol, \() -> chain_solved(t, false))
    == run_tc_with(merge_flip, \() -> chain_solved(t, false))

test fn solver_strategy_is_the_handler() =
  match quickcheck(gen_vty(), prop_policy_swap) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: generalization never captures an ambient metavariable.
fn gen_capture_witness() : (Int, Int) ! {Solve(Sol), TcFail, Fresh} =
  let ambient = fresh_ty_meta()
  let local = fresh_ty_meta()
  let scheme =
    match ambient of
      VMeta(a) => generalize([a], VTuple([ambient, local]))
      _ => generalize([], VTuple([ambient, local]))
  let still_meta =
    match zonk_v(ambient) of
      VMeta(_id) => 1
      _ => 0
  (length(scheme.tyvars), still_meta)

test fn generalize_skips_ambient() =
  let outcome = run_fresh(\() -> run_tc(\() -> gen_capture_witness()))
  match outcome of
    Ok((bound, still_meta)) =>
      if bound == 1 && still_meta == 1 then
        ()
      else
        fail()
    Err(_e) => fail()

-- Law: row normalization is deterministic: any permutation of distinct
-- labels normalizes to one spelling.
fn prop_row_normal(ls : List(Label)) : Bool =
  let distinct = dedup_labels(ls)
  let forward = row_closed(distinct)
  let backward = row_closed(reverse(distinct))
  run_tc(\() -> normalized_pair(forward, backward)) == Ok(true)

fn normalized_pair(a : Row, b : Row) : Bool ! {Solve(Sol), TcFail} =
  row_normalize(a) == row_normalize(b)

test fn row_normalization_deterministic() =
  match quickcheck(gen_list(gen_label_pool()), prop_row_normal) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Row unification smoke: an open row absorbs the closed remainder.
fn open_absorbs() : String ! {Solve(Sol), TcFail} =
  let tail = fresh_row_meta()
  unify_row(row_open([label0("IO")], tail), row_closed([
      label0("Ask"),
      label0("IO"),
    ]))
  show_row(row_normalize(zonk_row(row_open([label0("IO")], tail))))

test fn open_row_absorbs_remainder() =
  match run_tc(\() -> open_absorbs()) of
    Ok(shown) =>
      if shown == "\{Ask, IO\}" then
        ()
      else
        fail()
    Err(_e) => fail()

-- The row-algebra laws proper: the three operations principal-row inference
-- leans on (closed equality, open-tail merge, closed absorption) plus
-- discharge, stated over generated rows rather than single witnesses.

fn gen_labels() : Gen(List(Label)) =
  gen_map(dedup_labels, gen_list(gen_label_pool()))

fn gen_names() : Gen(List(String)) = gen_list(gen_one_of("A", ["B", "C", "D"]))

fn gen_row_any() : Gen(Row) = gen_map2(row_open, gen_labels(), gen_tail())

fn gen_tail() : Gen(Tail) =
  gen_one_of(TailClosed, [TailVar(row_name()), TailMeta(0)])

fn row_name() : Name(RowVarSpace) =
  run_fresh(\() -> bound_name(fresh_binder("r")))

fn subset_of(a : List(Label), b : List(Label)) : Bool =
  match a of
    Nil => true
    Cons(h, rest) => label_in(b, h) && subset_of(rest, b)

fn same_label_set(a : List(Label), b : List(Label)) : Bool =
  subset_of(a, b) && subset_of(b, a)

fn name_in(names : List(String), n : String) : Bool =
  match names of
    Nil => false
    Cons(h, rest) => h == n || name_in(rest, n)

-- Law: closed rows unify exactly when they carry the same label set, in
-- either argument order.
fn unified(a : Row, b : Row) : Bool ! {Solve(Sol), TcFail} =
  unify_row(a, b)
  true

fn closed_unifies(a : List(Label), b : List(Label)) : Bool =
  run_tc(\() -> unified(row_closed(a), row_closed(b))) == Ok(true)

fn prop_closed_equality(pair : (List(Label), List(Label))) : Bool =
  match pair of
    (a, b) =>
      let hit = same_label_set(a, b)
      closed_unifies(a, b) == hit && closed_unifies(b, a) == hit

test fn closed_rows_unify_iff_equal_sets() =
  match (quickcheck(gen_pair(gen_labels(), gen_labels()), prop_closed_equality)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: two open rows always merge, and both sides settle on one row whose
-- labels are exactly the union.
fn merged(
  a_ls : List(Label),
  b_ls : List(Label)
) : (Row, Row) ! {Solve(Sol), TcFail} =
  let a = row_open(a_ls, fresh_row_meta())
  let b = row_open(b_ls, fresh_row_meta())
  unify_row(a, b)
  (row_normalize(zonk_row(a)), row_normalize(zonk_row(b)))

fn prop_open_merge(pair : (List(Label), List(Label))) : Bool =
  match pair of
    (a_ls, b_ls) =>
      match run_tc(\() -> merged(a_ls, b_ls)) of
        Ok((ra, rb)) =>
          ra == rb
            && same_label_set(ra.labels, dedup_labels(append(a_ls, b_ls)))
        Err(_e) => false

test fn open_rows_merge_to_the_union() =
  match (quickcheck(gen_pair(gen_labels(), gen_labels()), prop_open_merge)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: an open row absorbs a closed row exactly when its labels are a
-- subset, settling to the closed row itself.
fn absorbed(
  open_ls : List(Label),
  closed_ls : List(Label)
) : Row ! {Solve(Sol), TcFail} =
  let o = row_open(open_ls, fresh_row_meta())
  unify_row(o, row_closed(closed_ls))
  row_normalize(zonk_row(o))

fn prop_closed_absorption(pair : (List(Label), List(Label))) : Bool =
  match pair of
    (open_ls, closed_ls) =>
      match run_tc(\() -> absorbed(open_ls, closed_ls)) of
        Ok(r) =>
          subset_of(open_ls, closed_ls)
            && r.tail == TailClosed
            && same_label_set(r.labels, closed_ls)
        Err(_e) => not(subset_of(open_ls, closed_ls))

test fn open_row_absorbs_iff_subset() =
  match (quickcheck(gen_pair(gen_labels(), gen_labels()), prop_closed_absorption)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: discharge drops exactly the handled labels in order, preserves the
-- tail, and is idempotent.
fn prop_discharge(pair : (Row, List(String))) : Bool =
  match pair of
    (r, handled) =>
      let d = row_discharge(r, handled)
      d.tail == r.tail
        && row_discharge(d, handled) == d
        && kept_exactly(r.labels, d.labels, handled)

fn kept_exactly(
  before : List(Label),
  after : List(Label),
  handled : List(String)
) : Bool =
  match before of
    Nil => after == Nil
    Cons(l, rest) =>
      if name_in(handled, l.name) then
        kept_exactly(rest, after, handled)
      else
        match after of
          Cons(k, krest) => k == l && kept_exactly(rest, krest, handled)
          Nil => false

test fn discharge_removes_exactly_the_handled() =
  match (quickcheck(gen_pair(gen_row_any(), gen_names()), prop_discharge)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: absorption is containment, not equality. A written-down row admits a
-- use exactly when it already carries every label used, and admitting one
-- leaves it exactly as it was, so a call can never widen a row a declaration
-- committed to.
fn absorbed_into_closed(
  have_ls : List(Label),
  used_ls : List(Label)
) : Row ! {Solve(Sol), TcFail} =
  let have = row_closed(have_ls)
  row_absorb(have, row_closed(used_ls))
  row_normalize(zonk_row(have))

fn prop_absorb_into_closed(pair : (List(Label), List(Label))) : Bool =
  match pair of
    (have_ls, used_ls) =>
      match run_tc(\() -> absorbed_into_closed(have_ls, used_ls)) of
        Ok(r) =>
          subset_of(used_ls, have_ls)
            && r.tail == TailClosed
            && same_label_set(r.labels, have_ls)
        Err(_e) => not(subset_of(used_ls, have_ls))

test fn closed_row_absorbs_iff_it_contains() =
  match (quickcheck(gen_pair(gen_labels(), gen_labels()), prop_absorb_into_closed)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()

-- Law: an inferred row absorbs any use, growing to the union and staying open.
-- This is the call-site half of inference: performing something a caller had
-- not yet been told about widens the caller rather than failing it.
fn absorbed_into_open(
  have_ls : List(Label),
  used_ls : List(Label)
) : Row ! {Solve(Sol), TcFail} =
  let have = row_open(have_ls, fresh_row_meta())
  row_absorb(have, row_closed(used_ls))
  row_normalize(zonk_row(have))

fn prop_absorb_into_open(pair : (List(Label), List(Label))) : Bool =
  match pair of
    (have_ls, used_ls) =>
      match run_tc(\() -> absorbed_into_open(have_ls, used_ls)) of
        Ok(r) =>
          not(r.tail == TailClosed)
            && same_label_set(r.labels, dedup_labels(append(have_ls, used_ls)))
        Err(_e) => false

test fn open_row_absorbs_any_use() =
  match (quickcheck(gen_pair(gen_labels(), gen_labels()), prop_absorb_into_open)) of
    Passed(_n) => ()
    Failed(_x, _i, _s, _z) => fail()
