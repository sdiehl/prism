-- | Spectra's command grammar, built applicatively with Std `Cli`.
--
-- The executable understands three subcommands, each defaulting its project
-- path to the current directory. `check` and `build` shell out to the compiler
-- named by `--prism`, so a fresh build can pin itself instead of trusting
-- whichever `prism` is first on `PATH`:
--
-- ```text
-- spectra check [PATH] --prism prism
-- spectra build [PATH] --output deck.pdf --open --prism prism
-- spectra clean [PATH]
-- ```
--
-- Parsing is a pure function over an argument list, so the grammar is its own
-- test surface:
--
-- ```prism
-- # import Cli as C
-- fn main() =
--   match parse_spectra_argv(["build", "talk", "--open"]) of
--     C.Parsed(cmd) => println(show(cmd))
--     _ => println("usage error")
-- ```
-- ```output
-- SpectraCli.Build("talk", "deck.pdf", true, "prism")
-- ```

import Cli as C
import Cli (Command, Group, SubCmd)
import Test (expect_equal)

-- | One parsed subcommand: check a project, build it to a named PDF and
-- optionally open it, or clean its build directory. The last field of `Check`
-- and `Build` is the compiler binary their shell steps invoke.
pub type SpectraCommand
  = Check(String, String)
  | Build(String, String, Bool, String)
  | Clean(String)
  deriving (Eq, Show)

fn path_parser() =
  C.arg_str_default(
      "PATH",
      "project directory (default: current directory)",
      ".",
    )

fn prism_parser() =
  C.opt_str("prism", "", "BIN", "compiler binary to invoke", "prism")

fn check_parser() =
  C.build2(
      \(path) -> \(prism) -> Check(path, prism),
      path_parser(),
      prism_parser(),
    )

fn clean_parser() = C.map_p(\(path) -> Clean(path), path_parser())

-- The build command, curried one field per parser stage.
fn build_command(path : String) =
  \(output) -> \(open) -> \(prism) -> Build(path, output, open, prism)

fn build_parser() =
  C.build4(
      build_command,
      path_parser(),
      C.opt_str("output", "o", "PDF", "output PDF name", "deck.pdf"),
      C.switch("open", "", "open the resulting PDF"),
      prism_parser(),
    )

-- | The whole command grammar the executable parses its argument list with.
pub let spectra_command : C.Command(SpectraCommand) =
  Command {
    name = "spectra",
    about = "build typed Prism presentations through Typst",
    body = Group([
        SubCmd {
          key = "check",
          about = "check a deck and required tools",
          sub = check_parser()
        },
        SubCmd {
          key = "build",
          about = "build inspectable Typst and a PDF",
          sub = build_parser()
        },
        SubCmd {
          key = "clean",
          about = "remove only target/spectra",
          sub = clean_parser()
        },
      ])
  }

-- | Parse an argument list against the grammar, without touching the process
-- environment.
pub fn parse_spectra_argv(argv : List(String)) : C.Outcome(SpectraCommand) =
  C.run_argv(spectra_command, argv)

test fn default_paths_are_current_directory() =
  match parse_spectra_argv(["check"]) of
    C.Parsed(Check(path, prism)) => expect_equal((".", "prism"), (path, prism))
    _ => fail()

test fn build_combines_path_output_and_open_applicatively() =
  match (parse_spectra_argv(["build", "talk", "--output", "talk.pdf", "--open"])) of
    C.Parsed(Build(path, output, open, _)) =>
      expect_equal(("talk", "talk.pdf", true), (path, output, open))
    _ => fail()

test fn extra_paths_are_rejected() =
  match parse_spectra_argv(["clean", "one", "two"]) of
    C.BadUsage(_) => ()
    _ => fail()

test fn prism_flag_pins_the_compiler() =
  match (parse_spectra_argv(["build", "talk", "--prism", "target/release/prism"])) of
    C.Parsed(Build(_, _, _, prism)) =>
      expect_equal("target/release/prism", prism)
    _ => fail()
