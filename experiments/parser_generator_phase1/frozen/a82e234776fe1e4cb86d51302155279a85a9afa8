-- | The Prism-owned pattern grammar.
--
-- This module mirrors the pattern productions in the compiler grammar, but
-- keeps the control flow explicit: the leading token chooses an atom or
-- constructor form, and only the delimited forms recurse. There is no
-- backtracking and no pattern-specific parser framework.
--
-- Lists are surface sugar in the grammar rather than a distinct `Pat` node.
-- `[]` becomes `Nil`; a non-empty list becomes the same right-nested
-- `Cons(head, tail)` tree the Rust parser exports. The outermost cons is
-- widened to the brackets, while each inner cons keeps the source span of its
-- head and the final Nil is zero-width immediately after the closing bracket.

import Data.List (..)

import Data.String (ends_with)

import Syntax.Source (..)

import Syntax.Token (..)

import Syntax.Ast (..)

import Syntax.Cursor (..)

import Syntax.Parse.Support (..)

import Syntax.Parse.Build (..)

-- -------------------------------------------------------------------------
-- Literal construction
-- -------------------------------------------------------------------------

-- Split the lexer payload back into the surface AST's value and suffix fields.
-- The token artifact deliberately keeps the suffix in the decoded payload,
-- while `PInt` represents it separately.
fn pat_int_parts(raw : String) : (String, Suffix) =
  let n = str_len(raw)
  if ends_with("i64", raw) then
    (substring(raw, 0, n - 3), SufI64)
  elif ends_with("u64", raw) then
    (substring(raw, 0, n - 3), SufU64)
  else
    (raw, SufNone)

fn pat_int(raw : String, negative : Bool, s : Span) : Sp(Pat) =
  match pat_int_parts(raw) of
    (digits, suffix) =>
      let normalized = surface_int(digits)
      let value = if negative then concat("-", normalized) else normalized
      authored(PInt(value, suffix), s.lo, s.hi)

fn pat_float(raw : String, negative : Bool, s : Span) : Sp(Pat) =
  let normalized = surface_float(raw)
  let value = if negative then concat("-", normalized) else normalized
  authored(PFloat(value), s.lo, s.hi)

-- -------------------------------------------------------------------------
-- Expectations
-- -------------------------------------------------------------------------

-- Record every token that can begin a pattern. This is used only on the
-- dispatch fall-through; named productions record their narrower delimiter
-- expectations at the point they fail.
fn pat_note_start(c : Cursor) : Cursor =
  let c1 = cursor_note(c, TIdent)
  let c2 = cursor_note(c1, TUid)
  let c3 = cursor_note(c2, TQual)
  let c4 = cursor_note(c3, TInt)
  let c5 = cursor_note(c4, TFloat)
  let c6 = cursor_note(c5, TChar)
  let c7 = cursor_note(c6, TFixed("true"))
  let c8 = cursor_note(c7, TFixed("false"))
  let c9 = cursor_note(c8, TFixed("-"))
  let c10 = cursor_note(c9, TFixed("["))
  cursor_note(c10, TFixed("("))

fn pat_note_numeric(c : Cursor) : Cursor =
  cursor_note(cursor_note(c, TInt), TFloat)

fn pat_note_sep_or_close(c : Cursor, close : String) : Cursor =
  cursor_note(cursor_note(c, TFixed(",")), TFixed(close))

-- Add a delimiter alternative only when the failed production consumed
-- nothing. If it reached farther (for example `-[bad]`), its deeper
-- expectation remains the useful one and the delimiter belonged to an older
-- position.
fn pat_note_close_if_same(
  start : Cursor,
  failed : Cursor,
  close : String
) : Cursor =
  if failed.pos == start.pos then
    cursor_note(failed, TFixed(close))
  else
    failed

-- -------------------------------------------------------------------------
-- Public productions
-- -------------------------------------------------------------------------

-- | Parse one full pattern, including any `|` alternatives.
--
-- `depth` is the remaining whole-parser recursion budget. A nested pattern
-- spends one point; siblings in a tuple, list, argument list, record, or
-- alternation reuse the same remaining value because they do not increase
-- syntactic nesting.
pub fn parse_pattern(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  match descend(depth, c) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(d, c2) =>
      let start = c2
      match parse_pat_alt(c2, d) of
        PStuck(c3) => PStuck(c3)
        PFault(f) => PFault(f)
        PTook(first, c3) =>
          if at_fixed(c3, "|") then
            parse_pat_or_tail(start, d, c3, [first])
          else
            PTook(first, c3)

-- | Parse the restricted destructuring pattern admitted after `let`.
--
-- The compiler grammar intentionally accepts only a constructor (qualified
-- or unqualified) or a tuple containing at least one comma. General variables
-- are handled by the ordinary `let name = ...` production, not here.
pub fn parse_let_pattern(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  match descend(depth, c) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(d, c2) =>
      match cursor_kind(c2) of
        Some(TUid) => parse_ctor(c2, d, TUid)
        Some(TQual) => parse_ctor(c2, d, TQual)
        Some(TFixed(s)) =>
          if s == "(" then
            parse_let_tuple(c2, d)
          else
            let c3 = cursor_note(c2, TUid)
            let c4 = cursor_note(c3, TQual)
            PStuck(cursor_note(c4, TFixed("(")))
        _ =>
          let c3 = cursor_note(c2, TUid)
          let c4 = cursor_note(c3, TQual)
          PStuck(cursor_note(c4, TFixed("(")))

-- -------------------------------------------------------------------------
-- Alternation and leading-token dispatch
-- -------------------------------------------------------------------------

fn parse_pat_or_tail(
  start : Cursor,
  depth : Int,
  c : Cursor,
  rev_alts : List(Sp(Pat))
) : Parsed(Sp(Pat)) =
  if at_fixed(c, "|") then
    let after_bar = cursor_advance(c)
    match parse_pat_alt(after_bar, depth) of
      PStuck(c2) => PStuck(c2)
      PFault(d) => PFault(d)
      PTook(alt, c2) =>
        parse_pat_or_tail(start, depth, c2, Cons(alt, rev_alts))
  else
    let s = cursor_since(start, c)
    PTook(authored(POr(reverse(rev_alts)), s.lo, s.hi), c)

-- A PatAlt is a constructor/record form or a pattern atom. A uid must be
-- consumed before inspecting its following delimiter because both a plain
-- constructor and a record begin with the same token.
fn parse_pat_alt(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  match cursor_kind(c) of
    Some(TUid) => parse_uid_alt(c, depth)
    Some(TQual) => parse_ctor(c, depth, TQual)
    Some(TIdent) => parse_ident_pat(c)
    Some(TInt) => parse_int_pat(c, false)
    Some(TFloat) => parse_float_pat(c, false)
    Some(TChar) => parse_char_pat(c)
    Some(TFixed(s)) =>
      if s == "true" then
        parse_bool_pat(c, true)
      elif s == "false" then
        parse_bool_pat(c, false)
      elif s == "-" then
        parse_negative_pat(c)
      elif s == "[" then
        parse_list_pat(c, depth)
      elif s == "(" then
        parse_tuple_pat(c, depth)
      else
        PStuck(pat_note_start(c))
    _ => PStuck(pat_note_start(c))

fn parse_uid_alt(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  let start = c
  match take_kind(c, TUid) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let name = token_text(tok)
      if at_fixed(c2, "\{") then
        parse_record_after_name(start, name, c2, depth)
      elif at_fixed(c2, "(") then
        parse_ctor_args_after_name(start, name, c2, depth)
      else
        let s = cursor_since(start, c2)
        PTook(authored(PCtor(name, Nil), s.lo, s.hi), c2)

fn parse_ctor(
  c : Cursor,
  depth : Int,
  kind : TokenKind
) : Parsed(Sp(Pat)) =
  let start = c
  match take_kind(c, kind) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let name = token_text(tok)
      if at_fixed(c2, "(") then
        parse_ctor_args_after_name(start, name, c2, depth)
      else
        let s = cursor_since(start, c2)
        PTook(authored(PCtor(name, Nil), s.lo, s.hi), c2)

fn parse_ctor_args_after_name(
  start : Cursor,
  name : String,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Pat)) =
  match parse_pat_args(c, depth) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(args, c2) =>
      let s = cursor_since(start, c2)
      PTook(authored(PCtor(name, args), s.lo, s.hi), c2)

-- -------------------------------------------------------------------------
-- Atoms
-- -------------------------------------------------------------------------

fn parse_ident_pat(c : Cursor) : Parsed(Sp(Pat)) =
  match take_kind(c, TIdent) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let name = token_text(tok)
      let node = if name == "_" then PWild else PVar(name)
      PTook(authored(node, tok.span.lo, tok.span.hi), c2)

fn parse_int_pat(c : Cursor, negative : Bool) : Parsed(Sp(Pat)) =
  let start = c
  match take_kind(c, TInt) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let s = cursor_since(start, c2)
      PTook(pat_int(token_text(tok), negative, s), c2)

fn parse_float_pat(c : Cursor, negative : Bool) : Parsed(Sp(Pat)) =
  let start = c
  match take_kind(c, TFloat) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let s = cursor_since(start, c2)
      PTook(pat_float(token_text(tok), negative, s), c2)

fn parse_char_pat(c : Cursor) : Parsed(Sp(Pat)) =
  match take_kind(c, TChar) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      PTook(authored(PChar(token_text(tok)), tok.span.lo, tok.span.hi), c2)

fn parse_bool_pat(c : Cursor, value : Bool) : Parsed(Sp(Pat)) =
  if value then
    parse_bool_word(c, true, "true")
  else
    parse_bool_word(c, false, "false")

fn parse_bool_word(
  c : Cursor,
  value : Bool,
  word : String
) : Parsed(Sp(Pat)) =
  match take_fixed(c, word) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      PTook(authored(PBool(value), tok.span.lo, tok.span.hi), c2)

fn parse_negative_pat(c : Cursor) : Parsed(Sp(Pat)) =
  let start = c
  let after_minus = cursor_advance(c)
  match cursor_kind(after_minus) of
    Some(TInt) =>
      match take_kind(after_minus, TInt) of
        PStuck(c2) => PStuck(c2)
        PFault(d) => PFault(d)
        PTook(tok, c2) =>
          let s = cursor_since(start, c2)
          PTook(pat_int(token_text(tok), true, s), c2)
    Some(TFloat) =>
      match take_kind(after_minus, TFloat) of
        PStuck(c2) => PStuck(c2)
        PFault(d) => PFault(d)
        PTook(tok, c2) =>
          let s = cursor_since(start, c2)
          PTook(pat_float(token_text(tok), true, s), c2)
    _ => PStuck(pat_note_numeric(after_minus))

-- -------------------------------------------------------------------------
-- Constructor arguments
-- -------------------------------------------------------------------------

-- Parse `(p1, ..., pn)` at the cursor. Constructor arguments admit the empty
-- list and a trailing comma.
fn parse_pat_args(c : Cursor, depth : Int) : Parsed(List(Sp(Pat))) =
  match take_fixed(c, "(") of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(_, c2) =>
      if at_fixed(c2, ")") then
        PTook(Nil, cursor_advance(c2))
      else
        match parse_pattern(c2, depth) of
          PStuck(c3) => PStuck(pat_note_close_if_same(c2, c3, ")"))
          PFault(d) => PFault(d)
          PTook(first, c3) =>
            parse_pat_args_tail(depth, c3, [first])

fn parse_pat_args_tail(
  depth : Int,
  c : Cursor,
  rev_args : List(Sp(Pat))
) : Parsed(List(Sp(Pat))) =
  if at_fixed(c, ")") then
    PTook(reverse(rev_args), cursor_advance(c))
  elif at_fixed(c, ",") then
    let after_comma = cursor_advance(c)
    if at_fixed(after_comma, ")") then
      PTook(reverse(rev_args), cursor_advance(after_comma))
    else
      match parse_pattern(after_comma, depth) of
        PStuck(c2) =>
          PStuck(pat_note_close_if_same(after_comma, c2, ")"))
        PFault(d) => PFault(d)
        PTook(arg, c2) =>
          parse_pat_args_tail(depth, c2, Cons(arg, rev_args))
  else
    PStuck(pat_note_sep_or_close(c, ")"))

-- -------------------------------------------------------------------------
-- Records
-- -------------------------------------------------------------------------

fn parse_record_after_name(
  start : Cursor,
  name : String,
  c : Cursor,
  depth : Int
) : Parsed(Sp(Pat)) =
  match take_fixed(c, "\{") of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(_, c2) =>
      parse_record_fields(start, name, depth, c2, Nil)

fn parse_record_fields(
  start : Cursor,
  name : String,
  depth : Int,
  c : Cursor,
  rev_fields : List(PatField)
) : Parsed(Sp(Pat)) =
  if at_fixed(c, "\}") then
    finish_record(start, name, reverse(rev_fields), false, cursor_advance(c))
  elif at_fixed(c, "..") then
    let after_rest = cursor_advance(c)
    match take_fixed(after_rest, "\}") of
      PStuck(c2) => PStuck(c2)
      PFault(d) => PFault(d)
      PTook(_, c2) =>
        finish_record(start, name, reverse(rev_fields), true, c2)
  else
    match parse_record_field(c, depth) of
      PStuck(c2) =>
        let c3 = cursor_note(c2, TFixed(".."))
        PStuck(cursor_note(c3, TFixed("\}")))
      PFault(d) => PFault(d)
      PTook(field, c2) =>
        if at_fixed(c2, "\}") then
          finish_record(
              start,
              name,
              reverse(Cons(field, rev_fields)),
              false,
              cursor_advance(c2),
            )
        elif at_fixed(c2, ",") then
          let after_comma = cursor_advance(c2)
          if at_fixed(after_comma, "\}") then
            finish_record(
                start,
                name,
                reverse(Cons(field, rev_fields)),
                false,
                cursor_advance(after_comma),
              )
          elif at_fixed(after_comma, "..") then
            let after_rest = cursor_advance(after_comma)
            match take_fixed(after_rest, "\}") of
              PStuck(c3) => PStuck(c3)
              PFault(d) => PFault(d)
              PTook(_, c3) =>
                finish_record(
                    start,
                    name,
                    reverse(Cons(field, rev_fields)),
                    true,
                    c3,
                  )
          else
            parse_record_fields(
                start,
                name,
                depth,
                after_comma,
                Cons(field, rev_fields),
              )
        else
          PStuck(pat_note_sep_or_close(c2, "\}"))

fn parse_record_field(c : Cursor, depth : Int) : Parsed(PatField) =
  match take_kind(c, TIdent) of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(tok, c2) =>
      let name = token_text(tok)
      if at_fixed(c2, "=") then
        match parse_pattern(cursor_advance(c2), depth) of
          PStuck(c3) => PStuck(c3)
          PFault(d) => PFault(d)
          PTook(pat, c3) =>
            PTook(PatField { name = name, pat = pat }, c3)
      else
        let pat = authored(PVar(name), tok.span.lo, tok.span.hi)
        PTook(PatField { name = name, pat = pat }, c2)

fn finish_record(
  start : Cursor,
  name : String,
  fields : List(PatField),
  spread : Bool,
  c : Cursor
) : Parsed(Sp(Pat)) =
  let s = cursor_since(start, c)
  PTook(authored(PRecord(name, fields, spread), s.lo, s.hi), c)

-- -------------------------------------------------------------------------
-- List sugar
-- -------------------------------------------------------------------------

fn parse_list_pat(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  let start = c
  match take_fixed(c, "[") of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(_, c2) =>
      if at_fixed(c2, "]") then
        let c3 = cursor_advance(c2)
        let s = cursor_since(start, c3)
        PTook(authored(PCtor("Nil", Nil), s.lo, s.hi), c3)
      else
        match parse_pattern(c2, depth) of
          PStuck(c3) => PStuck(pat_note_close_if_same(c2, c3, "]"))
          PFault(d) => PFault(d)
          PTook(first, c3) =>
            parse_list_tail(start, depth, c3, [first])

fn parse_list_tail(
  start : Cursor,
  depth : Int,
  c : Cursor,
  rev_items : List(Sp(Pat))
) : Parsed(Sp(Pat)) =
  if at_fixed(c, "]") then
    finish_list(start, reverse(rev_items), cursor_advance(c))
  elif at_fixed(c, ",") then
    let after_comma = cursor_advance(c)
    if at_fixed(after_comma, "]") then
      finish_list(start, reverse(rev_items), cursor_advance(after_comma))
    else
      match parse_pattern(after_comma, depth) of
        PStuck(c2) =>
          PStuck(pat_note_close_if_same(after_comma, c2, "]"))
        PFault(d) => PFault(d)
        PTook(item, c2) =>
          parse_list_tail(start, depth, c2, Cons(item, rev_items))
  else
    PStuck(pat_note_sep_or_close(c, "]"))

fn finish_list(
  start : Cursor,
  items : List(Sp(Pat)),
  c : Cursor
) : Parsed(Sp(Pat)) =
  let outer = cursor_since(start, c)
  let nil = zero_width(PCtor("Nil", Nil), outer.hi)
  let lowered = lower_list(items, nil)
  PTook(widened(lowered, outer.lo, outer.hi), c)

fn lower_list(items : List(Sp(Pat)), rest : Sp(Pat)) : Sp(Pat) =
  match items of
    Nil => rest
    Cons(head, tail) =>
      let lowered_tail = lower_list(tail, rest)
      authored(
          PCtor("Cons", [head, lowered_tail]),
          head.span.lo,
          head.span.hi,
        )

-- -------------------------------------------------------------------------
-- Tuples
-- -------------------------------------------------------------------------

-- Parentheses in the pattern grammar are tuples, never grouping. At least one
-- comma is therefore required; `(p,)` is the one-element tuple.
fn parse_tuple_pat(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  let start = c
  match take_fixed(c, "(") of
    PStuck(c2) => PStuck(c2)
    PFault(d) => PFault(d)
    PTook(_, c2) =>
      match parse_pattern(c2, depth) of
        PStuck(c3) => PStuck(c3)
        PFault(d) => PFault(d)
        PTook(first, c3) =>
          match take_fixed(c3, ",") of
            PStuck(c4) => PStuck(c4)
            PFault(d) => PFault(d)
            PTook(_, c4) =>
              parse_tuple_tail(start, depth, c4, [first])

fn parse_tuple_tail(
  start : Cursor,
  depth : Int,
  c : Cursor,
  rev_items : List(Sp(Pat))
) : Parsed(Sp(Pat)) =
  if at_fixed(c, ")") then
    let c2 = cursor_advance(c)
    let s = cursor_since(start, c2)
    PTook(authored(PTuple(reverse(rev_items)), s.lo, s.hi), c2)
  else
    match parse_pattern(c, depth) of
      PStuck(c2) => PStuck(pat_note_close_if_same(c, c2, ")"))
      PFault(d) => PFault(d)
      PTook(item, c2) =>
        if at_fixed(c2, ")") then
          let c3 = cursor_advance(c2)
          let s = cursor_since(start, c3)
          PTook(
              authored(
                  PTuple(reverse(Cons(item, rev_items))),
                  s.lo,
                  s.hi,
                ),
              c3,
            )
        elif at_fixed(c2, ",") then
          parse_tuple_tail(
              start,
              depth,
              cursor_advance(c2),
              Cons(item, rev_items),
            )
        else
          PStuck(pat_note_sep_or_close(c2, ")"))

fn parse_let_tuple(c : Cursor, depth : Int) : Parsed(Sp(Pat)) =
  parse_tuple_pat(c, depth)
