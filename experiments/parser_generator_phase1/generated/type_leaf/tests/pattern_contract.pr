-- Independently maintained contract fixture for the generated Pattern family.
-- The generator may fingerprint this file, but must never emit or rewrite it.

import Data.List (..)
import Data.Maybe (..)
import Syntax.Source (..)
import Syntax.Token (..)
import Syntax.Ast (..)
import Syntax.Cursor (..)
import Syntax.Parse.Support (..)
import Syntax.Parse.GeneratedControl (..)
import Syntax.Parse.PatternSemantics (..)
import Syntax.Parse.GeneratedPattern (..)

fn pattern_token(
  kind : TokenKind,
  value : Option(String),
  lo : Int,
  hi : Int
) : Token =
  Token {
    kind = kind,
    span = Span { lo = lo, hi = hi },
    value = value
  }

fn fixed(s : String) : Token = pattern_token(TFixed(s), None, 0, 1)

fn word(kind : TokenKind, value : String) : Token =
  pattern_token(kind, Some(value), 0, 1)

fn fixed_at(s : String, lo : Int, hi : Int) : Token =
  pattern_token(TFixed(s), None, lo, hi)

fn word_at(kind : TokenKind, value : String, lo : Int, hi : Int) : Token =
  pattern_token(kind, Some(value), lo, hi)

fn pattern_cursor(tokens : List(Token)) : Cursor =
  cursor_of(tokens, length(tokens))

fn receipt_name(receipt : GeneratedPatternReceipt) : String =
  match receipt of
    PRPlain => "plain"
    PRBareUid => "bare-uid"
    PRBareQual => "bare-qual"

fn let_receipt_name(receipt : GeneratedLetReceipt) : String =
  match receipt of
    GLClosed => "closed"
    GLNamed => "named"

fn expect_pattern_receipt(
  tokens : List(Token),
  depth : Int,
  position : Int,
  wanted : String
) : Unit =
  match generated_parse_pattern(pattern_cursor(tokens), depth) of
    PTook(PatternDone(_, receipt), c) =>
      if (c.pos == position
          && receipt_name(receipt) == wanted
          && cursor_expected(c) == []) then
        ()
      else
        fail()
    _ => fail()

fn expect_pattern_stuck(
  tokens : List(Token),
  depth : Int,
  position : Int,
  wanted : List(String)
) : Unit =
  match generated_parse_pattern(pattern_cursor(tokens), depth) of
    PStuck(c) =>
      if c.pos == position && cursor_canonical(c) == wanted then
        ()
      else
        let actual = cursor_canonical(c)
        println(
            "pattern stuck mismatch: pos {c.pos}/{position}, actual {actual}, wanted {wanted}",
          )
        fail()
    _ => fail()

fn expect_pattern_fault(
  tokens : List(Token),
  depth : Int,
  code : String
) : Unit =
  match generated_parse_pattern(pattern_cursor(tokens), depth) of
    PFault(d) =>
      if d.code == code then
        ()
      else
        fail()
    _ => fail()

fn expect_pattern_done_at(
  tokens : List(Token),
  depth : Int,
  position : Int
) : Unit =
  match generated_parse_pattern(pattern_cursor(tokens), depth) of
    PTook(_, c) =>
      if c.pos == position then
        ()
      else
        fail()
    _ => fail()

fn receipt_menu(receipt : GeneratedPatternReceipt) : List(String) =
  cursor_canonical(
      generated_pattern_note_receipt(pattern_cursor([fixed("?")]), receipt),
    )

fn check_suppression(spellings : List(String)) : Unit =
  match spellings of
    Nil => ()
    Cons(spelling, rest) =>
      let c = pattern_cursor([fixed(spelling)])
      if (cursor_canonical(generated_pattern_note_receipt(c, PRPlain)) /= []
          || cursor_canonical(generated_pattern_note_receipt(c, PRBareUid))
            /= []
          || cursor_canonical(generated_pattern_note_receipt(c, PRBareQual))
            /= []) then
        fail()
      else
        check_suppression(rest)

fn expect_let_receipt(
  tokens : List(Token),
  depth : Int,
  position : Int,
  wanted : String
) : Unit =
  match generated_parse_let_pattern(pattern_cursor(tokens), depth) of
    PTook(LetDone(_, receipt), c) =>
      if c.pos == position && let_receipt_name(receipt) == wanted then
        ()
      else
        fail()
    _ => fail()

fn expect_let_menu(tokens : List(Token), wanted : List(String)) : Unit =
  match generated_parse_let_pattern(pattern_cursor(tokens), 3) of
    PTook(LetDone(_, receipt), c) =>
      let with_equal = cursor_note(c, TFixed("="))
      if (cursor_canonical(generated_let_note_receipt(with_equal, receipt))
          == wanted) then
        ()
      else
        fail()
    _ => fail()

-- Minimal callbacks for checking the family-neutral separated-list contract.
fn control_item(c : Cursor, _depth : Int) : Parsed(String) =
  take_word(c, TIdent)

fn control_same_miss(c : Cursor, _depth : Int) : Parsed(String) =
  PStuck(cursor_note_name(c, "same-miss"))

fn control_deep_miss(c : Cursor, _depth : Int) : Parsed(String) =
  PStuck(cursor_note_name(cursor_advance(c), "deep-miss"))

fn control_value(value : String) : String = value

fn control_receipt(value : String) : String = value

fn control_enter(
  _phase : GeneratedSeparatedPhase,
  _c : Cursor,
  _close : String
) : GeneratedSeparatedDecision =
  GSEnter

fn control_reject_all(
  _phase : GeneratedSeparatedPhase,
  c : Cursor,
  _close : String
) : GeneratedSeparatedDecision =
  GSReject(cursor_note_name(c, "unexpected-before"))

fn control_reject_after(
  phase : GeneratedSeparatedPhase,
  c : Cursor,
  _close : String
) : GeneratedSeparatedDecision =
  match phase of
    GSRequiredFirst => GSEnter
    GSInitial => GSEnter
    GSAfterSeparator => GSReject(cursor_note_name(c, "after-separator"))

fn control_phase_follow(
  phase : GeneratedSeparatedPhase,
  c : Cursor,
  _receipt : String,
  _close : String
) : Cursor =
  match phase of
    GSRequiredFirst => cursor_note_name(c, "required-follow")
    GSInitial => cursor_note_name(c, "initial-follow")
    GSAfterSeparator => cursor_note_name(c, "after-follow")

fn control_unused_follow(
  _phase : GeneratedSeparatedPhase,
  c : Cursor,
  _receipt : String,
  _close : String
) : Cursor =
  cursor_note_name(c, "unused-follow")

fn check_control_contract() : Unit =
  -- A close token in a non-required phase bypasses both policy and parse_item.
  match (generated_separated(
        pattern_cursor([fixed(")")]),
        0,
        ")",
        GSInitial,
        control_same_miss,
        control_value,
        control_receipt,
        control_reject_all,
        control_unused_follow,
        [],
      )) of
    PTook(Nil, c) =>
      if c.pos == 1 then
        ()
      else
        fail()
    _ => fail()
  -- The recursive call after a comma exposes GSAfterSeparator to before_item.
  match (generated_separated(
        pattern_cursor([word(TIdent, "x"), fixed(","), fixed("?")]),
        0,
        ")",
        GSInitial,
        control_item,
        control_value,
        control_receipt,
        control_reject_after,
        control_unused_follow,
        [],
      )) of
    PStuck(c) =>
      if c.pos == 2 && cursor_canonical(c) == ["after-separator"] then
        ()
      else
        fail()
    _ => fail()
  -- note_follow sees the phase in which its successfully parsed item began.
  match (generated_separated(
        pattern_cursor([word(TIdent, "x"), fixed("?")]),
        0,
        ")",
        GSInitial,
        control_item,
        control_value,
        control_receipt,
        control_enter,
        control_phase_follow,
        [],
      )) of
    PStuck(c) =>
      if c.pos == 1 && cursor_canonical(c) == ["initial-follow"] then
        ()
      else
        fail()
    _ => fail()
  match (generated_separated(
        pattern_cursor([
            word(TIdent, "x"),
            fixed(","),
            word(TIdent, "y"),
            fixed("?"),
          ]),
        0,
        ")",
        GSInitial,
        control_item,
        control_value,
        control_receipt,
        control_enter,
        control_phase_follow,
        [],
      )) of
    PStuck(c) =>
      if c.pos == 3 && cursor_canonical(c) == ["after-follow"] then
        ()
      else
        fail()
    _ => fail()
  -- A same-position child miss gains the close; a deeper miss keeps only its
  -- deeper expectation.
  match (generated_separated(
        pattern_cursor([fixed("?")]),
        0,
        ")",
        GSInitial,
        control_same_miss,
        control_value,
        control_receipt,
        control_enter,
        control_unused_follow,
        [],
      )) of
    PStuck(c) =>
      if c.pos == 0 && cursor_canonical(c) == [")", "same-miss"] then
        ()
      else
        fail()
    _ => fail()
  match (generated_separated(
        pattern_cursor([fixed("?")]),
        0,
        ")",
        GSInitial,
        control_deep_miss,
        control_value,
        control_receipt,
        control_enter,
        control_unused_follow,
        [],
      )) of
    PStuck(c) =>
      if c.pos == 1 && cursor_canonical(c) == ["deep-miss"] then
        ()
      else
        fail()
    _ => fail()

fn check_receipts_and_suppression() : Unit =
  if receipt_menu(PRPlain) /= ["|"] then
    fail()
  if receipt_menu(PRBareUid) /= ["(", "\{", "|"] then
    fail()
  if receipt_menu(PRBareQual) /= ["(", "|"] then
    fail()
  expect_pattern_receipt([word(TUid, "A"), fixed("?")], 2, 1, "bare-uid")
  expect_pattern_receipt([word(TQual, "Pkg.A"), fixed("?")], 2, 1, "bare-qual")
  expect_pattern_receipt([word(TIdent, "x"), fixed("?")], 2, 1, "plain")
  expect_pattern_receipt(
      [word(TUid, "A"), fixed("("), fixed(")"), fixed("?")],
      2,
      3,
      "plain",
    )
  expect_pattern_receipt(
      [word(TUid, "A"), fixed("\{"), fixed("\}"), fixed("?")],
      2,
      3,
      "plain",
    )
  -- Pattern alternatives inherit the completion state of their final arm.
  expect_pattern_receipt(
      [word(TUid, "A"), fixed("|"), word(TUid, "B"), fixed("?")],
      2,
      3,
      "bare-uid",
    )
  expect_pattern_receipt(
      [word(TUid, "A"), fixed("|"), word(TQual, "Pkg.B"), fixed("?")],
      2,
      3,
      "bare-qual",
    )
  expect_pattern_receipt(
      [
          word(TUid, "A"),
          fixed("|"),
          word(TUid, "B"),
          fixed("("),
          fixed(")"),
          fixed("?"),
        ],
      2,
      5,
      "plain",
    )
  check_suppression([":", ":=", "if", "=>", ")", "]", "\}"])

fn check_delimited_receipts() : Unit =
  let first_with_paren = [
      "(",
      ")",
      "-",
      "[",
      "char",
      "false",
      "float",
      "ident",
      "int",
      "qual",
      "true",
      "uid",
    ]
  let first_with_square = [
      "(",
      "-",
      "[",
      "]",
      "char",
      "false",
      "float",
      "ident",
      "int",
      "qual",
      "true",
      "uid",
    ]
  -- PatArgs: initial, after-item, after-separator, and the `]` override.
  expect_pattern_stuck(
      [word(TUid, "C"), fixed("("), fixed("\}")],
      3,
      2,
      first_with_paren,
    )
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TUid, "A"), fixed("?")], 3, 3, [
      "(",
      ")",
      ",",
      "\{",
      "|",
    ])
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TQual, "Pkg.A"), fixed("?")], 3, 3, [
      "(",
      ")",
      ",",
      "|",
    ])
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TIdent, "x"), fixed("?")], 3, 3, [
      ")",
      ",",
      "|",
    ])
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TUid, "A"), fixed("("), fixed(")"), fixed("?")], 3, 5, [
      ")",
      ",",
      "|",
    ])
  expect_pattern_stuck(
      [word(TUid, "C"), fixed("("), word(TUid, "A"), fixed(","), fixed("\}")],
      3,
      4,
      first_with_paren,
    )
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TUid, "A"), fixed("]")], 3, 3, [
      ")",
    ])
  expect_pattern_stuck([word(TUid, "C"), fixed("("), word(TUid, "A"), fixed(","), fixed("]")], 3, 4, [
      ")",
    ])
  println("pattern-contract: delimiters args")
  -- CommaPlus<Pattern> keeps full first-item menus, then applies the local
  -- rest-list wrong-`)` override after a second item has begun.
  expect_pattern_stuck([fixed("["), fixed(")")], 3, 1, first_with_square)
  expect_pattern_stuck([fixed("["), word(TUid, "A"), fixed("?")], 3, 2, [
      "(",
      ",",
      "]",
      "\{",
      "|",
    ])
  expect_pattern_stuck([fixed("["), word(TUid, "A"), fixed(")")], 3, 2, [
      ",",
      "]",
    ])
  expect_pattern_stuck(
      [fixed("["), word(TUid, "A"), fixed(","), fixed("?")],
      3,
      3,
      first_with_square,
    )
  expect_pattern_stuck([fixed("["), word(TUid, "A"), fixed(","), word(TUid, "B"), fixed(")")], 3, 4, [
      "]",
    ])
  expect_pattern_stuck([fixed("["), word(TUid, "A"), fixed(","), word(TUid, "B"), fixed(","), fixed(")")], 3, 5, [
      "]",
    ])
  println("pattern-contract: delimiters list")
  -- Tuple first-item and rest-list phases differ deliberately.
  expect_pattern_stuck([fixed("("), fixed(")")], 3, 1, [
      "(",
      "-",
      "[",
      "char",
      "false",
      "float",
      "ident",
      "int",
      "qual",
      "true",
      "uid",
    ])
  expect_pattern_stuck([fixed("("), word(TUid, "A"), fixed("?")], 3, 2, [
      "(",
      ",",
      "\{",
      "|",
    ])
  expect_pattern_stuck(
      [fixed("("), word(TUid, "A"), fixed(","), fixed("]")],
      3,
      3,
      first_with_paren,
    )
  expect_pattern_stuck([fixed("("), word(TUid, "A"), fixed(","), word(TUid, "B"), fixed("]")], 3, 4, [
      ")",
    ])
  expect_pattern_stuck([fixed("("), word(TUid, "A"), fixed(","), word(TUid, "B"), fixed(","), fixed("]")], 3, 5, [
      ")",
    ])
  println("pattern-contract: delimiters tuple")
  -- Record entry, shorthand, explicit-child, spread, and post-comma phases.
  expect_pattern_stuck([word(TUid, "A"), fixed("\{"), fixed("]")], 3, 2, [
      "..",
      "ident",
      "\}",
    ])
  expect_pattern_stuck([word(TUid, "A"), fixed("\{"), word(TIdent, "x"), fixed("?")], 3, 3, [
      ",",
      "=",
      "\}",
    ])
  expect_pattern_stuck([word(TUid, "A"), fixed("\{"), word(TIdent, "x"), fixed("="), word(TUid, "B"), fixed("?")], 3, 5, [
      "(",
      ",",
      "\{",
      "|",
      "\}",
    ])
  expect_pattern_stuck([word(TUid, "A"), fixed("\{"), word(TIdent, "x"), fixed(","), fixed("]")], 3, 4, [
      "..",
      "ident",
      "\}",
    ])
  expect_pattern_stuck([word(TUid, "A"), fixed("\{"), fixed(".."), fixed("]")], 3, 3, [
      "\}",
    ])
  println("pattern-contract: delimiters record")

fn check_let_receipts() : Unit =
  expect_let_receipt([word(TUid, "A"), fixed("[")], 2, 1, "named")
  expect_let_receipt([word(TQual, "Pkg.A"), fixed("[")], 2, 1, "named")
  expect_let_receipt(
      [word(TUid, "A"), fixed("("), fixed(")"), fixed("[")],
      2,
      3,
      "closed",
    )
  expect_let_menu([word(TUid, "A"), fixed("[")], ["(", "="])
  expect_let_menu([word(TQual, "Pkg.A"), fixed("[")], ["(", "="])
  expect_let_menu([word(TUid, "A"), fixed("("), fixed(")"), fixed("[")], ["="])

fn check_accepted_ast_and_spans() : Unit =
  let bare = [word_at(TUid, "A", 0, 1)]
  let closed =
    [word_at(TUid, "A", 0, 1), fixed_at("(", 1, 2), fixed_at(")", 2, 3)]
  match generated_parse_pattern(cursor_of(bare, 1), 2) of
    PTook(
      PatternDone(
        Sp { node = PCtor(name, Nil), span = Span { lo = 0, hi = 1 }, .. },
        PRBareUid
      ),
      c
    ) =>
      if name == "A" && c.pos == 1 then
        ()
      else
        fail()
    _ => fail()
  match generated_parse_pattern(cursor_of(closed, 3), 2) of
    PTook(
      PatternDone(
        Sp { node = PCtor(name, Nil), span = Span { lo = 0, hi = 3 }, .. },
        PRPlain
      ),
      c
    ) =>
      if name == "A" && c.pos == 3 then
        ()
      else
        fail()
    _ => fail()
  let list_tokens = [
      fixed_at("[", 0, 1),
      word_at(TIdent, "x", 1, 2),
      fixed_at(",", 2, 3),
      word_at(TIdent, "y", 3, 4),
      fixed_at("]", 4, 5),
    ]
  match generated_parse_pattern(cursor_of(list_tokens, 5), 3) of
    PTook(
      PatternDone(
        Sp {
          node = PCtor(
            cons1,
            Cons(
              Sp { node = PVar(x), span = x_span, .. },
              Cons(
                Sp {
                  node = PCtor(
                    cons2,
                    Cons(
                      Sp { node = PVar(y), span = y_span, .. },
                      Cons(
                        Sp { node = PCtor(nil, Nil), span = nil_span, .. },
                        Nil
                      )
                    )
                  ),
                  span = inner_span,
                  ..
                },
                Nil
              )
            )
          ),
          span = outer_span,
          ..
        },
        PRPlain
      ),
      c
    ) =>
      if (cons1 == "Cons"
          && cons2 == "Cons"
          && nil == "Nil"
          && x == "x"
          && y == "y"
          && x_span == Span { lo = 1, hi = 2 }
          && y_span == Span { lo = 3, hi = 4 }
          && nil_span == Span { lo = 5, hi = 5 }
          && inner_span == Span { lo = 3, hi = 4 }
          && outer_span == Span { lo = 0, hi = 5 }
          && c.pos == 5) then
        ()
      else
        fail()
    _ => fail()
  let tuple_tokens = [
      fixed_at("(", 0, 1),
      word_at(TIdent, "x", 1, 2),
      fixed_at(",", 2, 3),
      word_at(TIdent, "y", 3, 4),
      fixed_at(")", 4, 5),
    ]
  match generated_parse_pattern(cursor_of(tuple_tokens, 5), 3) of
    PTook(
      PatternDone(
        Sp {
          node = PTuple(
            Cons(
              Sp { node = PVar(x), span = x_span, .. },
              Cons(Sp { node = PVar(y), span = y_span, .. }, Nil)
            )
          ),
          span = outer_span,
          ..
        },
        PRPlain
      ),
      c
    ) =>
      if (x == "x"
          && y == "y"
          && x_span == Span { lo = 1, hi = 2 }
          && y_span == Span { lo = 3, hi = 4 }
          && outer_span == Span { lo = 0, hi = 5 }
          && c.pos == 5) then
        ()
      else
        fail()
    _ => fail()
  let record_tokens = [
      word_at(TUid, "A", 0, 1),
      fixed_at("\{", 1, 2),
      word_at(TIdent, "x", 2, 3),
      fixed_at(",", 3, 4),
      word_at(TIdent, "y", 4, 5),
      fixed_at("=", 5, 6),
      word_at(TInt, "0", 6, 7),
      fixed_at("\}", 7, 8),
    ]
  match generated_parse_pattern(cursor_of(record_tokens, 8), 3) of
    PTook(
      PatternDone(
        Sp {
          node = PRecord(
            record_name,
            Cons(
              PatField {
                name = x_field,
                pat = Sp { node = PVar(x), span = x_span, .. },
              },
              Cons(
                PatField {
                  name = y_field,
                  pat = Sp { node = PInt(zero, SufNone), span = zero_span, .. },
                },
                Nil
              )
            ),
            false
          ),
          span = outer_span,
          ..
        },
        PRPlain
      ),
      c
    ) =>
      if (record_name == "A"
          && x_field == "x"
          && x == "x"
          && y_field == "y"
          && zero == "0"
          && x_span == Span { lo = 2, hi = 3 }
          && zero_span == Span { lo = 6, hi = 7 }
          && outer_span == Span { lo = 0, hi = 8 }
          && c.pos == 8) then
        ()
      else
        fail()
    _ => fail()
  -- Empty and trailing forms are separate grammar alternatives/paths.
  expect_pattern_done_at([word(TUid, "A"), fixed("("), fixed(")")], 2, 3)
  expect_pattern_done_at(
      [word(TUid, "A"), fixed("("), word(TIdent, "x"), fixed(","), fixed(")")],
      3,
      5,
    )
  expect_pattern_done_at(
      [fixed("["), word(TIdent, "x"), fixed(","), fixed("]")],
      3,
      4,
    )
  expect_pattern_done_at([word(TUid, "A"), fixed("\{"), fixed("\}")], 2, 3)
  expect_pattern_done_at(
      [
          word(TUid, "A"),
          fixed("\{"),
          word(TIdent, "x"),
          fixed(","),
          fixed("\}"),
        ],
      3,
      5,
    )

fn check_depth_contract() : Unit =
  expect_pattern_fault([word(TIdent, "x")], 0, "E7102")
  expect_pattern_done_at([word(TIdent, "x")], 1, 1)
  let ctor = [word(TUid, "A"), fixed("("), word(TIdent, "x"), fixed(")")]
  let list = [fixed("["), word(TIdent, "x"), fixed("]")]
  let tuple = [fixed("("), word(TIdent, "x"), fixed(","), fixed(")")]
  let record = [
      word(TUid, "A"),
      fixed("\{"),
      word(TIdent, "x"),
      fixed("="),
      word(TIdent, "x"),
      fixed("\}"),
    ]
  expect_pattern_fault(ctor, 1, "E7102")
  expect_pattern_fault(list, 1, "E7102")
  expect_pattern_fault(tuple, 1, "E7102")
  expect_pattern_fault(record, 1, "E7102")
  expect_pattern_done_at(ctor, 2, 4)
  expect_pattern_done_at(list, 2, 3)
  expect_pattern_done_at(tuple, 2, 4)
  expect_pattern_done_at(record, 2, 6)
  -- Siblings reuse the same remaining budget.
  expect_pattern_done_at(
      [
          word(TUid, "A"),
          fixed("("),
          word(TIdent, "x"),
          fixed(","),
          word(TIdent, "y"),
          fixed(")"),
        ],
      2,
      6,
    )
  expect_pattern_done_at(
      [
          fixed("["),
          word(TIdent, "x"),
          fixed(","),
          word(TIdent, "y"),
          fixed("]"),
        ],
      2,
      5,
    )
  expect_pattern_done_at(
      [
          fixed("("),
          word(TIdent, "x"),
          fixed(","),
          word(TIdent, "y"),
          fixed(")"),
        ],
      2,
      5,
    )
  expect_pattern_done_at(
      [
          word(TUid, "A"),
          fixed("\{"),
          word(TIdent, "x"),
          fixed("="),
          word(TIdent, "x"),
          fixed(","),
          word(TIdent, "y"),
          fixed("="),
          word(TIdent, "y"),
          fixed("\}"),
        ],
      2,
      10,
    )
  match (generated_parse_let_pattern(
        pattern_cursor([
            word(TUid, "A"),
            fixed("("),
            word(TIdent, "x"),
            fixed(")"),
          ]),
        1,
      )) of
    PFault(d) =>
      if d.code == "E7102" then
        ()
      else
        fail()
    _ => fail()
  match (generated_parse_let_pattern(
        pattern_cursor([
            word(TUid, "A"),
            fixed("("),
            word(TIdent, "x"),
            fixed(")"),
          ]),
        2,
      )) of
    PTook(LetDone(_, GLClosed), c) =>
      if c.pos == 4 then
        ()
      else
        fail()
    _ => fail()

