test fn generated_typearg_spends_before_forwarding_depth() =
  let c1 = cursor_of([word(TIdent, "x")], 1)
  match (generated_parse_type_arg_with(
        c1,
        6,
        generated_type_body,
        generated_row_body,
      )) of
    PFault(d) =>
      if d.message == "type body depth changed" then
        ()
      else
        fail()
    _ => fail()
  let c2 = cursor_of([fixed("\{"), fixed("\}")], 2)
  match (generated_parse_type_arg_with(
        c2,
        6,
        generated_type_body,
        generated_row_body,
      )) of
    PFault(d) =>
      if d.message == "row body depth changed" then
        ()
      else
        fail()
    _ => fail()

test fn generated_atype_uses_checked_typearg_callback() =
  match (parse_generated([
        word(TUid, "Vec"),
        fixed("("),
        located(TInt, "3i64", 4, 8),
        fixed(")"),
      ])) of
    PFault(d) =>
      if (d.span == Span { lo = 4, hi = 8 }
          && d.message
            == "a dimension is a plain natural literal; drop the width suffix") then
        ()
      else
        fail()
    _ => fail()

fn parse_full_type(ts : List(Token), depth : Int) : Parsed(GeneratedChild(Ty)) =
  generated_parse_type(cursor_of(ts, length(ts)), depth)

test fn generated_type_spine_depth_spends_once_per_authored_edge() =
  match parse_full_type([fixed("Int")], 1) of
    PTook(TypeDone(TyInt, TRPlain), c) =>
      if c.pos == 1 then
        ()
      else
        fail()
    _ => fail()
  match generated_parse_type_arg(cursor_of([fixed("Int")], 1), 1) of
    PTook(TypeDone(TyInt, TRPlain), c) =>
      if c.pos == 1 then
        ()
      else
        fail()
    _ => fail()
  let nested = [word(TUid, "List"), fixed("("), fixed("Int"), fixed(")")]
  match parse_full_type(nested, 1) of
    PFault(_) => ()
    _ => fail()
  match parse_full_type(nested, 2) of
    PTook(TypeDone(TyCon(name, Cons(TyInt, Nil)), TRPlain), c) =>
      if name == "List" && c.pos == 4 then
        ()
      else
        fail()
    _ => fail()

test fn generated_type_spine_preserves_recursive_receipts() =
  match (parse_full_type(
        [fixed("forall"), word(TIdent, "a"), fixed("."), word(TIdent, "x")],
        2,
      )) of
    PTook(TypeDone(TyForall(vars, TyVar(name)), TRNamed), c) =>
      if vars == ["a"] && name == "x" && c.pos == 4 then
        ()
      else
        fail()
    _ => fail()
  match (parse_full_type([fixed("("), fixed(")"), fixed("->"), word(TIdent, "x")], 2)) of
    PTook(TypeDone(TyFun(Nil, _, TyVar(name)), TRNamed), c) =>
      if name == "x" && c.pos == 4 then
        ()
      else
        fail()
    _ => fail()
  match (parse_full_type([fixed("Int"), fixed("->"), word(TIdent, "x")], 2)) of
    PTook(TypeDone(TyFun(Cons(TyInt, Nil), _, TyVar(name)), TRNamed), c) =>
      if name == "x" && c.pos == 3 then
        ()
      else
        fail()
    _ => fail()

test fn generated_type_spine_retags_usage_and_effects() =
  match (parse_full_type([fixed("Int"), fixed("@"), word(TIdent, "once")], 1)) of
    PTook(TypeDone(TyUsage(TyInt, facts), TRUsage), c) =>
      if facts == ["once"] && c.pos == 3 then
        ()
      else
        fail()
    _ => fail()
  match (parse_full_type([fixed("Int"), fixed("->"), fixed("Int"), fixed("!")], 2)) of
    PTook(TypeDone(TyFun(Cons(TyInt, Nil), _, TyInt), TRBareEffect), c) =>
      if c.pos == 4 then
        ()
      else
        fail()
    _ => fail()
  match (parse_full_type(
        [
            fixed("Int"),
            fixed("->"),
            fixed("Int"),
            fixed("!"),
            fixed("\{"),
            word(TUid, "Io"),
            fixed("\}"),
          ],
        2,
      )) of
    PTook(
      TypeDone(
        TyFun(
          Cons(TyInt, Nil),
          Row { labels = Cons(label, Nil), tail = None },
          TyInt
        ),
        TRClosedEffect
      ),
      c
    ) =>
      if label.name == "Io" && c.pos == 7 then
        ()
      else
        fail()
    _ => fail()

