test fn generated_typearg_rows_enter_after_open_and_keep_depth() =
  match parse_generated_type_arg([fixed("\{"), fixed("\}")]) of
    PTook(TypeDone(TyRowLit(Row { labels = Nil, tail = None }), TRRow), c) =>
      if c.pos == 2 then
        ()
      else
        fail()
    _ => fail()
  match (parse_generated_type_arg([
        fixed("\{"),
        fixed("|"),
        word(TIdent, "e"),
        fixed("\}"),
      ])) of
    PTook(TypeDone(TyRowLit(Row { labels = Nil, tail = Some(tail) }), TRRow), c) =>
      if tail == "e" && c.pos == 4 then
        ()
      else
        fail()
    _ => fail()
  match (parse_generated_type_arg([
        fixed("\{"),
        word(TUid, "Io"),
        fixed("|"),
        word(TIdent, "e"),
        fixed("\}"),
      ])) of
    PTook(
      TypeDone(
        TyRowLit(Row { labels = Cons(label, Nil), tail = Some(tail) }),
        TRRow
      ),
      c
    ) =>
      if label.name == "Io" && tail == "e" && c.pos == 5 then
        ()
      else
        fail()
    _ => fail()

test fn generated_typearg_row_misses_are_exact() =
  match parse_generated_type_arg([fixed("\{"), fixed("]")]) of
