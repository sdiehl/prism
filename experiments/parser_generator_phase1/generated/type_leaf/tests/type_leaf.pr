test fn generated_type_head_forall_leaves_effect_suffix() =
  let ts = [
      fixed("forall"),
      word(TIdent, "a"),
      fixed("."),
      word(TIdent, "a"),
      fixed("!"),
      fixed("\{"),
      word(TUid, "Io"),
      fixed("\}"),
    ]
  match generated_parse_type_head(cursor_of(ts, length(ts)), 2) of
    PTook(TypeDone(TyForall(vars, TyVar(name)), TRNamed), c) =>
      if vars == ["a"] && name == "a" && c.pos == 4 then
        ()
      else
        fail()
    _ => fail()
