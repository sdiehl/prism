test fn generated_receipt_schema_all_eight_menus() =
  let c = cursor_of([fixed("?")], 1)
  if (cursor_canonical(generated_type_note_receipt(c, TRPlain))
      /= ["!", "->", "@"]) then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRNamed))
      /= ["!", "(", "->", "@"]) then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRUsage)) /= ["!", "->"]) then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRBareEffect))
      /= ["@", "\{"]) then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRClosedEffect)) /= ["@"]) then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRNat)) /= ["+"]) then
    fail()
  if cursor_canonical(generated_type_note_receipt(c, TRRow)) /= [] then
    fail()
  if (cursor_canonical(generated_type_note_receipt(c, TRDimIdent))
      /= ["!", "(", "+", "->", "@"]) then
    fail()
  if (generated_type_receipt_always_live(TRNat)
      && generated_type_receipt_always_live(TRDimIdent)
      && not(generated_type_receipt_always_live(TRPlain))) then
    ()
  else
    fail()

