test fn generated_typearg_first_merge_and_partial_failure() =
  match parse_generated_type_arg([fixed("]")]) of
    PStuck(c) =>
      if (cursor_canonical(c)
          == [
              "#",
              "(",
              "Bool",
              "Char",
              "Float",
              "I64",
              "Int",
              "String",
              "U64",
              "Unit",
              "[",
              "forall",
              "ident",
              "int",
              "qual",
              "uid",
              "\{",
            ]) then
        ()
      else
