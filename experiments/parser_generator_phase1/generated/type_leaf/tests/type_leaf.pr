test fn generated_typearg_suffix_fault_is_exact() =
  match parse_generated_type_arg([located(TInt, "3i64", 4, 8)]) of
    PFault(d) =>
      if (d.span == Span { lo = 4, hi = 8 }
          && d.message
            == "a dimension is a plain natural literal; drop the width suffix") then
        ()
      else
        fail()
    _ => fail()

test fn generated_typearg_overflow_fault_is_exact() =
  match (parse_generated_type_arg([located(TInt, "18446744073709551616", 2, 22)])) of
    PFault(d) =>
      if (d.span == Span { lo = 2, hi = 22 }
          && d.message == "dimension literal is too large") then
        ()
      else
        fail()
    _ => fail()

test fn generated_typearg_dimension_decline_consumes_full_run() =
  match (parse_generated_type_arg([
        located(TIdent, "n", 0, 1),
        located(TFixed("+"), "+", 1, 2),
        located(TInt, "1", 2, 3),
        located(TFixed("+"), "+", 3, 4),
        located(TIdent, "m", 4, 5),
      ])) of
    PFault(d) =>
      if (d.span == Span { lo = 0, hi = 5 }
          && d.message
            == "arithmetic on dimensions is not supported: a dimension is a plain natural literal (`0`, `1`, `2`, ...) or a type variable, and dimensions unify by equality only") then
        ()
      else
        fail()
    _ => fail()

test fn generated_typearg_malformed_dimension_tail_stays_structural() =
  match (parse_generated_type_arg([word(TIdent, "n"), fixed("+"), fixed("]")])) of
    PStuck(c) =>
      if c.pos == 2 && cursor_canonical(c) == ["ident", "int"] then
        ()
      else
        fail()
    _ => fail()
  match (parse_generated_type_arg([
        generated_test_token(TInt, Some("3")),
        fixed("+"),
        generated_test_token(TInt, Some("1")),
        fixed("+"),
      ])) of
    PStuck(c) =>
      if c.pos == 4 && cursor_canonical(c) == ["ident", "int"] then
        ()
      else
        fail()
    _ => fail()

