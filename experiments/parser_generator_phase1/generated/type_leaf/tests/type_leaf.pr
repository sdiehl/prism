-- Independently maintained behavior fixture for the generated Type slice.
-- The generator reads and fingerprints this file but never emits or rewrites it.

import Data.List (..)

import Data.Maybe (..)

import Syntax.Source (..)

import Syntax.Token (..)

import Syntax.Ast (..)

import Syntax.Cursor (..)

import Syntax.Parse.Support (..)

import GeneratedTypeLeaf (..)

fn generated_test_token(k : TokenKind, value : Option(String)) : Token =
  Token {
    kind = k,
    span = Span { lo = 0, hi = 1 },
    value = value
  }

fn fixed(s : String) : Token = generated_test_token(TFixed(s), None)

fn word(k : TokenKind, s : String) : Token = generated_test_token(k, Some(s))

fn located(k : TokenKind, s : String, lo : Int, hi : Int) : Token =
  Token {
    kind = k,
    span = Span { lo = lo, hi = hi },
    value = Some(s)
  }

fn child_done(
  value : Ty,
  c : Cursor,
  receipt : GeneratedTypeReceipt
) : Parsed(GeneratedChild(Ty)) =
  PTook(TypeDone(value, receipt), c)

fn note_type_start(c : Cursor) : Cursor =
  foldl(cursor_note, c, [
      TFixed("#"),
      TFixed("("),
      TFixed("Bool"),
      TFixed("Char"),
      TFixed("Float"),
      TFixed("I64"),
      TFixed("Int"),
      TFixed("String"),
      TFixed("U64"),
      TFixed("Unit"),
      TFixed("["),
      TFixed("forall"),
      TIdent,
      TQual,
      TUid,
    ])

fn note_type_arg_start(c : Cursor) : Cursor =
  cursor_note(cursor_note(note_type_start(c), TInt), TFixed("\{"))

fn generated_child(c : Cursor, depth : Int) : Parsed(GeneratedChild(Ty)) =
  if depth == 7 || depth == 6 then
    match cursor_peek(c) of
      Some(t) =>
        if t.kind == TFixed("Int") then
          child_done(TyInt, cursor_advance(c), TRPlain)
        elif t.kind == TFixed("Bool") then
          child_done(TyBool, cursor_advance(c), TRPlain)
        elif t.kind == TIdent then
          child_done(TyVar(token_text(t)), cursor_advance(c), TRNamed)
        elif t.kind == TFixed("[") then
          PStuck(cursor_note(cursor_advance(c), TFixed("Int")))
        else
          PStuck(note_type_start(c))
      None => PStuck(note_type_start(c))
  else
    PFault(refuse(cursor_span(c), "child depth changed"))

fn generated_arg_child(c : Cursor, depth : Int) : Parsed(GeneratedChild(Ty)) =
  generated_parse_type_arg_with(
      c,
      depth,
      generated_type_body,
      generated_row_body,
    )

fn generated_type_body(c : Cursor, depth : Int) : Parsed(GeneratedChild(Ty)) =
  if depth /= 7 && depth /= 6 then
    PFault(refuse(cursor_span(c), "type body depth changed"))
  else
    match cursor_peek(c) of
      Some(t) =>
        if t.kind == TIdent then
          let name = token_text(t)
          let c1 = cursor_advance(c)
          if at_fixed(c1, "(") then
            let c2 = cursor_advance(c1)
            if (at_fixed(c2, "Int") && at_fixed(cursor_advance(c2), ")")) then
              child_done(
                  TyApp(name, [TyInt]),
                  cursor_advance(cursor_advance(c2)),
                  TRPlain,
                )
            else
              PStuck(cursor_note(c2, TFixed("Int")))
          elif at_fixed(c1, "@") then
            let c2 = cursor_advance(c1)
            if at_kind(c2, TIdent) then
              child_done(TyVar(name), cursor_advance(c2), TRUsage)
            else
              PStuck(cursor_note(c2, TIdent))
          elif at_fixed(c1, "->") then
            let c2 = cursor_advance(c1)
            if at_fixed(c2, "Int") then
              child_done(TyVar(name), cursor_advance(c2), TRPlain)
            else
              PStuck(cursor_note(c2, TFixed("Int")))
          else
            child_done(TyVar(name), c1, TRNamed)
        else
          generated_child(c, depth)
      None => PStuck(note_type_start(c))

fn generated_row_body(c : Cursor, depth : Int) : Parsed(Row) =
  if depth /= 7 && depth /= 6 then
    PFault(refuse(cursor_span(c), "row body depth changed"))
  elif at_fixed(c, "\}") then
    PTook(Row { labels = Nil, tail = None }, cursor_advance(c))
  elif at_fixed(c, "|") then
    let c1 = cursor_advance(c)
    match take_word(c1, TIdent) of
      PTook(tail, c2) =>
        if at_fixed(c2, "\}") then
          PTook(Row { labels = Nil, tail = Some(tail) }, cursor_advance(c2))
        else
          PStuck(cursor_note(c2, TFixed("\}")))
      PStuck(c2) => PStuck(c2)
      PFault(d) => PFault(d)
  elif at_kind(c, TUid) || at_kind(c, TQual) || at_kind(c, TIdent) then
    let label = EffLabel { name = peek_word(c), args = Nil }
    let c1 = cursor_advance(c)
    if at_fixed(c1, "\}") then
      PTook(Row { labels = [label], tail = None }, cursor_advance(c1))
    elif at_fixed(c1, "|") then
      let c2 = cursor_advance(c1)
      match take_word(c2, TIdent) of
        PTook(tail, c3) =>
          if at_fixed(c3, "\}") then
            PTook(
                Row { labels = [label], tail = Some(tail) },
                cursor_advance(c3),
              )
          else
            PStuck(cursor_note(c3, TFixed("\}")))
        PStuck(c3) => PStuck(c3)
        PFault(d) => PFault(d)
    elif at_fixed(c1, ",") then
      generated_row_miss(cursor_advance(c1))
    else
      PStuck(cursor_note(cursor_note(c1, TFixed("|")), TFixed("\}")))
  else
    generated_row_miss(c)

fn generated_row_miss(c : Cursor) : Parsed(Row) =
  PStuck(foldl(cursor_note, c, [
      TIdent,
      TQual,
      TUid,
      TFixed("|"),
      TFixed("\}"),
    ]))

fn parse_generated_type_arg(ts : List(Token)) : Parsed(GeneratedChild(Ty)) =
  generated_parse_type_arg_with(
      cursor_of(ts, length(ts)),
      8,
      generated_type_body,
      generated_row_body,
    )

type TestATypeCompletion = TCPlain | TCNamed

fn test_value(done : GeneratedChild(Ty)) : Ty =
  match done of
    TypeDone(t, _) => t

fn test_completion(done : GeneratedChild(Ty)) : TestATypeCompletion =
  match done of
    TypeDone(_, TRPlain) => TCPlain
    TypeDone(_, TRNamed) => TCNamed
    _ => TCPlain

fn parse_generated(ts : List(Token)) : Parsed(GeneratedChild(Ty)) =
  generated_parse_atype(
      cursor_of(ts, length(ts)),
      7,
      generated_child,
      generated_arg_child,
    )

test fn generated_atype_int() =
  match parse_generated([fixed("Int")]) of
    PTook(done, c1) =>
      match test_completion(done) of
        TCPlain =>
          match test_value(done) of
            TyInt =>
              if c1.pos == 1 then
                ()
              else
                fail()
            _ => fail()
        _ => fail()
    _ => fail()

