type Expr
  = Lit(Int)
  | Add(Expr, Expr)
  | Sub(Expr, Expr)
  | Mul(Expr, Expr)
  | Div(Expr, Expr)
  | Neg(Expr)

fn eval(e) : Result(Int, Int) =
  match e of
    Lit(n) => Ok(n)
    Neg(a) =>
      let value = eval(a)?
      Ok(-value)
    Add(a, b) =>
      let x = eval(a)?
      let y = eval(b)?
      Ok(x + y)
    Sub(a, b) =>
      let x = eval(a)?
      let y = eval(b)?
      Ok(x - y)
    Mul(a, b) =>
      let x = eval(a)?
      let y = eval(b)?
      Ok(x * y)
    Div(a, b) =>
      let d = eval(b)?
      if d == 0 then
        Err(-1)
      else
        let n = eval(a)?
        Ok(n / d)

fn depth(e) : Int =
  match e of
    Lit(_) => 0
    Neg(a) => 1 + depth(a)
    Add(a, b) => 1 + max(depth(a), depth(b))
    Sub(a, b) => 1 + max(depth(a), depth(b))
    Mul(a, b) => 1 + max(depth(a), depth(b))
    Div(a, b) => 1 + max(depth(a), depth(b))

fn show_result(r : Result(Int, a)) : Unit ! {IO} =
  match r of
    Ok(v) => println(v)
    Err(_) => println(-999)

fn main() : Unit ! {IO} =
  let e1 = Div(Mul(Add(Lit(10), Lit(5)), Lit(3)), Lit(5))
  let e2 = Div(Lit(1), Lit(0))
  let e3 = Neg(Sub(Lit(3), Lit(10)))
  let e4 = Add(Mul(Lit(2), Lit(3)), Neg(Lit(4)))
  show_result(eval(e1))
  show_result(eval(e2))
  show_result(eval(e3))
  show_result(eval(e4))
  println(depth(e1))
