-- Compiler fixture for a let-bound closure under `with_arena`: the arena scope
-- builds its list through a lambda held in a local binding rather than by
-- calling a named function directly. Allocation reaches the region the same way
-- either spelling, so the closure's own witness has to carry the operation: the
-- lambda gains the row, the thunk that suspends it gains it, the binding that
-- holds the thunk gains it, and every reference to that binding gains it with
-- the binder. A reference left witnessed by the pre-rewrite type would claim the
-- closure allocates nothing while its body allocates, which the typed verifier
-- refuses.
import Arena (..)

fn build(n : Int, acc : List(Int)) : List(Int) =
  if n == 0 then
    acc
  else
    build(n - 1, Cons(n, acc))

fn total(xs : List(Int)) : Int =
  match xs of
    Nil => 0
    Cons(h, t) => h + total(t)

fn scratch() : Int =
  let sum_to = \(k : Int) -> total(build(k, Nil))
  sum_to(10)

fn main() : Unit ! {IO} = println(with_arena(scratch))
