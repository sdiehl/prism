-- A compact System F typechecker in Prism. The surface AST is explicit System F
-- (`ETLam`/`ETApp` are type abstraction/application), while ordinary application
-- also performs predicative instantiation, as in a small bidirectional checker.
--
-- The pipeline is the front end's shape in miniature: a resolution pass walks
-- the string-spelled surface once, minting a deterministic branded identity for
-- every binder (`Data.Name` over `Control.Fresh`) and resolving every reference
-- through a lexical `Data.Scope`, so the checker's trees carry identities, not
-- spellings. Substitution is then a structural walk comparing identities; no
-- capture is possible and no runtime freshening exists. Metavariables are
-- classes in a payload-carrying union-find: each class root owns one `Meta`
-- descriptor (unsolved, or solved to a type), so there is no shadow solution
-- map to keep aligned; the occurs check prevents infinite types.
--
-- Expected output:
--   id                 : forall a. a -> a
--   id[Int] 42         : Int
--   implicit id true   : Bool
--   higher rank        : (forall a. a -> a) -> Bool
--   union-find         : (forall a. a) -> Int
--   bad application    : error: application expects a function, got Int
--   bad branches       : error: cannot unify Int with Bool

import Control.State (..)
import Control.Fresh (Fresh, run_fresh)
import Data.Optic (Lens, lens, gets_at, modify_at)
import Data.String (contains)
import Data.Result (result_or)
import Data.Name (Name, Binder, fresh_binder, bound_name, name_id)
import Data.Scope (Scope, scope_empty, scope_push, scope_lookup)
import Data.UnionFind.Payload (UnionFind, ufp_empty, ufp_find, ufp_insert, ufp_set, ufp_union_with)

-- The surface syntax: types and terms as the programmer spells them.

type Ty
  = TyInt
  | TyBool
  | TyVar(String)
  | TyMeta(Int)
  | TyArrow(Ty, Ty)
  | TyForall(String, Ty)

type Op
  = Add
  | Sub
  | Mul
  | Div
  | And
  | Or
  | Eq
  | Ne
  | Lt
  | Le
  | Gt
  | Ge

type Expr
  = EVar(String)
  | EInt(Int)
  | EBool(Bool)
  | ELam(String, Ty, Expr)
  | EApp(Expr, Expr)
  | ETLam(String, Expr)
  | ETApp(Expr, Ty)
  | EAnn(Expr, Ty)
  | ELet(String, Expr, Expr)
  | EIf(Expr, Expr, Expr)
  | EBin(Op, Expr, Expr)

-- The two namespaces, branded so a term identity can never stand where a type
-- identity belongs.

type TermSpace = TermTag

type TySpace = TyTag

-- The resolved syntax the checker walks: every binder is a `Binder`, every
-- reference a `Name`, and spellings survive only as presentation hints.

type RTy
  = RInt
  | RBool
  | RVar(Name(TySpace))
  | RMeta(Int)
  | RArrow(RTy, RTy)
  | RForall(Binder(TySpace), RTy)

type RExpr
  = RVarE(Name(TermSpace))
  | RIntE(Int)
  | RBoolE(Bool)
  | RLam(Binder(TermSpace), RTy, RExpr)
  | RApp(RExpr, RExpr)
  | RTLam(Binder(TySpace), RExpr)
  | RTApp(RExpr, RTy)
  | RAnn(RExpr, RTy)
  | RLet(Binder(TermSpace), RExpr, RExpr)
  | RIf(RExpr, RExpr, RExpr)
  | RBin(Op, RExpr, RExpr)

error TypeError(String)

fn type_error(msg : String) : a ! {TypeError} = throw TypeError(msg)

-- Resolution: one walk from spellings to identities. Scopes are persistent
-- values, so entering a binding is passing an extended scope down and leaving
-- it is returning; nothing is ever popped. Unbound spellings and stray
-- metavariables in annotations are refused here, which is what lets the
-- checker below assume every reference is bound.

type Scopes = Scopes { terms: Scope(TermSpace), tys: Scope(TySpace) }

fn empty_scopes() : Scopes = Scopes { terms = scope_empty, tys = scope_empty }

fn resolve_ty(sc : Scopes, ty : Ty) : RTy ! {Fresh, TypeError} =
  match ty of
    TyInt => RInt
    TyBool => RBool
    TyVar(a) =>
      match scope_lookup(sc.tys, a) of
        Ok(b) => RVar(bound_name(b))
        Err(_e) => type_error("unbound type variable {a}")
    TyMeta(_) => type_error("metavariable escaped into a source annotation")
    TyArrow(a, b) => RArrow(resolve_ty(sc, a), resolve_ty(sc, b))
    TyForall(a, body) =>
      let binder = fresh_binder(a)
      RForall(
          binder,
          resolve_ty({ sc | tys = scope_push(sc.tys, binder) }, body),
        )

fn resolve_expr(sc : Scopes, e : Expr) : RExpr ! {Fresh, TypeError} =
  match e of
    EVar(x) =>
      match scope_lookup(sc.terms, x) of
        Ok(b) => RVarE(bound_name(b))
        Err(_err) => type_error("unbound variable {x}")
    EInt(n) => RIntE(n)
    EBool(b) => RBoolE(b)
    ELam(x, param, body) =>
      let rp = resolve_ty(sc, param)
      let binder = fresh_binder(x)
      RLam(
          binder,
          rp,
          resolve_expr({ sc | terms = scope_push(sc.terms, binder) }, body),
        )
    EApp(f, x) => RApp(resolve_expr(sc, f), resolve_expr(sc, x))
    ETLam(a, body) =>
      let binder = fresh_binder(a)
      RTLam(
          binder,
          resolve_expr({ sc | tys = scope_push(sc.tys, binder) }, body),
        )
    ETApp(f, arg) => RTApp(resolve_expr(sc, f), resolve_ty(sc, arg))
    EAnn(inner, annotation) =>
      RAnn(resolve_expr(sc, inner), resolve_ty(sc, annotation))
    ELet(x, value, body) =>
      let rv = resolve_expr(sc, value)
      let binder = fresh_binder(x)
      RLet(
          binder,
          rv,
          resolve_expr({ sc | terms = scope_push(sc.terms, binder) }, body),
        )
    EIf(c, yes, no) =>
      RIf(resolve_expr(sc, c), resolve_expr(sc, yes), resolve_expr(sc, no))
    EBin(op, x, y) => RBin(op, resolve_expr(sc, x), resolve_expr(sc, y))

-- The checker environment: term identities to types. There is no type-variable
-- list; resolution already proved every `RVar` bound.

type Env = Env { terms: List((Name(TermSpace), RTy)) }

fn empty_env() : Env = Env { terms = [] }

fn lookup_term(
  name : Name(TermSpace),
  xs : List((Name(TermSpace), RTy))
) : RTy ! {TypeError} =
  match xs of
    Nil => type_error("unresolved reference %{name_id(name)}")
    Cons((x, ty), rest) =>
      if name == x then
        ty
      else
        lookup_term(name, rest)

fn with_term(env : Env, name : Name(TermSpace), ty : RTy) : Env =
  { env | terms ~ \(xs) -> Cons((name, ty), xs) }

-- Substitution is a structural walk comparing identities. Binders are globally
-- unique, so no walk can reach a binder equal to the name being substituted,
-- and capture is impossible by construction: the renaming machinery the
-- string-spelled checker needed does not exist here.
fn subst(name : Name(TySpace), replacement : RTy, ty : RTy) : RTy =
  match ty of
    RVar(a) =>
      if name == a then
        replacement
      else
        ty
    RArrow(a, b) =>
      RArrow(subst(name, replacement, a), subst(name, replacement, b))
    RForall(b, body) => RForall(b, subst(name, replacement, body))
    _ => ty

-- What a metavariable class knows about itself: nothing yet, or its type.
type Meta = Unsolved | Solved(RTy)

type Metas = Metas { forest: UnionFind(Int, Meta), next: Int }

type Solver = Solver { metas: Metas }

-- The one stored route every forest update takes. The literal is anchored at
-- its root type, so it composes both field steps in one spelling and the
-- binding needs no annotation; rules below never unpack either record.
let solver_forest = #path Solver.metas.forest

-- The checker stack has one name at every recursive boundary.
alias Tc = {State(Solver), TypeError}

fn empty_solver() : Solver =
  Solver {
    metas = Metas { forest = ufp_empty, next = 0 }
  }

-- Joining two classes keeps whichever knowledge exists; unify only ever links
-- two zonked (hence unsolved) metas, so in practice both sides are `Unsolved`.
fn merge_meta(kept : Meta, lost : Meta) : Meta =
  match (kept, lost) of
    (Solved(t), _u) => Solved(t)
    (Unsolved, other) => other

-- The three state changes below are the whole mutable-looking solver: every
-- one is an update of `metas.forest`, and allocation also ticks `metas.next`,
-- which the ambient-state statement bumps in place. The `result_or` fallbacks
-- are for keys the forest cannot actually lack: a meta is inserted the moment
-- it is allocated, and `next` never repeats.
fn fresh_meta() : RTy ! {State(Solver)} =
  let n = get().metas.next
  modify_at(solver_forest, \(f) -> result_or(f, ufp_insert(f, n, Unsolved)))
  get().metas.next += 1
  RMeta(n)

fn root(a : Int) : Int ! {State(Solver)} =
  match ufp_find(gets_at(solver_forest), a) of
    Some((r, _meta)) => r
    None => a

fn link(a : Int, b : Int) : Unit ! {State(Solver)} =
  modify_at(solver_forest) fn(f)
    result_or(f, ufp_union_with(merge_meta, f, a, b))

fn solution(a : Int) : Option(RTy) ! {State(Solver)} =
  match ufp_find(gets_at(solver_forest), a) of
    Some((_r, Solved(t))) => Some(t)
    _ => None

fn assign(a : Int, ty : RTy) : Unit ! {State(Solver)} =
  modify_at(solver_forest, \(f) -> result_or(f, ufp_set(f, a, Solved(ty))))

fn zonk(ty : RTy) : RTy ! {State(Solver)} =
  match ty of
    RMeta(a) =>
      let r = root(a)
      match solution(r) of
        None => RMeta(r)
        Some(t) => zonk(t)
    RArrow(a, b) => RArrow(zonk(a), zonk(b))
    RForall(a, body) => RForall(a, zonk(body))
    _ => ty

fn mono(ty : RTy) : Bool =
  match ty of
    RForall(_, _) => false
    RArrow(a, b) => mono(a) && mono(b)
    _ => true

fn occurs(a : Int, ty : RTy) : Bool ! {State(Solver)} =
  match zonk(ty) of
    RMeta(b) => root(a) == root(b)
    RArrow(x, y) => occurs(a, x) || occurs(a, y)
    RForall(_, body) => occurs(a, body)
    _ => false

-- Printing recovers spellings from binder hints; identities never print. A
-- binder whose hint is already in use picks up tick suffixes, so shadowed
-- spellings disambiguate at the printer and nowhere else.
fn show_ty(ty : RTy) : String = show_ty_at(0, [], ty)

fn hint_for(env : List((Name(TySpace), String)), n : Name(TySpace)) : String =
  match env of
    Nil => "%{name_id(n)}"
    Cons((m, hint), rest) =>
      if n == m then
        hint
      else
        hint_for(rest, n)

fn hint_taken(env : List((Name(TySpace), String)), hint : String) : Bool =
  match env of
    Nil => false
    Cons((_m, h), rest) => h == hint || hint_taken(rest, hint)

fn free_hint(env : List((Name(TySpace), String)), hint : String) : String =
  if hint_taken(env, hint) then
    free_hint(env, concat(hint, "'"))
  else
    hint

fn show_ty_at(
  precedence : Int,
  env : List((Name(TySpace), String)),
  ty : RTy
) : String =
  match ty of
    RInt => "Int"
    RBool => "Bool"
    RVar(a) => hint_for(env, a)
    RMeta(a) => "?{a}"
    RArrow(a, b) =>
      let text = "{show_ty_at(2, env, a)} -> {show_ty_at(1, env, b)}"
      if precedence > 1 then
        "({text})"
      else
        text
    RForall(b, body) =>
      let shown = free_hint(env, b.hint)
      let inner = Cons((bound_name(b), shown), env)
      let text = "forall {shown}. {show_ty_at(0, inner, body)}"
      if precedence > 0 then
        "({text})"
      else
        text

fn mismatch(a : RTy, b : RTy) : Unit ! {TypeError} =
  type_error("cannot unify {show_ty(a)} with {show_ty(b)}")

fn solve(a : Int, ty : RTy) : Unit ! {Tc} =
  let t = zonk(ty)
  if not(mono(t)) then
    type_error("implicit instantiation is predicative, got {show_ty(t)}")
  elif occurs(a, t) then
    type_error("occurs check: ?{a} occurs in {show_ty(t)}")
  else
    assign(a, t)

fn unify(left : RTy, right : RTy) : Unit ! {Tc} =
  let a = zonk(left)
  let b = zonk(right)
  match (a, b) of
    (RMeta(x), RMeta(y)) =>
      if root(x) == root(y) then
        ()
      else
        link(x, y)
    (RMeta(x), t) => solve(x, t)
    (t, RMeta(x)) => solve(x, t)
    (RInt, RInt) => ()
    (RBool, RBool) => ()
    (RVar(x), RVar(y)) =>
      if x == y then
        ()
      else
        mismatch(a, b)
    (RArrow(a1, a2), RArrow(b1, b2)) =>
      unify(a1, b1)
      unify(a2, b2)
    (RForall(x, body1), RForall(y, body2)) =>
      unify(body1, subst(bound_name(y), RVar(bound_name(x)), body2))
    _ => mismatch(a, b)

-- Subsumption differs from equality only at a polymorphic value: eliminate its
-- forall with a fresh existential, then continue. Explicit RTApp remains fully
-- impredicative; only this convenient implicit path is predicative.
fn subsume(got : RTy, wanted : RTy) : Unit ! {Tc} =
  match (zonk(got), zonk(wanted)) of
    (RForall(a, body), RForall(b, other)) =>
      unify(body, subst(bound_name(b), RVar(bound_name(a)), other))
    (RForall(a, body), want) =>
      let m = fresh_meta()
      subsume(subst(bound_name(a), m, body), want)
    (have, want) => unify(have, want)

fn apply_type(fn_ty : RTy, arg_ty : RTy) : RTy ! {Tc} =
  match zonk(fn_ty) of
    RForall(a, body) =>
      let m = fresh_meta()
      apply_type(subst(bound_name(a), m, body), arg_ty)
    RArrow(domain, codomain) =>
      subsume(arg_ty, domain)
      zonk(codomain)
    other => type_error("application expects a function, got {show_ty(other)}")

fn infer(env : Env, expr : RExpr) : RTy ! {Tc} =
  match expr of
    RVarE(x) => lookup_term(x, env.terms)
    RIntE(_) => RInt
    RBoolE(_) => RBool
    RLam(x, param, body) =>
      RArrow(param, infer(with_term(env, bound_name(x), param), body))
    RApp(f, x) => apply_type(infer(env, f), infer(env, x))
    RTLam(a, body) => RForall(a, infer(env, body))
    RTApp(f, arg) =>
      match zonk(infer(env, f)) of
        RForall(a, body) => subst(bound_name(a), arg, body)
        other =>
          type_error("type application expects forall, got {show_ty(other)}")
    RAnn(e, annotation) =>
      subsume(infer(env, e), annotation)
      annotation
    RLet(x, value, body) =>
      let ty = infer(env, value)
      infer(with_term(env, bound_name(x), ty), body)
    RIf(cond, yes, no) =>
      subsume(infer(env, cond), RBool)
      let a = infer(env, yes)
      let b = infer(env, no)
      unify(a, b)
      zonk(a)
    RBin(op, x, y) => infer_binop(env, op, x, y)

fn infer_binop(env : Env, op : Op, x : RExpr, y : RExpr) : RTy ! {Tc} =
  match op of
    Add | Sub | Mul | Div => infer_uniform_binop(env, x, y, RInt, RInt)
    Lt | Le | Gt | Ge => infer_uniform_binop(env, x, y, RInt, RBool)
    And | Or => infer_uniform_binop(env, x, y, RBool, RBool)
    Eq | Ne => infer_equality(env, x, y)

fn infer_uniform_binop(
  env : Env,
  x : RExpr,
  y : RExpr,
  operand : RTy,
  result : RTy
) : RTy ! {Tc} =
  subsume(infer(env, x), operand)
  subsume(infer(env, y), operand)
  result

fn infer_equality(env : Env, x : RExpr, y : RExpr) : RTy ! {Tc} =
  let operand = infer(env, x)
  subsume(infer(env, y), operand)
  RBool

fn check_resolved(r : RExpr) : RTy ! {Tc} = zonk(infer(empty_env(), r))

fn type_of(expr : Expr) : Result(RTy, String) =
  try
    let r = run_fresh(\() -> resolve_expr(empty_scopes(), expr))
    let (ty, _solver) = run_state(empty_solver(), \() -> check_resolved(r))
    Ok(ty)
  catch
    TypeError(msg) => Err(msg)

fn report(label : String, expr : Expr) : Unit ! {IO} =
  match type_of(expr) of
    Ok(ty) => println("{label} : {show_ty(ty)}")
    Err(msg) => println("{label} : error: {msg}")

fn identity() : Expr = ETLam("a", ELam("x", TyVar("a"), EVar("x")))

-- Whether the two source types unify under a fresh resolver and solver.
fn resolve_ty_pair(
  sc : Scopes,
  a : Ty,
  b : Ty
) : (RTy, RTy) ! {Fresh, TypeError} =
  (resolve_ty(sc, a), resolve_ty(sc, b))

fn unifies(a : Ty, b : Ty) : Bool =
  try
    let (ra, rb) = run_fresh(\() -> resolve_ty_pair(empty_scopes(), a, b))
    let (_u, _s) = run_state(empty_solver(), \() -> unify(ra, rb))
    true
  catch
    TypeError(_msg) => false

-- A meta must not unify with a type containing its own class.
fn occurs_body() : Unit ! {Tc} =
  let m = fresh_meta()
  unify(m, RArrow(m, RInt))

fn occurs_rejected() : Bool =
  try
    let (_u, _s) = run_state(empty_solver(), \() -> occurs_body())
    false
  catch
    TypeError(msg) => contains("occurs", msg)

-- Joining two metas and solving one solves the shared class.
fn shared_body() : RTy ! {Tc} =
  let m1 = fresh_meta()
  let m2 = fresh_meta()
  unify(m1, m2)
  unify(m2, RInt)
  zonk(m1)

fn shared_solved() : Bool =
  try
    let (ty, _s) = run_state(empty_solver(), \() -> shared_body())
    show_ty(ty) == "Int"
  catch
    TypeError(_msg) => false

-- The shown type of a source expression, or the error text.
fn shown_type(e : Expr) : String =
  match type_of(e) of
    Ok(ty) => show_ty(ty)
    Err(msg) => "error: {msg}"

-- The baseline witnesses below print nothing while they hold, so the seven
-- report lines stay the whole visible output; a violation names itself.
fn baseline(name : String, ok : Bool) : Unit ! {IO} =
  if ok then
    ()
  else
    println("baseline violated: {name}")

fn baseline_checks() : Unit ! {IO} =
  -- Instantiating under a shadowing binder must not capture: the inner
  -- `forall b` cannot swallow the outer `b` being substituted in, and the
  -- printer, not the substitution, chooses the disambiguating tick.
  baseline(
      "instantiation avoids capture",
      shown_type(
          ETLam(
              "b",
              ETApp(
                  ETLam("a", ETLam("b", ELam("x", TyVar("a"), EVar("x")))),
                  TyVar("b"),
                ),
            ),
        )
        == "forall b. forall b'. b -> b",
    )
  -- Alpha-renaming a source binder changes hints, never inferred structure.
  baseline(
      "alpha-renaming preserves inference",
      shown_type(identity()) == "forall a. a -> a"
        && shown_type(ETLam("z", ELam("x", TyVar("z"), EVar("x"))))
          == "forall z. z -> z",
    )
  -- Alpha-equivalent quantified types unify; a genuinely different body does
  -- not.
  let poly_x = TyForall("x", TyArrow(TyVar("x"), TyVar("x")))
  let poly_y = TyForall("y", TyArrow(TyVar("y"), TyVar("y")))
  baseline("alpha-equivalent foralls unify", unifies(poly_x, poly_y))
  baseline(
      "distinct foralls are rejected",
      not(unifies(poly_x, TyForall("y", TyArrow(TyVar("y"), TyInt)))),
    )
  -- Nested same-spelled binders resolve to distinct identities; the innermost
  -- wins.
  baseline(
      "shadowing resolves innermost",
      shown_type(ELet("x", EInt(1), ELet("x", EBool(true), EVar("x"))))
        == "Bool",
    )
  baseline("occurs check rejects", occurs_rejected())
  baseline("meta union then solve", shared_solved())

fn main() : Unit ! {IO} =
  baseline_checks()
  report("id                ", identity())
  report("id[Int] 42        ", EApp(ETApp(identity(), TyInt), EInt(42)))
  report("implicit id true  ", EApp(identity(), EBool(true)))
  let poly_id = TyForall("a", TyArrow(TyVar("a"), TyVar("a")))
  report(
      "higher rank       ",
      ELam("f", poly_id, EApp(ETApp(EVar("f"), TyBool), EBool(true))),
    )
  -- Instantiating both `identity` and `x : forall a. a` creates two metas.
  -- Their equality goes through the forest; arithmetic subsequently solves the
  -- shared root to Int. This is a small executable union-find witness.
  report(
      "union-find        ",
      ELam(
          "x",
          TyForall("a", TyVar("a")),
          EBin(Add, EApp(identity(), EVar("x")), EInt(1)),
        ),
    )
  report("bad application   ", EApp(EInt(1), EBool(true)))
  report("bad branches      ", EIf(EBool(true), EInt(1), EBool(false)))
