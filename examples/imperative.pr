-- Imperative control flow recovered from effects and tail recursion: `while`,
-- `loop`, `break`, `continue`, early `return`, and compound assignment, all
-- desugaring to the existing core. `var` is a State effect, so loop bodies mutate
-- freely yet each function below stays observably pure. An assignment's left
-- side may be a field or index path rooted at a `var`; the statement is the
-- brace update it abbreviates, rebuilding in place when uniquely owned.
fn sum_evens(limit : Int) : Int =
  var total := 0
  var i := 0
  while i < limit do
    i += 1
    if i % 2 == 1 then
      continue
    total += i
  total

fn first_factor(n : Int) : Int =
  var d := 2
  loop
    if d * d > n then
      return n
    if n % d == 0 then
      return d
    d += 1

fn countdown(start : Int) : Int =
  var n := start
  var ticks := 0
  loop
    if n <= 0 then
      break
    n -= 1
    ticks += 1
  ticks

type Tally = Tally { evens: Int, odds: Int }

fn tally(limit : Int) : Tally =
  var t : Tally := Tally { evens = 0, odds = 0 }
  var i := 0
  while i < limit do
    i += 1
    if i % 2 == 0 then
      t.evens += i
    else
      t.odds += i
  t

fn main() : Unit ! {IO} =
  println(show_int(sum_evens(10)))
  println(show_int(first_factor(91)))
  println(show_int(first_factor(97)))
  println(show_int(countdown(5)))
  let t = tally(10)
  println(show_int(t.evens))
  println(show_int(t.odds))
