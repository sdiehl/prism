effect Tick
  tick() : Int

effect Say
  say(Int) : Unit

-- Effect polymorphism: one higher-order function, any effect row.
fn twice(f : (Int) -> Int ! {| e}, x : Int) = f(x) + f(x)

fn plus_one(n : Int) = n + 1

fn plus_tick(n : Int) = n + tick()

fn announce(n : Int) =
  say(n)
  n

-- The same definition is instantiated at three different rows.
-- e = {}
fn pure_use() = twice(plus_one, 20)

-- e = {Tick}; the handler supplies 1 for each tick.
fn tick_use() =
  handle twice(plus_tick, 20) with
    tick() resume k => k(1)
    return result => result

-- e = {Say}; the handler prints each announcement.
fn say_use() =
  handle twice(announce, 9) with
    say(n) resume k =>
      println(n)
      k(())
    return result => result

fn main() =
  println(pure_use())
  println(tick_use())
  println(say_use())
