import Spectra (..)

import Data.String (str_join)

-- | The artifact chain the opening slide shows, arrowed together.
--
-- A prompt line, evaluated and shown with its value:
--
-- ```prism
-- pipeline(["Deck", "Typst"])
-- ```
-- ```output
-- Deck → Typst
-- ```
--
-- A whole program, compiled and run:
--
-- ```prism
-- fn main() = print(pipeline(["one", "spectrum"]))
-- ```
-- ```output
-- one → spectrum
-- ```
pub fn pipeline(stages : List(String)) : String = str_join(" → ", stages)

-- This deck is an introduction to Prism in six slides, and every slide is its
-- own witness: the mechanism each one explains is the mechanism that put it on
-- the screen.

-- The PDF you are reading is the value this function returns, lowered through
-- the chain below. Reflection lifts the declaration out of this file, so the
-- definition on the slide is the definition that produced the slide.
fn value_slide() : Unit ! {SlideBuilder} =
  pict(prism_code(reflect fn talk))
  pict(centered(12, [
      text(pipeline(["Prism source", "Deck value", "Typst", "PDF"])),
    ]))
  reveal_next()
  pict(item("A deck is a pure value; rendering is a pure function of it."))
  pict(item("Every boundary in the chain is deterministic and inspectable."))

-- The code on this slide is this slide, title and all: a declaration that
-- performs `SlideBuilder` effects, is elaborated by Spectra's handler into
-- the pure deck value, and quotes itself onto the very slide those effects
-- build. Effects are how Prism programs talk to the world; handlers decide
-- what the talk means.
fn effects_slide() : Slide =
  titled_slide("Effects build this slide", column(14, [
      prism_code(reflect fn effects_slide),
      item(
          "Each pict(...) call is an effect; a handler folds them into a value.",
        ),
      item("The row type names what a function may do, and nothing else."),
    ]))

-- A small language of judgements: an algebraic type, and one match that
-- renders it totally. The compiler checks the match covers every shape.
type Judgement = Holds | Fails(String)

fn verdict(j : Judgement) : String =
  match j of
    Holds => "holds"
    Fails(why) => "fails: {why}"

fn types_slide() : Unit ! {SlideBuilder} =
  pict(prism_code(reflect type Judgement))
  pict(prism_code(reflect fn verdict))
  reveal_next()
  pict(item_text([
      plain("Data declares its shapes; "),
      inline_code("match"),
      plain(" must answer all of them, checked at compile time."),
    ]))

-- Neither output block on this slide is written by hand. `spectra build` hands
-- every example to the compiler's doctest runner, so a slide claiming an output
-- its code no longer produces fails the build instead of reaching a screen.
fn doctest_slide() : Unit ! {SlideBuilder} =
  pict(doctest(reflect fn pipeline))
  reveal_next()
  pict(item_text([
      plain("An example with no "),
      inline_code("main"),
      plain(" runs as a prompt line and shows its value."),
    ]))
  pict(item_text([
      plain("One that defines "),
      inline_code("main"),
      plain(" runs as a program and shows what it prints."),
    ]))

-- Every definition in this file has a content hash, and this PDF is a
-- function of those hashes. Editing this comment moves this slide's identity
-- and rebuilds exactly this deck; the definitions it quotes hold still.
fn identity_slide() : Unit ! {SlideBuilder} =
  pict(prism_code(reflect fn identity_slide))
  reveal_next()
  pict(item("A definition's identity is the hash of what it means."))
  pict(item("A comment-only edit here moves the reflector, not its targets."))

fn closing_slide() : Unit ! {SlideBuilder} =
  pict(prism_code(reflect fn slides))
  reveal_next()
  pict(
      item(
          "The running order of the talk you just watched, quoted from the file that ran it.",
        ),
    )

fn slides() : Unit ! {DeckBuilder} =
  cover("Prism", "A deterministic language, introducing itself")
  slide("This PDF is a Prism value", value_slide)
  add_slide(effects_slide())
  slide("Types and patterns", types_slide)
  slide("The examples are run, not claimed", doctest_slide)
  slide("Identity is content", identity_slide)
  slide("The deck reads its own source", closing_slide)

fn talk() : Deck =
  deck(metadata("Prism, introducing itself", "Prism"), prism_theme, slides)

fn main() = emit_deck(talk())
