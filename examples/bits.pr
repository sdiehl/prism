-- Fixed-width bitwise and shift builtins on the I64/U64 lanes. Values use
-- boxed machine words. i64_shr is arithmetic (sign-filling), u64_shr logical
-- (zero-filling). Shift counts are taken modulo 64.
--
-- Prints:
--   8
--   14
--   -16
--   240
--   1
--   1285471668107568959

-- A xorshift64 step. Each machine-word result may allocate a box.
fn xorshift(h : U64) : U64 =
  let a = u64_xor(h, u64_shl(h, to_u64(13)))
  let b = u64_xor(a, u64_shr(a, to_u64(7)))
  u64_xor(b, u64_shl(b, to_u64(17)))

-- Fold a list of byte values into a 64-bit hash, mixing after each.
fn hash_ints(xs : List(Int)) : U64 =
  match xs of
    Nil => to_u64(1469598103934665603)
    Cons(b, rest) => xorshift(u64_xor(hash_ints(rest), to_u64(b)))

fn main() : Unit ! {IO} =
  let a = to_i64(12)
  let b = to_i64(10)
  println(int_of_i64(i64_and(a, b)))
  -- 1100 & 1010 = 1000
  println(int_of_i64(i64_or(a, b)))
  -- 1100 | 1010 = 1110
  println(int_of_i64(i64_shr(to_i64(-256), to_i64(4))))
  -- arithmetic: -16
  println(int_of_u64(u64_shl(to_u64(15), to_u64(4))))
  -- 240
  println(int_of_u64(u64_shr(to_u64(256), to_u64(8))))
  -- 1
  println(int_of_u64(hash_ints([104, 101, 108, 108, 111])))
