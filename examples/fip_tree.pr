-- Tree relabeling reuses each matched Node when it is uniquely owned.
-- Doubling an arbitrary-precision Int can allocate a bignum, so the whole
-- function cannot claim to be allocation-free even when its tree spine is reused.
--
-- Run with PRISM_REUSE_STATS=1 to see one reuse per node, PRISM_CHECK_LEAKS=1
-- for zero live cells at exit.
--
-- Prints:
--   45
--   90

type Tree = Leaf | Node(Tree, Int, Tree)

-- Double every label in place: each `Node` matched is rebuilt over its own cell.
fn relabel(t) =
  match t of
    Leaf => Leaf
    Node(l, x, r) => Node(relabel(l), x + x, relabel(r))

fn sum_tree(t) =
  match t of
    Leaf => 0
    Node(l, x, r) => sum_tree(l) + x + sum_tree(r)

fn build(lo, hi) =
  if lo >= hi then
    Leaf
  else
    let mid = (lo + hi) / 2
    Node(build(lo, mid), mid, build(mid + 1, hi))

fn main() =
  let t = build(0, 10)
  println(sum_tree(t))
  println(sum_tree(relabel(t)))
