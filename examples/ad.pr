-- Forward-mode automatic differentiation falls out of dual numbers: pair every
-- value with its derivative and let the algebra carry the chain rule for you.
-- A polynomial written once against the standard `Num` class evaluates twice.
-- This is the same numerical tower used by Int, I64, U64, and Float. Feed it a
-- plain Float and you get the value; feed it D(5.0, 1.0), where 1.0 seeds
-- dx/dx, and the same code threads the slope alongside, no symbolic step.

type Dual = D(Float, Float)

-- Projections out of a dual: re is the value, im the derivative.
fn re(d) =
  match d of
    D(x, _) => x

fn im(d) =
  match d of
    D(_, x) => x

-- Product rule lives in `times`: the derivative of a*b is a*b' + a'*b.
-- Constants enter through `from_int`, and unary minus is componentwise.
instance numDual : Num(Dual)
  fn plus(p, q) = D(re(p) + re(q), im(p) + im(q))
  fn minus(p, q) = D(re(p) - re(q), im(p) - im(q))
  fn times(p, q) = D(re(p) * re(q), re(p) * im(q) + im(p) * re(q))
  fn negated(p) = D(-re(p), -im(p))
  fn from_int(x) = D(to_float(x), 0.0)

-- p(x) = x^3 + 2x. The generic body names Num's methods; monomorphic code uses
-- the corresponding operators, all backed by the same numerical tower.
fn poly(x : a) : a given Num(a) =
  plus(times(times(x, x), x), times(from_int(2), x))

fn main() =
  let value = poly(5.0)
  let slope = poly(D(5.0, 1.0))
  println("poly(5)         = {value}")
  println("poly(5)  [dual] = {re(slope)}")
  println("poly'(5)        = {im(slope)}")
