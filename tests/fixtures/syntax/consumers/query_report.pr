-- A source-query harness over the public source representation. arg(0) is a
-- `prism-syntax-tokens-v1` artifact. This decodes it and prints
-- `Syntax.Query`'s inventory of the source, one stable line per fact (digest,
-- imports, comments, declaration heads, token-kind histogram).
--
-- The report is a pure function of the artifact bytes: it reads only arg(0) and
-- never consults ambient workspace state, so the same artifact always prints the
-- same lines. It is a *source-identity* view, deliberately distinct from Core
-- identity: two programs that differ only in comments or formatting print
-- different reports here yet elaborate to the identical Core.
import Syntax.Codec (..)
import Syntax.Query (..)

fn main() =
  let text = read_file(arg(0))
  match decode_tokens(text) of
    Err(e) => println("decode error: {codec_error_message(e)}")
    Ok(d) => println(query_text(query(d)))
