-- Focused differential cases that are easy to lose in handwritten grammar
-- maintenance but are accepted by the Rust surface grammar.

alias MaxVec = Vec(Int, 18446744073709551615)

fn numeric_edges(x : Float) =
  let n = 1i64
  match x of
    100000000000000000000.0 => n
    _ => 0

fn trailing_commas(f, inst, tensor, point) =
  let called = f(using inst)
  let indexed = tensor[1, 2]
  let ranged = [1, 3..9]
  let updated = { point | x = called }
  (indexed, ranged, updated)

fn open_chain(x : Int) =
  if x > 0 then
    println("positive")
  elif x < 0 then
    println("negative")
  println("done")

fn try_let(r) =
  let x = r?
  x

fn try_bare(r) =
  r?
  ()

fn try_tuple(r) =
  let (name, c1) = r?
  (name, c1)

fn try_ctor_record(r) =
  let Some(User { name = name, .. }) = r?
  name
