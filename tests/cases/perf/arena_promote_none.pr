-- The zero case for the promotion oracle: a region whose result is a scalar.
-- Everything the scope builds dies with the region, so the promotion walk has
-- nothing to enter and nothing to copy, whatever N is.
import Arena (..)

fn build(n : Int, acc : List(Int)) : List(Int) =
  if n == 0 then
    acc
  else
    build(n - 1, Cons(n, acc))

fn total(xs : List(Int)) : Int =
  match xs of
    Nil => 0
    Cons(h, t) => h + total(t)

fn scratch() : Int = total(build(__N__, Nil))

fn main() = println(with_arena(scratch))
