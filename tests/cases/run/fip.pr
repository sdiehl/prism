-- Reversal reuses uniquely owned cells. The spine map also reuses its list cells, but
-- its Int arithmetic can allocate bignums, as can the scalar combine function.

fn rev_onto(xs, acc) =
  match xs of
    Nil => acc
    Cons(h, t) => rev_onto(t, Cons(h, acc))

fn bump(xs) =
  match xs of
    Nil => Nil
    Cons(h, t) => Cons(h + 1, bump(t))

fn combine(x, y, z) = x + y * z

fn main() =
  println(sum(rev_onto([1, 2, 3, 4], Nil)))
  println(sum(bump([1, 2, 3, 4])))
  println(combine(10, 3, 4))
