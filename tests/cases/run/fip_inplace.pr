-- Drop-guided list and tree reuse. Unique inputs permit in-place updates;
-- shared inputs can allocate. Arithmetic may also allocate bignums, so these
-- functions do not carry unconditional allocation certificates.

fn rev_onto(xs, acc) =
  match xs of
    [] => acc
    h :: t => rev_onto(t, Cons(h, acc))

fn bump(xs) =
  match xs of
    [] => Nil
    h :: t => Cons(h + 1, bump(t))

type Tree = Leaf | Node(Tree, Int, Tree)

fn relabel(t) =
  match t of
    Leaf => Leaf
    Node(l, x, r) => Node(relabel(l), x + x, relabel(r))

fn sum_tree(t) =
  match t of
    Leaf => 0
    Node(l, x, r) => sum_tree(l) + x + sum_tree(r)

fn main() =
  println(sum(rev_onto([1, 2, 3, 4], Nil)))
  println(sum(bump([10, 20, 30])))
  println(sum_tree(relabel(Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf)))))
