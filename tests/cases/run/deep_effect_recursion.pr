-- Deep recursion through a state handler. Every lowering route must run this
-- program in constant stack and agree on its result. The allocation gate also
-- compares short and long runs to detect a temporary state/result cell per step.
effect State
  get() : Int
  put(Int) : Unit

fn descend(n : Int) : Int ! {State} =
  if n == 0 then
    get()
  else
    put(get() + 1)
    descend(n - 1)

fn run(init, n) =
  let f =
    handle descend(n) with
      get() resume k => \(s) -> k(s)(s)
      put(s2) resume k => \(_s) -> k(())(s2)
      return r => \(_s) -> r
  f(init)

fn main() = println(run(0, 100000))
