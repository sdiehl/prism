fn merge(xs, ys) =
  match xs of
    [] => ys
    x :: xr =>
      match ys of
        [] => xs
        y :: yr =>
          if x <= y then
            Cons(x, merge(xr, ys))
          else
            Cons(y, merge(xs, yr))

fn msort(xs) =
  let n = length(xs)
  if n <= 1 then
    xs
  else
    let halves = split_at(n / 2, xs)
    merge(msort(fst(halves)), msort(snd(halves)))

fn print_list(xs : List(Int)) =
  match xs of
    [] => ()
    x :: rest =>
      println(x)
      print_list(rest)

fn main() = print_list(msort([5, 3, 8, 1, 9, 2, 7, 4, 6]))
