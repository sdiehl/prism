== core (cbpv) ==
fn tick_region(base) =
  return base
fn tick(n) =
  return n to t@0
  return 1 to t@1
  t@0 + t@1 to base
  return base to t@2
  tick_region(t@2)
fn main() =
  return 20 to t@3
  tick(t@3)

== fbip (rc) ==
fn tick_region(base) =
  return base
fn tick(n) =
  return n to t@0
  return 1 to t@1
  dup t@0
  t@0 + t@1 to base
  return base to t@2
  tick_region(t@2)
fn main() =
  return 20 to t@3
  tick(t@3) to %rc0
  drop t@3
  return %rc0

