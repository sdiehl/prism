== types ==
box : (Int) -> Box
pair : (Int, Int) -> Pair

== core (cbpv) ==
fn box(x) =
  return x to t@0
  return Box(t@0)
fn pair(x, y) =
  return x to t@1
  box(t@1) to t@2
  return y to t@3
  box(t@3) to t@4
  return Pair(t@2, t@4)

== fbip (rc) ==
fn box(x) =
  return x to t@0
  return Box(t@0)
fn pair(x, y) =
  return x to t@1
  box(t@1) to t@2
  return y to t@3
  box(t@3) to t@4
  return Pair(t@2, t@4)

