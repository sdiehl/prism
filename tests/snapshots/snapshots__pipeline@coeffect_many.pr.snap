== core (cbpv) ==
fn use2(g, x) =
  return x to t@0
  return g to t@1
  (force t@1)(t@0) to t@6
  return x to t@2
  return 1 to t@3
  t@2 + t@3 to t@4
  return g to t@5
  (force t@5)(t@4) to t@7
  t@6 + t@7
fn main() =
  thunk { \n.
    return n to t@8
    return 2 to t@9
    t@8 * t@9
  } to t@10
  return 3 to t@11
  use2(t@10, t@11)

== fbip (rc) ==
fn use2(g, x) =
  dup x
  dup g
  return x to t@0
  return g to t@1
  (force t@1)(t@0) to t@6
  return x to t@2
  return 1 to t@3
  t@2 + t@3 to t@4
  return g to t@5
  (force t@5)(t@4) to t@7
  t@6 + t@7
fn main() =
  thunk { \n.
    return n to t@8
    return 2 to t@9
    t@8 * t@9
  } to t@10
  return 3 to t@11
  use2(t@10, t@11)

