== types ==
lens : forall a b. ((b) -> a, (b, a) -> b) -> Lens(b, a)
hp_lens : () -> Lens(Player, Int)
depth_lens : () -> Lens(Player, Int)
read : (Lens(Player, Int), Player) -> Int
main : () -> Unit ! {IO}

== core (cbpv) ==
fn lens(get, set) =
  return get to t@0
  return set to t@1
  return MkLens(t@0, t@1)
fn hp_lens() =
  thunk { \whole@.
    return whole@ to t@2
    case t@2 of
      Player(_, t@3) =>
        return t@3
  } to t@4
  thunk { \whole@ part@.
    return whole@ to t@5
    return part@ to t@6
    case t@5 of
      Player(t@7, t@8) =>
        return Player(t@7, t@6)
  } to t@9
  lens(t@4, t@9)
fn depth_lens() =
  thunk { \whole@.
    return whole@ to t@10
    case t@10 of
      Player(t@11, _) =>
        return t@11
    to t@12
    case t@12 of
      Pos(t@13, _) =>
        return t@13
  } to t@14
  thunk { \whole@ part@.
    return whole@ to t@15
    return part@ to t@16
    case t@15 of
      Player(t@17, t@18) =>
        case t@17 of
          Pos(t@19, t@20) =>
            return Pos(t@16, t@20)
        to t@21
        return Player(t@21, t@18)
  } to t@22
  lens(t@14, t@22)
fn read(l, p) =
  return l to t@23
  case t@23 of
    MkLens(get, _set) =>
      return p to t@24
      return get to t@25
      (force t@25)(t@24)
fn main() =
  return 3 to t@26
  return 4 to t@27
  return Pos(t@26, t@27) to here
  return here to t@28
  return 7 to t@29
  return Player(t@28, t@29) to p
  hp_lens() to t@30
  return p to t@31
  read(t@30, t@31) to t@32
  print t@32 to t@33
  print_nl
  depth_lens() to t@34
  return p to t@35
  read(t@34, t@35) to t@36
  print t@36 to t@37
  print_nl

== fbip (rc) ==
fn lens(get, set) =
  return get to t@0
  return set to t@1
  return MkLens(t@0, t@1)
fn hp_lens() =
  thunk { \whole@.
    return whole@ to t@2
    case t@2 of
      Player(_, t@3) =>
        dup t@3
        drop t@2
        return t@3
  } to t@4
  thunk { \whole@ part@.
    return whole@ to t@5
    return part@ to t@6
    case t@5 of
      Player(t@7, t@8) =>
        dup t@7
        drop t@5
        return Player(t@7, t@6)
  } to t@9
  lens(t@4, t@9)
fn depth_lens() =
  thunk { \whole@.
    return whole@ to t@10
    case t@10 of
      Player(t@11, _) =>
        dup t@11
        drop t@10
        return t@11
    to t@12
    case t@12 of
      Pos(t@13, _) =>
        dup t@13
        drop t@12
        return t@13
  } to t@14
  thunk { \whole@ part@.
    return whole@ to t@15
    return part@ to t@16
    case t@15 of
      Player(t@17, t@18) =>
        dup t@17
        dup t@18
        drop t@15
        case t@17 of
          Pos(t@19, t@20) =>
            dup t@20
            drop t@17
            return Pos(t@16, t@20)
        to t@21
        return Player(t@21, t@18)
  } to t@22
  lens(t@14, t@22)
fn read(l, p) =
  return l to t@23
  case t@23 of
    MkLens(get, _set) =>
      return p to t@24
      return get to t@25
      dup t@25
      (force t@25)(t@24)
fn main() =
  return 3 to t@26
  return 4 to t@27
  return Pos(t@26, t@27) to here
  return here to t@28
  return 7 to t@29
  return Player(t@28, t@29) to p
  dup p
  hp_lens() to t@30
  return p to t@31
  read(t@30, t@31) to %rc0
  drop t@30
  return %rc0 to t@32
  print t@32 to t@33
  drop t@33
  print_nl
  drop _
  depth_lens() to t@34
  return p to t@35
  read(t@34, t@35) to %rc1
  drop t@34
  return %rc1 to t@36
  print t@36 to t@37
  drop t@37
  print_nl

