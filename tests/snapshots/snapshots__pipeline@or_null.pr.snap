== core (cbpv) ==
fn find(hit) =
  return hit to t@0
  if t@0 then
    return 7 to t@1
    return This(t@1)
  else
    return Null
fn unwrap_or(o, d) =
  return o to t@2
  case t@2 of
    Null =>
      return d
    This(n) =>
      return n
fn main() =
  return true to t@3
  find(t@3) to t@4
  return 0 to t@5
  unwrap_or(t@4, t@5) to t@9
  return false to t@6
  find(t@6) to t@7
  return 100 to t@8
  unwrap_or(t@7, t@8) to t@10
  t@9 + t@10

== fbip (rc) ==
fn find(hit) =
  return hit to t@0
  if t@0 then
    return 7 to t@1
    return This(t@1)
  else
    return Null
fn unwrap_or(o, d) =
  return o to t@2
  case t@2 of
    Null =>
      return d
    This(n) =>
      drop d
      dup n
      return n
fn main() =
  return true to t@3
  find(t@3) to %rc0
  drop t@3
  return %rc0 to t@4
  return 0 to t@5
  unwrap_or(t@4, t@5) to %rc1
  drop t@4
  return %rc1 to t@9
  return false to t@6
  find(t@6) to %rc2
  drop t@6
  return %rc2 to t@7
  return 100 to t@8
  unwrap_or(t@7, t@8) to %rc3
  drop t@7
  return %rc3 to t@10
  t@9 + t@10

