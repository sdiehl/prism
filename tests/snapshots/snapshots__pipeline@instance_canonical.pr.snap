== types ==
main : () -> Int

== core (cbpv) ==
fn main() =
  return 1 to t@0
  return 2 to t@1
  i@ordInt@cmp(t@0, t@1)
fn i@ordInt@cmp(x, y) =
  return x to t@2
  return y to t@3
  t@2 < t@3 to t@4
  if t@4 then
    return -1
  else
    return 1
fn ordInt() =
  return _DOrd(thunk { \_p0 _p1. i@ordInt@cmp(_p0, _p1) })
fn i@ordRev@cmp(x, y) =
  return x to t@5
  return y to t@6
  t@5 < t@6 to t@7
  if t@7 then
    return 1
  else
    return -1
fn ordRev() =
  return _DOrd(thunk { \_p0 _p1. i@ordRev@cmp(_p0, _p1) })

== fbip (rc) ==
fn main() =
  return 1 to t@0
  return 2 to t@1
  i@ordInt@cmp(t@0, t@1)
fn i@ordInt@cmp(x, y) =
  return x to t@2
  return y to t@3
  t@2 < t@3 to t@4
  if t@4 then
    drop t@4
    return -1
  else
    drop t@4
    return 1
fn ordInt() =
  return _DOrd(thunk { \_p0 _p1. i@ordInt@cmp(_p0, _p1) })
fn i@ordRev@cmp(x, y) =
  return x to t@5
  return y to t@6
  t@5 < t@6 to t@7
  if t@7 then
    drop t@7
    return 1
  else
    drop t@7
    return -1
fn ordRev() =
  return _DOrd(thunk { \_p0 _p1. i@ordRev@cmp(_p0, _p1) })

