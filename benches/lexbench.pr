-- Single-shot lexer driver: read the file named by arg(0), run the layer named
-- by arg(1) over it, print the token count.
--
-- Its twin is `benches/lexbench.rs`, which does the same work in the same shape
-- with the compiler's own lexer. `scripts/lexperf.py` runs the pair over one
-- corpus and reports the Prism-to-Rust throughput and peak-memory ratio per
-- layer.
--
-- A lexing failure prints a negative count rather than a message, so a corpus
-- file the two sides disagree about shows up as a count mismatch instead of a
-- timing artifact.
import Data.Foldable (length)

import Syntax.Source (..)

import Syntax.Token (..)

import Syntax.Lex (..)

import Syntax.Layout (..)

fn raw_count(text : String) : Int =
  match lex_raw(text) of
    Ok(r) => length(r.tokens)
    Err(e) => 0 - lex_offset(e) - 1

fn layout_count(text : String) : Int =
  match layout(text) of
    Ok(ts) => length(ts)
    Err(e) => 0 - lex_offset(e) - 1

fn main() =
  let text = read_file(arg(0))
  let n =
    if arg(1) == "layout" then
      layout_count(text)
    else
      raw_count(text)
  println(show_int(n))
