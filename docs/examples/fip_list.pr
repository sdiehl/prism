-- List operations with drop-guided cell reuse. Uniquely owned input cells can
-- be rebuilt in place; shared inputs require fresh cells. The functions make
-- no unconditional allocation claim. Run with PRISM_REUSE_STATS=1 to observe
-- reuse or PRISM_CHECK_LEAKS=1 to check live cells at exit.
--
-- Prints:
--   10
--   6
--   22

-- Reverse onto an accumulator, reusing uniquely owned input cells.
fn rev_onto(xs, acc) =
  match xs of
    Nil => acc
    Cons(h, t) => rev_onto(t, Cons(h, acc))

-- Seed the accumulator with an empty list.
fn reverse_ip(xs) = rev_onto(xs, Nil)

-- Spine-rebuilding map: drop each `Cons`, rebuild it around the bumped head.
fn bump(xs) =
  match xs of
    Nil => Nil
    Cons(h, t) => Cons(h + 1, bump(t))

-- Cap each head while rebuilding the spine through the same reuse path.
fn cap_at(xs) =
  match xs of
    Nil => Nil
    Cons(h, t) =>
      if h > 9 then
        Cons(9, cap_at(t))
      else
        Cons(h, cap_at(t))

fn main() =
  println(sum(reverse_ip([1, 2, 3, 4])))
  println(sum(bump([1, 1, 1])))
  println(sum(cap_at([1, 20, 3, 40])))
