-- A comparison selects an existing value without allocating. Arithmetic in
-- the caller may allocate a bignum; the certified region only chooses a value.
fn larger(a : Int, b : Int) : Int @ noalloc =
  if a > b then
    a
  else
    b

fn choose_scaled(a : Int, b : Int) : Int =
  let scaled = a * 2
  larger(scaled, b)

fn main() =
  println(larger(48, 18))
  println(choose_scaled(5, 3))
