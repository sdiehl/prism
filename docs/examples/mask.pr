-- Effect masking, minimally. Two handlers of one effect are in scope: the
-- nearest answers 1, the outer answers 10. A bare ask() is served by the
-- nearest handler; mask<Ask>(ask()) skips it and is served by the outer.
--
-- Expected output:
--   11

effect Ask
  ask() : Int

fn nested_ask() =
  handle (handle ask() + mask<Ask>(ask()) with {
      ask() resume k => k(1),
      return r => r
    }) with
    ask() resume k => k(10)
    return r => r

fn main() = println(nested_ask())
